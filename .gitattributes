# 统一换行符：仓库内用 LF，检出到 Windows 时转 CRLF
* text=auto eol=lf

*.md text eol=lf
*.astro text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.jpg binary
*.jpeg binary
*.JPG binary
*.png binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
