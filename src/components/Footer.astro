---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-x inner">
    <div class="brand-col">
      <div class="sig">
        <span class="sig-mark">森</span>
        <span class="sig-text">
          <strong>SEN</strong>
          <small>记录光影，也记录生活</small>
        </span>
      </div>
      <p class="desc">
        一个用 Astro 7 重建的个人空间。零 JS 起步，视图过渡串联每一页。
      </p>
    </div>

    <div class="link-col">
      <h4>导航</h4>
      <ul>
        <li><a href="/">首页</a></li>
        <li><a href="/blog">文章</a></li>
        <li><a href="/gallery">相册</a></li>
        <li><a href="/archives">归档</a></li>
      </ul>
    </div>

    <div class="link-col">
      <h4>关于</h4>
      <ul>
        <li><a href="/tags">标签</a></li>
        <li><a href="/friends">友链</a></li>
        <li><a href="/about">关于我</a></li>
      </ul>
    </div>

    <div class="link-col">
      <h4>技术栈</h4>
      <ul class="stack">
        <li><span class="pill">Astro 7</span></li>
        <li><span class="pill">Tailwind 4</span></li>
        <li><span class="pill">MDX</span></li>
        <li><span class="pill">GitHub Pages</span></li>
      </ul>
    </div>
  </div>

  <div class="container-x bottom">
    <p>© {year} 森 · Built with Astro & Tailwind CSS</p>
    <p class="made">Designed &amp; coded with <span class="heart">♥</span></p>
    <!-- 有些页面不放进导航：在键盘上敲 fang 试试 -->
    <a class="door" href="/secret" aria-label="档案室"><span class="sr-only">档案室</span></a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 6rem;
    border-top: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
    background: color-mix(in oklab, var(--color-ink) 55%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding: 3.2rem 0 2.4rem;
  }

  .sig {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .sig-mark {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: #05060c;
    background: linear-gradient(135deg, var(--color-cyan), var(--color-violet) 60%, var(--color-rose));
    box-shadow: 0 10px 30px -12px color-mix(in oklab, var(--color-violet) 90%, transparent);
  }

  .sig-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .sig-text strong {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.22em;
    color: #fff;
  }

  .sig-text small {
    font-size: 0.72rem;
    color: var(--color-fog);
  }

  .desc {
    margin: 1.1rem 0 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--color-fog);
    max-width: 34ch;
  }

  h4 {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: #fff;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  ul a {
    font-size: 0.86rem;
    color: var(--color-fog);
    transition: all 0.25s ease;
  }

  ul a:hover {
    color: var(--color-cyan);
    transform: translateX(4px);
  }

  .stack {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .stack .pill {
    font-size: 0.68rem;
    padding: 0.22rem 0.62rem;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1.2rem 0 1.6rem;
    border-top: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
    font-size: 0.76rem;
    color: var(--color-fog);
  }

  .bottom p {
    margin: 0;
  }

  .heart {
    color: var(--color-rose);
    animation: beat 1.4s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes beat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.28);
    }
  }

  /* ---------- 藏在页脚角落的门 ---------- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .door {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: -8px -6px -8px 0;
    opacity: 0.22;
    transition: opacity 0.4s ease;
  }

  .door::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-fog);
    transition:
      width 0.35s ease,
      height 0.35s ease,
      background 0.35s ease,
      box-shadow 0.35s ease;
  }

  .door:hover,
  .door:focus-visible {
    opacity: 1;
  }

  .door:hover::before,
  .door:focus-visible::before {
    width: 7px;
    height: 7px;
    background: var(--color-rose);
    box-shadow: 0 0 14px var(--color-rose);
  }

  .door::after {
    content: '这里有一道缝';
    position: absolute;
    right: 0;
    bottom: calc(100% + 2px);
    white-space: nowrap;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-rose);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
    pointer-events: none;
  }

  .door:hover::after,
  .door:focus-visible::after {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 520px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
