---
interface Props {
  items: string[];
  speed?: number;
}

const { items, speed = 38 } = Astro.props;
const doubled = [...items, ...items];
---

<div class="marquee" style={`--dur:${speed}s`} aria-hidden="true">
  <div class="track">
    {
      doubled.map((item) => (
        <span class="item">
          <span class="star">✦</span>
          {item}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding: 0.85rem 0;
    border-top: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
    border-bottom: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .track {
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: var(--animate-marquee);
    animation-duration: var(--dur);
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fog);
    white-space: nowrap;
  }

  .star {
    color: var(--color-cyan);
    font-size: 0.7rem;
  }
</style>
