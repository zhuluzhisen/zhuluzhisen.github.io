---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  cover?: ImageMetadata;
  featured?: boolean;
  index?: number;
}

const { href, title, description, pubDate, tags = [], cover, featured = false, index = 0 } =
  Astro.props;

const dateText = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article
  class="post-card glass glass-edge reveal"
  style={`--i:${index}`}
  data-tilt
>
  <a href={href} class="card-link">
    {
      cover && (
        <div class="thumb">
          <Image
            src={cover}
            alt={title}
            layout="constrained"
            width={640}
            sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw"
            quality={80}
            loading="lazy"
            decoding="async"
          />
          <span class="thumb-glow" aria-hidden="true" />
        </div>
      )
    }

    <div class="body">
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{dateText}</time>
        {featured && <span class="badge">精选</span>}
      </div>

      <h3 class="title">{title}</h3>
      <p class="desc">{description}</p>

      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => (
              <span class="pill">{t}</span>
            ))}
          </div>
        )
      }
    </div>

    <span class="corner" aria-hidden="true">
      <i class="ri-arrow-right-up-line"></i>
    </span>
  </a>
</article>

<style>
  .post-card {
    position: relative;
    transform-style: preserve-3d;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s ease;
    transition-delay: 0s;
  }

  .post-card.reveal {
    transition-delay: calc(var(--i) * 70ms);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ---- 封面 ---- */
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-ink-3);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card:hover .thumb img {
    transform: scale(1.1);
  }
  .thumb-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--color-void) 85%, transparent),
      transparent 55%
    );
  }

  /* ---- 正文 ---- */
  .body {
    padding: 1.3rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--color-fog);
  }

  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: 99px;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: #05060c;
    background: linear-gradient(120deg, var(--color-amber), var(--color-rose));
  }

  .title {
    font-size: 1.18rem;
    line-height: 1.45;
    transition: color 0.3s ease;
  }

  .post-card:hover .title {
    color: transparent;
    background: linear-gradient(100deg, var(--color-cyan), var(--color-violet) 60%, var(--color-rose));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .desc {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.7;
    color: var(--color-fog);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .tags .pill {
    font-size: 0.68rem;
    padding: 0.2rem 0.6rem;
  }

  /* ---- 角落箭头 ---- */
  .corner {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 1rem;
    color: var(--color-fog);
    border: 1px solid color-mix(in oklab, #ffffff 10%, transparent);
    background: color-mix(in oklab, var(--color-ink-3) 70%, transparent);
    opacity: 0;
    transform: translateY(6px) scale(0.85);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .post-card:hover .corner {
    opacity: 1;
    transform: none;
    color: #05060c;
    background: linear-gradient(135deg, var(--color-cyan), var(--color-violet));
    border-color: transparent;
  }
</style>

<script>
  function initTilt() {
    const cards = document.querySelectorAll<HTMLElement>('[data-tilt]');
    cards.forEach((card) => {
      if (card.dataset.tiltBound) return;
      card.dataset.tiltBound = '1';
      card.addEventListener('pointermove', (e: PointerEvent) => {
        if (!window.matchMedia('(pointer: fine)').matches) return;
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateY(${x * 7}deg) rotateX(${-y * 7}deg) translateY(-6px)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
      });
    });
  }

  document.addEventListener('astro:page-load', initTilt);
  initTilt();
</script>
