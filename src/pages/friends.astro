---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import Cover1 from '../assets/images/cover1.jpg';
import Cover3 from '../assets/images/cover3.jpg';
import Cover5 from '../assets/images/cover5.jpg';

const friends = [
  {
    name: '浅玉',
    url: 'http://shenyu-vip.lofter.com',
    desc: '摄影 · 光影与日常',
    avatar: Cover1,
  },
  {
    name: 'Hexo 主题',
    url: 'https://github.com',
    desc: '旧站的主题来源，感谢 ayer',
    avatar: Cover3,
  },
  {
    name: 'Astro',
    url: 'https://astro.build',
    desc: '新站驱动框架 · 内容优先',
    avatar: Cover5,
  },
];

const note = `想交换友链？我的博客主要内容是摄影随笔与生活记录。
链接格式：https://zhuluzhisen.github.io
站名：森 · SEN'S SPACE`;
---

<BaseLayout title="友链" description="友情链接 · 一起逛逛">
  <div class="page container-x">
    <header class="page-head reveal is-visible">
      <p class="section-kicker">FRIENDS</p>
      <h1 class="page-title">友链</h1>
      <p class="page-desc">一起逛逛别人的世界</p>
    </header>

    <div class="friend-grid">
      {
        friends.map((f, i) => (
          <a
            href={f.url}
            target="_blank"
            rel="noopener noreferrer"
            class="friend glass glass-edge reveal"
            style={`--i:${i}`}
          >
            <Image
              src={f.avatar}
              alt={f.name}
              layout="constrained"
              width={104}
              sizes="52px"
              quality={80}
              loading="lazy"
              class="friend-avatar"
            />
            <div class="friend-body">
              <h3 class="friend-name">{f.name}</h3>
              <p class="friend-desc">{f.desc}</p>
            </div>
            <i class="ri-arrow-right-up-line friend-arrow" aria-hidden="true" />
          </a>
        ))
      }
    </div>

    <section class="apply glass glass-edge reveal is-visible">
      <h2 class="apply-title">交换友链</h2>
      <pre class="apply-code"><code>{note}</code></pre>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3.2rem;
  }

  .page-head {
    margin-bottom: 2.4rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.5rem;
  }

  .page-desc {
    margin: 0;
    color: var(--color-fog);
    font-size: 0.95rem;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .friend {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    padding: 1.1rem;
    border-radius: 20px;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s ease;
  }

  .friend:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 60px -28px color-mix(in oklab, var(--color-violet) 85%, transparent);
  }

  .friend-avatar {
    width: 52px;
    height: 52px;
    border-radius: 15px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid color-mix(in oklab, #ffffff 12%, transparent);
  }

  .friend-body {
    min-width: 0;
  }

  .friend-name {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .friend-desc {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-fog);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-arrow {
    margin-left: auto;
    color: var(--color-fog);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.35s ease;
  }

  .friend:hover .friend-arrow {
    opacity: 1;
    transform: none;
    color: var(--color-cyan);
  }

  .apply {
    padding: 1.8rem;
    border-radius: 22px;
  }

  .apply-title {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .apply-code {
    margin: 0;
    padding: 1.1rem 1.3rem;
    border-radius: 14px;
    background: #080a12;
    border: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.9;
    color: #cfd6e6;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  @media (max-width: 900px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
