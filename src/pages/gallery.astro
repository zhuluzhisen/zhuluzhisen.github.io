---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';

// 个人照片已全部收进 /secret，公开相册只放风景与封面类照片
import Cover1 from '../assets/images/cover1.jpg';
import Cover2 from '../assets/images/cover2.jpg';
import Cover3 from '../assets/images/cover3.jpg';
import Cover4 from '../assets/images/cover4.jpg';
import Cover5 from '../assets/images/cover5.jpg';
import Cover6 from '../assets/images/cover6.jpg';
import Cover7 from '../assets/images/cover7.jpg';

const shots = [
  { src: Cover1, alt: '封面 · 一', caption: '封面 · 一' },
  { src: Cover2, alt: '封面 · 二', caption: '封面 · 二' },
  { src: Cover3, alt: '封面 · 三', caption: '封面 · 三' },
  { src: Cover4, alt: '封面 · 四', caption: '封面 · 四' },
  { src: Cover5, alt: '封面 · 五', caption: '封面 · 五' },
  { src: Cover6, alt: '封面 · 六', caption: '封面 · 六' },
  { src: Cover7, alt: '封面 · 七', caption: '封面 · 七' },
];

const filters = ['全部', '人像', '风景', '日常'];
---

<BaseLayout title="相册" description="照片墙 · 记录光影，也记录生活">
  <div class="page container-x">
    <header class="page-head reveal is-visible">
      <p class="section-kicker">GALLERY</p>
      <h1 class="page-title">相册</h1>
      <p class="page-desc">
        共 {shots.length} 张照片 · 点击任意一张可放大浏览
      </p>
    </header>

    <div class="filter-row reveal is-visible">
      {
        filters.map((f, i) => (
          <button type="button" class={i === 0 ? 'chip active' : 'chip'} data-filter={f}>
            {f}
          </button>
        ))
      }
    </div>

    <div class="gallery-panel glass glass-edge reveal">
      <Gallery shots={shots} columns={3} />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3.2rem;
  }

  .page-head {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.5rem;
  }

  .page-desc {
    margin: 0;
    color: var(--color-fog);
    font-size: 0.9rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.6rem;
  }

  .chip {
    padding: 0.34rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--color-fog);
    border: 1px solid color-mix(in oklab, #ffffff 10%, transparent);
    background: color-mix(in oklab, #ffffff 3%, transparent);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .chip:hover {
    color: #fff;
    border-color: color-mix(in oklab, var(--color-cyan) 55%, transparent);
  }

  .chip.active {
    color: #05060c;
    background: linear-gradient(120deg, var(--color-cyan), var(--color-violet));
    border-color: transparent;
    font-weight: 600;
  }

  .gallery-panel {
    padding: 1.3rem;
    border-radius: 26px;
  }

  @media (max-width: 900px) {
    .gallery-panel :global(.gallery) {
      --cols: 2 !important;
    }
  }

  @media (max-width: 560px) {
    .gallery-panel :global(.gallery) {
      --cols: 1 !important;
    }
  }
</style>
