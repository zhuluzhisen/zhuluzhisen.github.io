---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/games.css';
---

<BaseLayout title="2048" description="2048 · 滑动合并相同数字，凑出 2048">
  <div class="gx-page container-x" id="g2048Root">
    <a class="gx-back" href="/games">
      <i class="ri-arrow-left-line" aria-hidden="true"></i>
      游戏厅
    </a>

    <header class="gx-head">
      <p class="gx-kicker">2048</p>
      <h1 class="gx-title">2048</h1>
      <p class="gx-sub">方向键滑动，相同的数字撞在一起就翻倍。格子填满又动不了时结束。</p>
    </header>

    <div class="gx-stage">
      <div class="gx-board-col">
        <div class="gx-screen" style="max-width:520px">
          <canvas id="g2048Canvas"></canvas>
          <div class="gx-overlay" id="g2048Overlay">
            <div class="gx-overlay-card">
              <p class="gx-overlay-kicker" id="g2048Kicker">READY</p>
              <h2 class="gx-overlay-title" id="g2048Title">准备好了吗</h2>
              <p class="gx-overlay-desc" id="g2048Desc">按方向键开始滑动</p>
              <button class="gx-btn" id="g2048Btn" type="button">开始游戏</button>
            </div>
          </div>
        </div>
      </div>

      <aside class="gx-side">
        <div class="gx-panel">
          <p class="gx-panel-label">SCORE · 得分</p>
          <p class="gx-score" id="g2048Score">0</p>
          <p class="gx-score-sub">最高 <span id="g2048Best">0</span></p>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">CONTROLS · 操作</p>
          <div class="gx-keys">
            <span class="gx-key">↑ ↓ ← →</span>
            <span class="gx-key">W A S D</span>
            <span class="gx-key">R 重开</span>
          </div>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">TIP · 提示</p>
          <p class="gx-note">
            把最大的数字固定在一个角落，只往两个方向推，别让它到处跑。实在走不动了再考虑另一个方向。
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const N = 4;
  const CELL = 110;
  const GAP = 14;
  const SIZE = N * CELL + (N + 1) * GAP;
  const BEST_KEY = 'fang-2048-best';
  const ANIM = 108;

  const STYLE: Record<number, [string, string]> = {
    2: ['#1b2334', '#dbe4f5'],
    4: ['#253247', '#e8f0fd'],
    8: ['#0e7490', '#e6fbff'],
    16: ['#0891b2', '#eafdff'],
    32: ['#7c3aed', '#f3eeff'],
    64: ['#8b5cf6', '#f7f2ff'],
    128: ['#be185d', '#ffe9f2'],
    256: ['#e11d48', '#fff0f3'],
    512: ['#d97706', '#fff7e6'],
    1024: ['#f59e0b', '#fffaf0'],
    2048: ['#22d3ee', '#04222b'],
    4096: ['#a78bfa', '#190f2e'],
  };

  type Tile = {
    id: number;
    value: number;
    r: number;
    c: number;
    fromR: number;
    fromC: number;
    dying: boolean;
    pending: boolean;
    popAt: number;
    popMode: 'new' | 'merge' | null;
  };

  let raf = 0;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let keyHandler: ((e: KeyboardEvent) => void) | null = null;
  let touchHandler: ((e: TouchEvent) => void) | null = null;

  let tiles: Tile[] = [];
  let grid: (Tile | null)[][] = [];
  let score = 0;
  let best = 0;
  let uid = 1;
  let mode: 'ready' | 'playing' | 'paused' | 'over' | 'win' = 'ready';
  let busy = false;
  let anim: { t0: number } | null = null;
  let pendingGain = 0;
  let continued = false;
  let btnAction: 'start' | 'continue' = 'start';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const emptyGrid = () => Array.from({ length: N }, () => new Array<Tile | null>(N).fill(null));

  function syncHud() {
    const s = $('g2048Score');
    const b = $('g2048Best');
    if (s) s.textContent = String(score);
    if (b) b.textContent = String(best);
  }

  function addTile(r: number, c: number, value: number, popMode: 'new' | 'merge' | null) {
    const t: Tile = {
      id: uid++,
      value,
      r,
      c,
      fromR: r,
      fromC: c,
      dying: false,
      pending: false,
      popAt: popMode ? performance.now() : 0,
      popMode,
    };
    tiles.push(t);
    grid[r][c] = t;
    return t;
  }

  function freeCells() {
    const out: { r: number; c: number }[] = [];
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) if (!grid[r][c]) out.push({ r, c });
    }
    return out;
  }

  function spawn() {
    const cells = freeCells();
    if (!cells.length) return;
    const pick = cells[Math.floor(Math.random() * cells.length)];
    addTile(pick.r, pick.c, Math.random() < 0.9 ? 2 : 4, 'new');
  }

  function reset() {
    tiles = [];
    grid = emptyGrid();
    score = 0;
    uid = 1;
    busy = false;
    anim = null;
    continued = false;
    pendingGain = 0;
    spawn();
    spawn();
    syncHud();
  }

  /* ---------- 坐标换算 ---------- */
  function coord(dir: string, line: number, slot: number) {
    if (dir === 'left') return { r: line, c: slot };
    if (dir === 'right') return { r: line, c: N - 1 - slot };
    if (dir === 'up') return { r: slot, c: line };
    return { r: N - 1 - slot, c: line };
  }

  function lineTiles(dir: string, line: number) {
    const arr: Tile[] = [];
    for (let slot = 0; slot < N; slot++) {
      const { r, c } = coord(dir, line, slot);
      const t = grid[r][c];
      if (t) arr.push(t);
    }
    return arr;
  }

  function move(dir: string) {
    if (busy || mode !== 'playing') return;

    let moved = false;
    let gain = 0;
    const survivors: Tile[] = [];
    const newGrid = emptyGrid();

    for (let line = 0; line < N; line++) {
      const seq = lineTiles(dir, line);
      if (!seq.length) continue;

      let slot = 0;
      let i = 0;
      while (i < seq.length) {
        const a = seq[i];
        const b = seq[i + 1];
        const pos = coord(dir, line, slot);

        a.fromR = a.r;
        a.fromC = a.c;
        a.r = pos.r;
        a.c = pos.c;
        if (a.fromR !== a.r || a.fromC !== a.c) moved = true;

        if (b && b.value === a.value) {
          b.fromR = b.r;
          b.fromC = b.c;
          b.r = pos.r;
          b.c = pos.c;
          b.dying = true;
          a.pending = true;
          gain += a.value * 2;
          moved = true;
          i += 2;
        } else {
          i += 1;
        }

        survivors.push(a);
        newGrid[pos.r][pos.c] = a;
        slot += 1;
      }
    }

    if (!moved) {
      checkState();
      return;
    }

    grid = newGrid;
    pendingGain = gain;
    busy = true;
    anim = { t0: performance.now() };
  }

  function commit() {
    let hitWin = false;

    for (const t of tiles) {
      if (t.pending) {
        t.value *= 2;
        t.pending = false;
        t.popAt = performance.now();
        t.popMode = 'merge';
        if (t.value === 2048 && !continued) hitWin = true;
      }
    }

    score += pendingGain;
    pendingGain = 0;

    tiles = tiles.filter((t) => !t.dying);
    grid = emptyGrid();
    for (const t of tiles) grid[t.r][t.c] = t;

    spawn();
    finishMove();

    if (hitWin) {
      win();
      return;
    }
    checkState();
  }

  function finishMove() {
    busy = false;
    anim = null;
    syncHud();
    if (score > best) {
      best = score;
      try {
        localStorage.setItem(BEST_KEY, String(best));
      } catch (e) {
        /* ignore */
      }
      syncHud();
    }
  }

  function hasMoves() {
    if (freeCells().length) return true;
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const v = grid[r][c]?.value;
        if (c + 1 < N && grid[r][c + 1]?.value === v) return true;
        if (r + 1 < N && grid[r + 1][c]?.value === v) return true;
      }
    }
    return false;
  }

  function checkState() {
    if (mode !== 'playing') return;
    if (!hasMoves()) {
      mode = 'over';
      overlay('GAME OVER', '走不动了', `本局得分 <b>${score}</b> · 最高 ${best}`, '再来一局');
      btnAction = 'start';
    }
  }

  function win() {
    mode = 'win';
    overlay('2048', '凑到 2048 了', `分数 <b>${score}</b><br>还能继续往上叠，要继续吗？`, '继续挑战');
    btnAction = 'continue';
  }

  function overlay(kicker: string, title: string, desc: string, btn: string | null) {
    const ov = $('g2048Overlay');
    if (!ov) return;
    const k = $('g2048Kicker');
    const t = $('g2048Title');
    const d = $('g2048Desc');
    const b = $<HTMLButtonElement>('g2048Btn');
    if (k) k.textContent = kicker;
    if (t) t.textContent = title;
    if (d) d.innerHTML = desc;
    if (b) {
      if (btn) {
        b.hidden = false;
        b.textContent = btn;
      } else {
        b.hidden = true;
      }
    }
    ov.hidden = false;
  }

  function hideOverlay() {
    const ov = $('g2048Overlay');
    if (ov) ov.hidden = true;
  }

  function start() {
    reset();
    mode = 'playing';
    hideOverlay();
    btnAction = 'start';
  }

  /* ---------- 绘制 ---------- */
  function roundRect(g: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    g.beginPath();
    if (typeof g.roundRect === 'function') g.roundRect(x, y, w, h, r);
    else {
      g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r);
      g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r);
      g.arcTo(x, y, x + w, y, r);
      g.closePath();
    }
  }

  function cellPos(r: number, c: number) {
    return { x: GAP + c * (CELL + GAP), y: GAP + r * (CELL + GAP) };
  }

  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  function drawTile(t: Tile, now: number, progress: number) {
    if (!ctx) return;
    const a = cellPos(t.fromR, t.fromC);
    const b = cellPos(t.r, t.c);
    const x = a.x + (b.x - a.x) * progress;
    const y = a.y + (b.y - a.y) * progress;

    let scale = 1;
    let alpha = 1;
    if (t.popMode && t.popAt) {
      const p = Math.min(1, (now - t.popAt) / 150);
      if (t.popMode === 'new') scale = 0.5 + 0.5 * easeOut(p);
      else scale = 1 + 0.16 * Math.sin(p * Math.PI);
    }
    if (t.dying) alpha = 1 - progress * 0.85;

    const st = STYLE[t.value] || ['#22d3ee', '#04222b'];
    const size = CELL * scale;
    const ox = x + (CELL - size) / 2;
    const oy = y + (CELL - size) / 2;

    ctx.save();
    ctx.globalAlpha = alpha;

    if (t.value >= 512) {
      ctx.shadowColor = st[0];
      ctx.shadowBlur = 22;
    }
    ctx.fillStyle = st[0];
    roundRect(ctx, ox, oy, size, size, 14);
    ctx.fill();
    ctx.shadowBlur = 0;

    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    ctx.lineWidth = 1;
    roundRect(ctx, ox + 0.5, oy + 0.5, size - 1, size - 1, 14);
    ctx.stroke();

    const digits = String(t.value).length;
    const fs = Math.round((digits <= 2 ? 46 : digits === 3 ? 38 : digits === 4 ? 30 : 24) * scale);
    ctx.fillStyle = st[1];
    ctx.font = `700 ${fs}px "Space Grotesk", ui-monospace, monospace`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(String(t.value), ox + size / 2, oy + size / 2 + size * 0.02);

    ctx.restore();
  }

  function draw(now: number) {
    if (!ctx) return;

    ctx.fillStyle = '#080b14';
    ctx.fillRect(0, 0, SIZE, SIZE);

    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const p = cellPos(r, c);
        ctx.fillStyle = 'rgba(255,255,255,0.045)';
        roundRect(ctx, p.x, p.y, CELL, CELL, 14);
        ctx.fill();
      }
    }

    const progress = anim ? easeOut(Math.min(1, (now - anim.t0) / ANIM)) : 1;

    for (const t of tiles) if (t.dying) drawTile(t, now, progress);
    for (const t of tiles) if (!t.dying) drawTile(t, now, progress);
  }

  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    if (!canvas || !canvas.isConnected) {
      cancelAnimationFrame(raf);
      return;
    }
    if (busy && anim && now - anim.t0 >= ANIM) commit();
    draw(now);
  }

  /* ---------- 输入 ---------- */
  const DIRS: Record<string, string> = {
    ArrowLeft: 'left',
    ArrowRight: 'right',
    ArrowUp: 'up',
    ArrowDown: 'down',
    a: 'left',
    d: 'right',
    w: 'up',
    s: 'down',
    A: 'left',
    D: 'right',
    W: 'up',
    S: 'down',
    h: 'left',
    l: 'right',
    k: 'up',
    j: 'down',
  };

  function setup() {
    canvas = $<HTMLCanvasElement>('g2048Canvas');
    if (!canvas) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = SIZE * dpr;
    canvas.height = SIZE * dpr;
    ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    try {
      best = Number(localStorage.getItem(BEST_KEY) || 0) || 0;
    } catch (e) {
      best = 0;
    }

    reset();
    mode = 'ready';
    overlay('READY', '准备好了吗', '按方向键开始滑动，第一次按键直接开局', null);

    const btn = $<HTMLButtonElement>('g2048Btn');
    if (btn) {
      btn.addEventListener('click', () => {
        if (btnAction === 'continue') {
          continued = true;
          mode = 'playing';
          hideOverlay();
        } else {
          start();
        }
      });
    }

    keyHandler = (e: KeyboardEvent) => {
      const dir = DIRS[e.key];
      if (dir) {
        e.preventDefault();
        if (mode === 'ready' || mode === 'over') start();
        if (mode === 'playing') move(dir);
      } else if (e.key === 'r' || e.key === 'R') {
        start();
      }
    };
    window.addEventListener('keydown', keyHandler);

    let tx = 0;
    let ty = 0;
    touchHandler = (e: TouchEvent) => {
      const t = e.touches[0];
      if (!t) return;
      if (e.type === 'touchstart') {
        tx = t.clientX;
        ty = t.clientY;
        if (mode === 'ready' || mode === 'over') start();
        return;
      }
      const dx = t.clientX - tx;
      const dy = t.clientY - ty;
      if (Math.abs(dx) < 26 && Math.abs(dy) < 26) return;
      e.preventDefault();
      if (Math.abs(dx) > Math.abs(dy)) move(dx > 0 ? 'right' : 'left');
      else move(dy > 0 ? 'down' : 'up');
      tx = t.clientX;
      ty = t.clientY;
    };
    canvas.addEventListener('touchstart', touchHandler, { passive: true });
    canvas.addEventListener('touchmove', touchHandler, { passive: false });

    raf = requestAnimationFrame(loop);
  }

  function destroy() {
    cancelAnimationFrame(raf);
    if (keyHandler) window.removeEventListener('keydown', keyHandler);
    if (touchHandler && canvas) {
      canvas.removeEventListener('touchstart', touchHandler);
      canvas.removeEventListener('touchmove', touchHandler);
    }
    keyHandler = null;
    touchHandler = null;
    ctx = null;
    canvas = null;
  }

  function boot() {
    const root = document.getElementById('g2048Root');
    if (!root || root.dataset.booted) return;
    root.dataset.booted = '1';
    setup();
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', destroy);
  boot();
</script>
