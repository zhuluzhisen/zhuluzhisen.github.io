---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerBar from '../../components/PlayerBar.astro';
import '../../styles/games.css';
---

<BaseLayout title="打砖块" description="打砖块 · 一块挡板一颗球，清完一屏难度上一档">
  <div class="gx-page container-x" id="breakoutRoot">
    <a class="gx-back" href="/games">
      <i class="ri-arrow-left-line" aria-hidden="true"></i>
      游戏厅
    </a>

    <header class="gx-head">
      <div class="gx-head-row">
        <div>
          <p class="gx-kicker">BREAKOUT</p>
          <h1 class="gx-title">打砖块</h1>
        </div>
        <PlayerBar />
      </div>
      <p class="gx-sub">鼠标或 ← → 控制挡板，空格发球。三条命，清完一屏砖就进下一关，球会越来越快。</p>
    </header>

    <div class="gx-stage">
      <div class="gx-board-col">
        <div class="gx-screen" style="max-width:760px">
          <canvas id="breakoutCanvas"></canvas>
          <div class="gx-overlay" id="breakoutOverlay">
            <div class="gx-overlay-card">
              <p class="gx-overlay-kicker" id="breakoutKicker">READY</p>
              <h2 class="gx-overlay-title" id="breakoutTitle">准备好了吗</h2>
              <p class="gx-overlay-desc" id="breakoutDesc">移动鼠标控制挡板，按 <b>空格</b> 发球</p>
              <button class="gx-btn" id="breakoutBtn" type="button">开始游戏</button>
            </div>
          </div>
        </div>
      </div>

      <aside class="gx-side">
        <div class="gx-panel">
          <p class="gx-panel-label">SCORE · 得分</p>
          <p class="gx-score" id="breakoutScore">0</p>
          <p class="gx-score-sub">最高 <span id="breakoutBest">0</span></p>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">STATUS · 状态</p>
          <p class="gx-score gx-score--sm" id="breakoutLives">♥ ♥ ♥</p>
          <p class="gx-score-sub">第 <span id="breakoutLevel">1</span> 关 · 剩 <span id="breakoutLeft">45</span> 块</p>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">CONTROLS · 操作</p>
          <div class="gx-keys">
            <span class="gx-key">鼠标</span>
            <span class="gx-key">← →</span>
            <span class="gx-key">空格 发球</span>
            <span class="gx-key">P 暂停</span>
          </div>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">TIP · 提示</p>
          <p class="gx-note">
            球打在挡板<b>边缘</b>时角度更斜，打在中间只会直直弹回。想控制落点，就用边缘去接。
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { readStat, recordRun } from '../../lib/save-store';

  const W = 720;
  const H = 460;

  const COLS = 9;
  const ROWS = 5;
  const BRICK_H = 24;
  const BRICK_GAP = 8;
  const MARGIN = 26;
  const TOP = 58;
  const BRICK_W = (W - MARGIN * 2 - BRICK_GAP * (COLS - 1)) / COLS;

  const ROW_COLORS = ['#fb7185', '#a78bfa', '#22d3ee', '#a3e635', '#fbbf24'];

  type Brick = { x: number; y: number; w: number; h: number; row: number; alive: boolean };
  type Particle = { x: number; y: number; vx: number; vy: number; life: number; color: string };

  let raf = 0;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let keyHandler: ((e: KeyboardEvent) => void) | null = null;
  let keyUpHandler: ((e: KeyboardEvent) => void) | null = null;
  let moveHandler: ((e: PointerEvent) => void) | null = null;
  let touchHandler: ((e: TouchEvent) => void) | null = null;
  let clickHandler: (() => void) | null = null;
  let blurHandler: (() => void) | null = null;

  let bricks: Brick[] = [];
  let particles: Particle[] = [];
  let ball = { x: W / 2, y: H - 60, vx: 0, vy: 0, r: 7 };
  let trail: { x: number; y: number }[] = [];
  let paddle = { x: W / 2 - 56, y: H - 34, w: 112, h: 13 };
  let paddleDir = 0;
  let lives = 3;
  let score = 0;
  let best = 0;
  let level = 1;
  let left = 0;
  let launched = false;
  let last = 0;
  let mode: 'ready' | 'playing' | 'paused' | 'over' | 'clear' = 'ready';
  const keys = { left: false, right: false };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function ballSpeed() {
    return 372 * Math.pow(1.055, level - 1);
  }

  function buildBricks() {
    bricks = [];
    for (let row = 0; row < ROWS; row++) {
      for (let col = 0; col < COLS; col++) {
        bricks.push({
          x: MARGIN + col * (BRICK_W + BRICK_GAP),
          y: TOP + row * (BRICK_H + BRICK_GAP),
          w: BRICK_W,
          h: BRICK_H,
          row,
          alive: true,
        });
      }
    }
    left = bricks.length;
    syncHud();
  }

  function resetBall() {
    launched = false;
    paddle.x = W / 2 - paddle.w / 2;
    ball.x = paddle.x + paddle.w / 2;
    ball.y = paddle.y - ball.r - 2;
    ball.vx = 0;
    ball.vy = 0;
    trail = [];
  }

  function launch() {
    if (mode !== 'playing' || launched) return;
    const speed = ballSpeed();
    const angle = (-Math.PI / 2) + (Math.random() * 0.5 - 0.25);
    ball.vx = Math.cos(angle) * speed;
    ball.vy = Math.sin(angle) * speed;
    launched = true;
  }

  function syncHud() {
    const s = $('breakoutScore');
    const b = $('breakoutBest');
    const lv = $('breakoutLives');
    const lg = $('breakoutLevel');
    const lf = $('breakoutLeft');
    if (s) s.textContent = String(score);
    if (b) b.textContent = String(best);
    if (lv) lv.textContent = lives > 0 ? '♥ '.repeat(lives).trim() : '—';
    if (lg) lg.textContent = String(level);
    if (lf) lf.textContent = String(left);
  }

  function overlay(kicker: string, title: string, desc: string, btn: string | null) {
    const ov = $('breakoutOverlay');
    if (!ov) return;
    const k = $('breakoutKicker');
    const t = $('breakoutTitle');
    const d = $('breakoutDesc');
    const b = $<HTMLButtonElement>('breakoutBtn');
    if (k) k.textContent = kicker;
    if (t) t.textContent = title;
    if (d) d.innerHTML = desc;
    if (b) {
      if (btn) {
        b.hidden = false;
        b.textContent = btn;
      } else {
        b.hidden = true;
      }
    }
    ov.hidden = false;
  }

  function hideOverlay() {
    const ov = $('breakoutOverlay');
    if (ov) ov.hidden = true;
  }

  function saveBest() {
    if (score > best) {
      best = score;
      syncHud();
    }
  }

  function start() {
    score = 0;
    lives = 3;
    level = 1;
    particles = [];
    buildBricks();
    resetBall();
    mode = 'playing';
    syncHud();
    hideOverlay();
  }

  function burst(x: number, y: number, color: string) {
    for (let i = 0; i < 7; i++) {
      const a = Math.random() * Math.PI * 2;
      const sp = 40 + Math.random() * 130;
      particles.push({
        x,
        y,
        vx: Math.cos(a) * sp,
        vy: Math.sin(a) * sp,
        life: 0.45 + Math.random() * 0.3,
        color,
      });
    }
  }

  function loseLife() {
    lives -= 1;
    syncHud();
    if (lives <= 0) {
      mode = 'over';
      const isNewBest = score > best;
      saveBest();
      void recordRun('breakout', score, { level });
      overlay(
        isNewBest ? 'NEW RECORD' : 'GAME OVER',
        isNewBest ? '新纪录！' : '三条命用完了',
        `本局得分 <b>${score}</b> · 打到第 ${level} 关<br>按 <b>空格</b> 再来一局`,
        '再来一局',
      );
      return;
    }
    resetBall();
    overlay('READY', '还剩一条命', '按 <b>空格</b> 继续', null);
    window.setTimeout(() => {
      if (mode === 'playing') hideOverlay();
    }, 700);
  }

  function nextLevel() {
    mode = 'clear';
    score += 150 * level;
    saveBest();
    overlay('CLEAR', `第 ${level} 关清完`, `总分 <b>${score}</b><br>下一关球速会更快`, null);
    window.setTimeout(() => {
      level += 1;
      buildBricks();
      resetBall();
      particles = [];
      mode = 'playing';
      syncHud();
      hideOverlay();
    }, 1100);
  }

  function togglePause() {
    if (mode === 'playing') {
      mode = 'paused';
      overlay('PAUSED', '暂停中', '按 <b>P</b> 或空格继续', '继续');
    } else if (mode === 'paused') {
      mode = 'playing';
      last = performance.now();
      hideOverlay();
    }
  }

  /* ---------- 物理 ---------- */
  function hitBrick() {
    for (const b of bricks) {
      if (!b.alive) continue;
      const cx = Math.max(b.x, Math.min(ball.x, b.x + b.w));
      const cy = Math.max(b.y, Math.min(ball.y, b.y + b.h));
      const dx = ball.x - cx;
      const dy = ball.y - cy;
      if (dx * dx + dy * dy > ball.r * ball.r) continue;

      b.alive = false;
      left -= 1;
      score += (ROWS - b.row) * 10;
      syncHud();
      burst(b.x + b.w / 2, b.y + b.h / 2, ROW_COLORS[b.row]);

      const overlapX = ball.r - Math.abs(dx);
      const overlapY = ball.r - Math.abs(dy);
      if (overlapX < overlapY) {
        ball.vx = -ball.vx;
        ball.x += ball.vx > 0 ? overlapX : -overlapX;
      } else {
        ball.vy = -ball.vy;
        ball.y += ball.vy > 0 ? overlapY : -overlapY;
      }
      return;
    }
  }

  function stepBall(dt: number) {
    const speed = Math.hypot(ball.vx, ball.vy);
    const dist = speed * dt;
    const steps = Math.max(1, Math.ceil(dist / 5));
    const sdt = dt / steps;

    for (let i = 0; i < steps; i++) {
      ball.x += ball.vx * sdt;
      ball.y += ball.vy * sdt;

      if (ball.x - ball.r < 0) {
        ball.x = ball.r;
        ball.vx = Math.abs(ball.vx);
      } else if (ball.x + ball.r > W) {
        ball.x = W - ball.r;
        ball.vx = -Math.abs(ball.vx);
      }
      if (ball.y - ball.r < 0) {
        ball.y = ball.r;
        ball.vy = Math.abs(ball.vy);
      }

      if (ball.y - ball.r > H) {
        loseLife();
        return;
      }

      // 挡板
      if (
        ball.vy > 0 &&
        ball.y + ball.r >= paddle.y &&
        ball.y - ball.r <= paddle.y + paddle.h &&
        ball.x >= paddle.x - ball.r * 0.4 &&
        ball.x <= paddle.x + paddle.w + ball.r * 0.4
      ) {
        const rel = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
        const clamped = Math.max(-1, Math.min(1, rel));
        const angle = clamped * (Math.PI / 3);
        const sp = Math.max(speed, ballSpeed() * 0.92);
        ball.vx = Math.sin(angle) * sp;
        ball.vy = -Math.abs(Math.cos(angle) * sp);
        ball.y = paddle.y - ball.r - 0.5;
      }

      hitBrick();

      if (left <= 0) {
        nextLevel();
        return;
      }
    }
  }

  function update(dt: number) {
    if (mode !== 'playing') return;

    paddleDir = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
    if (paddleDir !== 0) paddle.x += paddleDir * 620 * dt;
    paddle.x = Math.max(0, Math.min(W - paddle.w, paddle.x));

    if (!launched) {
      ball.x = paddle.x + paddle.w / 2;
      ball.y = paddle.y - ball.r - 2;
    } else {
      trail.push({ x: ball.x, y: ball.y });
      if (trail.length > 9) trail.shift();
      stepBall(dt);
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.life -= dt;
      if (p.life <= 0) {
        particles.splice(i, 1);
        continue;
      }
      p.vy += 420 * dt;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
    }
  }

  /* ---------- 绘制 ---------- */
  function roundRect(g: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    g.beginPath();
    if (typeof g.roundRect === 'function') g.roundRect(x, y, w, h, r);
    else {
      g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r);
      g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r);
      g.arcTo(x, y, x + w, y, r);
      g.closePath();
    }
  }

  function draw() {
    if (!ctx) return;

    const bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#070a13');
    bg.addColorStop(1, '#04060d');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = 'rgba(255,255,255,0.03)';
    ctx.lineWidth = 1;
    for (let x = 40; x < W; x += 40) {
      ctx.beginPath();
      ctx.moveTo(x + 0.5, 0);
      ctx.lineTo(x + 0.5, H);
      ctx.stroke();
    }
    for (let y = 40; y < H; y += 40) {
      ctx.beginPath();
      ctx.moveTo(0, y + 0.5);
      ctx.lineTo(W, y + 0.5);
      ctx.stroke();
    }

    for (const b of bricks) {
      if (!b.alive) continue;
      const color = ROW_COLORS[b.row];
      ctx.save();
      ctx.shadowColor = color;
      ctx.shadowBlur = 12;
      ctx.fillStyle = color;
      roundRect(ctx, b.x, b.y, b.w, b.h, 6);
      ctx.fill();
      ctx.restore();

      ctx.fillStyle = 'rgba(255,255,255,0.26)';
      roundRect(ctx, b.x + 2, b.y + 2, b.w - 4, b.h * 0.34, 4);
      ctx.fill();
    }

    for (const p of particles) {
      ctx.globalAlpha = Math.max(0, Math.min(1, p.life * 2));
      ctx.fillStyle = p.color;
      ctx.fillRect(p.x - 1.6, p.y - 1.6, 3.2, 3.2);
    }
    ctx.globalAlpha = 1;

    const pg = ctx.createLinearGradient(paddle.x, 0, paddle.x + paddle.w, 0);
    pg.addColorStop(0, '#22d3ee');
    pg.addColorStop(0.5, '#9df6ff');
    pg.addColorStop(1, '#a78bfa');
    ctx.save();
    ctx.shadowColor = 'rgba(34,211,238,0.9)';
    ctx.shadowBlur = 18;
    ctx.fillStyle = pg;
    roundRect(ctx, paddle.x, paddle.y, paddle.w, paddle.h, 6.5);
    ctx.fill();
    ctx.restore();

    for (let i = 0; i < trail.length; i++) {
      const t = trail[i];
      const k = (i + 1) / trail.length;
      ctx.globalAlpha = k * 0.32;
      ctx.fillStyle = '#bdefff';
      ctx.beginPath();
      ctx.arc(t.x, t.y, ball.r * 0.85 * k, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    ctx.save();
    ctx.shadowColor = 'rgba(255,255,255,0.9)';
    ctx.shadowBlur = 16;
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    if (launched) {
      ctx.strokeStyle = 'rgba(34,211,238,0.22)';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 6]);
      ctx.beginPath();
      ctx.moveTo(ball.x + ball.vx * 0.08, ball.y + ball.vy * 0.08);
      ctx.lineTo(ball.x + ball.vx * 0.2, ball.y + ball.vy * 0.2);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    if (!launched && mode === 'playing') {
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.font = '600 13px ui-monospace, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('按空格发球', W / 2, paddle.y - 34);
    }

    ctx.fillStyle = 'rgba(255,255,255,0.28)';
    ctx.font = '600 12px ui-monospace, monospace';
    ctx.textAlign = 'left';
    ctx.fillText(`LV ${level}`, MARGIN, 34);
    ctx.textAlign = 'right';
    ctx.fillText(`♥ ${Math.max(0, lives)}`, W - MARGIN, 34);
  }

  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    if (!canvas || !canvas.isConnected) {
      cancelAnimationFrame(raf);
      return;
    }
    const dt = Math.min(40, now - last) / 1000;
    last = now;
    update(dt);
    draw();
  }

  function pointerToX(clientX: number) {
    if (!canvas) return W / 2;
    const rect = canvas.getBoundingClientRect();
    return ((clientX - rect.left) / rect.width) * W;
  }

  function setup() {
    canvas = $<HTMLCanvasElement>('breakoutCanvas');
    if (!canvas) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    void readStat('breakout').then((rec) => {
      best = Math.max(best, rec.best || 0);
      syncHud();
    });

    buildBricks();
    resetBall();
    mode = 'ready';
    syncHud();
    overlay('READY', '准备好了吗', '移动鼠标控制挡板，按 <b>空格</b> 发球', '开始游戏');

    const btn = $<HTMLButtonElement>('breakoutBtn');
    if (btn)
      btn.addEventListener('click', () => {
        if (mode === 'paused') togglePause();
        else start();
      });

    moveHandler = (e: PointerEvent) => {
      if (mode !== 'playing') return;
      const x = pointerToX(e.clientX);
      paddle.x = Math.max(0, Math.min(W - paddle.w, x - paddle.w / 2));
    };
    canvas.addEventListener('pointermove', moveHandler);
    canvas.addEventListener('pointerdown', moveHandler);

    touchHandler = (e: TouchEvent) => {
      const t = e.touches[0];
      if (!t) return;
      e.preventDefault();
      if (mode === 'playing') {
        const x = pointerToX(t.clientX);
        paddle.x = Math.max(0, Math.min(W - paddle.w, x - paddle.w / 2));
        if (!launched) launch();
      }
    };
    canvas.addEventListener('touchstart', touchHandler, { passive: false });
    canvas.addEventListener('touchmove', touchHandler, { passive: false });

    clickHandler = () => {
      if (mode === 'ready' || mode === 'over') start();
      else if (mode === 'playing' && !launched) launch();
    };
    canvas.addEventListener('click', clickHandler);

    keyHandler = (e: KeyboardEvent) => {
      const k = e.key;
      let used = true;
      if (k === 'ArrowLeft' || k === 'a' || k === 'A') keys.left = true;
      else if (k === 'ArrowRight' || k === 'd' || k === 'D') keys.right = true;
      else if (k === ' ') {
        if (mode === 'ready' || mode === 'over') start();
        else if (mode === 'playing') launch();
        else if (mode === 'paused') togglePause();
      } else if (k === 'p' || k === 'P' || k === 'Escape') togglePause();
      else if (k === 'r' || k === 'R') start();
      else used = false;
      if (used) e.preventDefault();
    };

    keyUpHandler = (e: KeyboardEvent) => {
      const k = e.key;
      if (k === 'ArrowLeft' || k === 'a' || k === 'A') keys.left = false;
      if (k === 'ArrowRight' || k === 'd' || k === 'D') keys.right = false;
    };

    blurHandler = () => {
      keys.left = false;
      keys.right = false;
      if (mode === 'playing') togglePause();
    };

    window.addEventListener('keydown', keyHandler);
    window.addEventListener('keyup', keyUpHandler);
    window.addEventListener('blur', blurHandler);

    last = performance.now();
    raf = requestAnimationFrame(loop);
  }

  function destroy() {
    cancelAnimationFrame(raf);
    if (keyHandler) window.removeEventListener('keydown', keyHandler);
    if (keyUpHandler) window.removeEventListener('keyup', keyUpHandler);
    if (blurHandler) window.removeEventListener('blur', blurHandler);
    if (moveHandler && canvas) {
      canvas.removeEventListener('pointermove', moveHandler);
      canvas.removeEventListener('pointerdown', moveHandler);
    }
    if (touchHandler && canvas) {
      canvas.removeEventListener('touchstart', touchHandler);
      canvas.removeEventListener('touchmove', touchHandler);
    }
    if (clickHandler && canvas) canvas.removeEventListener('click', clickHandler);
    keyHandler = null;
    keyUpHandler = null;
    moveHandler = null;
    touchHandler = null;
    clickHandler = null;
    blurHandler = null;
    ctx = null;
    canvas = null;
  }

  function boot() {
    const root = document.getElementById('breakoutRoot');
    if (!root || root.dataset.booted) return;
    root.dataset.booted = '1';
    setup();
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', destroy);
  boot();
</script>
