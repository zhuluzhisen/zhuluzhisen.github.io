---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerBar from '../../components/PlayerBar.astro';
import '../../styles/games.css';

const games = [
  {
    slug: 'snake',
    name: '贪吃蛇',
    en: 'SNAKE',
    desc: '最古老也最耐玩的那条蛇。吃掉光点变长，撞墙或咬到自己就结束。',
    tag: '上手 0 秒',
    best: 'snake',
  },
  {
    slug: 'tetris',
    name: '俄罗斯方块',
    en: 'TETRIS',
    desc: '七种方块，一次消四行叫 Tetris。带幽灵落点、暂存区和连消计分。',
    tag: '会玩上瘾',
    best: 'tetris',
  },
  {
    slug: '2048',
    name: '2048',
    en: '2048',
    desc: '滑动合并相同数字，凑出 2048。看着简单，越到后面越需要规划。',
    tag: '最费脑',
    best: '2048',
  },
  {
    slug: 'breakout',
    name: '打砖块',
    en: 'BREAKOUT',
    desc: '一块挡板，一颗球，满屏的砖。清完一屏难度上一档，三条命够不够？',
    tag: '最解压',
    best: 'breakout',
  },
];
---

<BaseLayout title="游戏厅" description="森的游戏厅 · 四款用 Canvas 手写的经典小游戏，浏览器直接开玩">
  <div class="gx-page container-x">
    <header class="arc-head reveal is-visible">
      <div class="gx-head-row">
        <div>
          <p class="gx-kicker">ARCADE · 游戏厅</p>
          <h1 class="gx-title">随手玩两把</h1>
        </div>
        <PlayerBar />
      </div>
      <p class="gx-sub">
        四款经典小游戏，全部用 Canvas 从零手写，没有任何第三方游戏引擎。
        电脑上用键盘玩，手机也能上手。
      </p>
    </header>

    <div class="arc-grid">
      {
        games.map((g, i) => (
          <a class="arc-card" href={`/games/${g.slug}`} style={`--i:${i}`}>
            <div class="arc-art">
              {g.slug === 'snake' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="snk" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#22d3ee" />
                      <stop offset="100%" stop-color="#a78bfa" />
                    </linearGradient>
                  </defs>
                  <g fill="#ffffff" opacity="0.06">
                    {Array.from({ length: 6 * 9 }).map((_, k) => (
                      <circle cx={20 + (k % 9) * 17.5} cy={14 + Math.floor(k / 9) * 17} r="1.1" />
                    ))}
                  </g>
                  <path
                    d="M34 30h44a10 10 0 0 1 10 10v14a10 10 0 0 0 10 10h22"
                    fill="none"
                    stroke="url(#snk)"
                    stroke-width="13"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="34" cy="30" r="7.5" fill="#e2fbff" />
                  <circle cx="36" cy="28" r="2" fill="#04070e" />
                  <circle cx="134" cy="64" r="5" fill="#fb7185" />
                  <circle cx="134" cy="64" r="10" fill="#fb7185" opacity="0.16" />
                </svg>
              )}
              {g.slug === 'tetris' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g stroke="#04070e" stroke-width="1.5">
                    <rect x="58" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="74" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="90" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="106" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="58" y="56" width="16" height="16" rx="3" fill="#a78bfa" />
                    <rect x="74" y="56" width="16" height="16" rx="3" fill="#a78bfa" />
                    <rect x="90" y="56" width="16" height="16" rx="3" fill="#fb7185" />
                    <rect x="106" y="56" width="16" height="16" rx="3" fill="#fb7185" />
                    <rect x="74" y="40" width="16" height="16" rx="3" fill="#fbbf24" />
                    <rect x="90" y="40" width="16" height="16" rx="3" fill="#fbbf24" />
                    <rect x="106" y="40" width="16" height="16" rx="3" fill="#a3e635" />
                  </g>
                  <rect
                    x="106"
                    y="14"
                    width="16"
                    height="16"
                    rx="3"
                    fill="none"
                    stroke="#22d3ee"
                    stroke-dasharray="3 3"
                    opacity="0.7"
                  />
                  <rect x="74" y="14" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="90" y="14" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="90" y="30" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="106" y="30" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                </svg>
              )}
              {g.slug === '2048' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g font-family="ui-monospace, monospace" font-weight="700" text-anchor="middle">
                    <rect x="26" y="22" width="30" height="30" rx="7" fill="#ffffff" opacity="0.06" />
                    <rect x="60" y="22" width="30" height="30" rx="7" fill="#0e7490" />
                    <rect x="94" y="22" width="30" height="30" rx="7" fill="#0891b2" />
                    <rect x="128" y="22" width="30" height="30" rx="7" fill="#ffffff" opacity="0.06" />
                    <rect x="26" y="56" width="30" height="30" rx="7" fill="#7c3aed" />
                    <rect x="60" y="56" width="30" height="30" rx="7" fill="#8b5cf6" />
                    <rect x="94" y="56" width="30" height="30" rx="7" fill="#db2777" />
                    <rect x="128" y="56" width="30" height="30" rx="7" fill="#f59e0b" />
                    <text x="75" y="42" font-size="13" fill="#d8f6ff">4</text>
                    <text x="109" y="42" font-size="13" fill="#eafbff">8</text>
                    <text x="41" y="76" font-size="13" fill="#eae4ff">16</text>
                    <text x="75" y="76" font-size="13" fill="#f6efff">32</text>
                    <text x="109" y="76" font-size="12" fill="#ffe9f1">64</text>
                    <text x="143" y="76" font-size="11" fill="#fff6e0">128</text>
                  </g>
                </svg>
              )}
              {g.slug === 'breakout' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g>
                    {['#fb7185', '#a78bfa', '#22d3ee'].map((color, row) => (
                      <g fill={color} opacity={1 - row * 0.12}>
                        {Array.from({ length: 7 }).map((_, k) => (
                          <rect
                            x={18 + k * 21}
                            y={16 + row * 11}
                            width="18"
                            height="8"
                            rx="2.5"
                          />
                        ))}
                      </g>
                    ))}
                  </g>
                  <rect x="68" y="88" width="44" height="7" rx="3.5" fill="#e2fbff" />
                  <circle cx="96" cy="62" r="4" fill="#fff" />
                  <circle cx="96" cy="62" r="9" fill="#22d3ee" opacity="0.18" />
                  <path
                    d="M96 66l-10 22"
                    stroke="#22d3ee"
                    stroke-width="1.5"
                    stroke-dasharray="3 4"
                    opacity="0.5"
                  />
                </svg>
              )}
              <span class="arc-badge">{g.tag}</span>
            </div>
            <div class="arc-body">
              <div class="arc-title-row">
                <h2 class="arc-name">{g.name}</h2>
                <span class="arc-en">{g.en}</span>
              </div>
              <p class="arc-desc">{g.desc}</p>
              <div class="arc-foot">
                <span class="arc-best">
                  最高 <b data-best={g.best}>—</b>
                </span>
                <span class="arc-go">
                  开始 <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <section class="arc-stats reveal" id="arcStats">
      <div class="arc-stats-head">
        <h2 class="arc-stats-title">我的战绩</h2>
        <span class="arc-stats-who" id="arcStatsWho">游客模式 · 明文存在本机</span>
      </div>
      <div class="arc-rows" id="arcRows"></div>
      <p class="arc-stats-foot">
        <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
        建立档案后，记录会加密保存在这台设备；换设备请用「导出 / 导入」带走。
      </p>
    </section>

    <p class="arc-tip reveal">
      <i class="ri-information-line" aria-hidden="true"></i>
      战绩存在浏览器本地，换设备不会同步。手机建议横屏或放大页面玩。
    </p>
  </div>
</BaseLayout>

<style>
  .arc-head {
    margin-bottom: 2.2rem;
  }

  .arc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .arc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-ink-2) 78%, transparent);
    border: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      box-shadow 0.45s ease;
  }

  .arc-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in oklab, var(--color-cyan) 38%, transparent);
    box-shadow: 0 34px 70px -42px color-mix(in oklab, var(--color-cyan) 90%, transparent);
  }

  .arc-art {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0.6rem 0 0.2rem;
    background:
      radial-gradient(circle at 50% 0%, rgba(34, 211, 238, 0.12), transparent 62%),
      #060810;
    border-bottom: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
  }

  .arc-art svg {
    width: 100%;
    height: auto;
    max-width: 232px;
    display: block;
  }

  .arc-badge {
    position: absolute;
    top: 0.7rem;
    left: 0.75rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: #9fb2cc;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .arc-body {
    padding: 1rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .arc-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .arc-name {
    margin: 0;
    font-size: 1.08rem;
    font-family: var(--font-display);
  }

  .arc-en {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--color-fog);
  }

  .arc-desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--color-fog);
    flex: 1;
  }

  .arc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.35rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
  }

  .arc-best {
    font-size: 0.72rem;
    color: var(--color-fog);
    font-family: var(--font-mono);
  }

  .arc-best b {
    color: var(--color-mist);
    font-weight: 700;
  }

  .arc-go {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-cyan);
    opacity: 0.85;
    transition: gap 0.3s ease;
  }

  .arc-card:hover .arc-go {
    gap: 0.55rem;
  }

  .arc-tip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 1.8rem 0 0;
    font-size: 0.76rem;
    color: var(--color-fog);
  }

  .arc-tip i {
    color: var(--color-cyan);
    opacity: 0.8;
  }

  /* ---------- 我的战绩 ---------- */
  .arc-stats {
    margin-top: 1.5rem;
    padding: 1.2rem 1.25rem 1rem;
    border-radius: 20px;
    background: color-mix(in oklab, var(--color-ink-2) 74%, transparent);
    border: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
  }

  .arc-stats-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.85rem;
  }

  .arc-stats-title {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-display);
  }

  .arc-stats-who {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--color-fog);
  }

  .arc-rows {
    display: grid;
    gap: 0.3rem;
  }

  .arc-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.8fr 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.65rem;
    border-radius: 10px;
    font-size: 0.78rem;
    color: var(--color-mist);
    background: color-mix(in oklab, #ffffff 3%, transparent);
  }

  .arc-row--head {
    background: transparent;
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    padding-bottom: 0.1rem;
  }

  .arc-row b {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: #fff;
    font-weight: 700;
  }

  .arc-row span:nth-child(n + 2) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .arc-stats-foot {
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in oklab, #ffffff 6%, transparent);
    font-size: 0.7rem;
    line-height: 1.7;
    color: var(--color-fog);
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .arc-stats-foot i {
    color: var(--color-cyan);
    margin-top: 0.12rem;
  }

  @media (max-width: 640px) {
    .arc-row {
      grid-template-columns: 1.2fr 1fr 0.9fr;
    }
    .arc-row span:nth-child(4) {
      display: none;
    }
    .arc-row--head span:nth-child(4) {
      display: none;
    }
  }

  @media (max-width: 780px) {
    .arc-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(:root[data-theme='light']) .arc-card {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(11, 16, 32, 0.08);
  }

  :global(:root[data-theme='light']) .arc-stats {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(11, 16, 32, 0.08);
  }

  :global(:root[data-theme='light']) .arc-row {
    color: #3b4356;
    background: rgba(11, 16, 32, 0.03);
  }

  :global(:root[data-theme='light']) .arc-row b {
    color: #10131d;
  }
</style>

<script>
  import { store, readStat } from '../../lib/save-store';

  const LIST = [
    { slug: 'snake', name: '贪吃蛇' },
    { slug: 'tetris', name: '俄罗斯方块' },
    { slug: '2048', name: '2048' },
    { slug: 'breakout', name: '打砖块' },
  ];

  const nf = (n: number) => (n ? n.toLocaleString('en-US') : '—');

  function fmtDate(ts?: number) {
    if (!ts) return '—';
    const d = new Date(ts);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  async function refresh() {
    // 卡片上的最高分
    for (const g of LIST) {
      const rec = await readStat(g.slug);
      const el = document.querySelector<HTMLElement>(`[data-best="${g.slug}"]`);
      if (el) el.textContent = nf(rec.best || 0);
    }

    // 战绩表
    const rows = document.getElementById('arcRows');
    const who = document.getElementById('arcStatsWho');
    if (!rows) return;

    if (who) {
      who.textContent =
        store.state === 'unlocked'
          ? `档案 · ${store.profileName || '我的档案'}（已加密）`
          : store.state === 'locked'
            ? '档案已锁定 · 显示游客记录'
            : '游客模式 · 明文存在本机';
    }

    const head = `
      <div class="arc-row arc-row--head">
        <span>游戏</span><span>最高分</span><span>局数</span><span>最近一局</span>
      </div>`;

    const body: string[] = [];
    let totalPlays = 0;
    for (const g of LIST) {
      const rec = await readStat(g.slug);
      totalPlays += rec.plays || 0;
      body.push(`
        <div class="arc-row">
          <span>${g.name}</span>
          <b>${nf(rec.best || 0)}</b>
          <span>${rec.plays ? rec.plays + ' 局' : '—'}</span>
          <span>${rec.at ? `${nf(rec.last || 0)} · ${fmtDate(rec.at)}` : '—'}</span>
        </div>`);
    }

    rows.innerHTML =
      head +
      body.join('') +
      `<div class="arc-row arc-row--head" style="padding-top:.45rem">
         <span>合计</span><span>—</span><span>${totalPlays} 局</span><span>—</span>
       </div>`;
  }

  document.addEventListener('astro:page-load', refresh);
  window.addEventListener('save:change', () => void refresh());
  void refresh();
</script>
