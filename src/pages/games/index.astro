---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerBar from '../../components/PlayerBar.astro';
import '../../styles/games.css';

const games = [
  {
    slug: 'snake',
    name: '贪吃蛇',
    en: 'SNAKE',
    desc: '最古老也最耐玩的那条蛇。吃掉光点变长，撞墙或咬到自己就结束。',
    tag: '上手 0 秒',
    best: 'snake',
  },
  {
    slug: 'tetris',
    name: '俄罗斯方块',
    en: 'TETRIS',
    desc: '七种方块，一次消四行叫 Tetris。带幽灵落点、暂存区和连消计分。',
    tag: '会玩上瘾',
    best: 'tetris',
  },
  {
    slug: '2048',
    name: '2048',
    en: '2048',
    desc: '滑动合并相同数字，凑出 2048。看着简单，越到后面越需要规划。',
    tag: '最费脑',
    best: '2048',
  },
  {
    slug: 'breakout',
    name: '打砖块',
    en: 'BREAKOUT',
    desc: '一块挡板，一颗球，满屏的砖。清完一屏难度上一档，三条命够不够？',
    tag: '最解压',
    best: 'breakout',
  },
  {
    slug: 'zombie',
    name: '残响',
    en: 'ECHOES',
    desc: '像素丧尸生存 RPG。线性叙事第一章，实时挥砍，从一张空病床走到街道尽头。',
    tag: '动作 RPG',
    best: 'zombie',
  },
  {
    slug: 'jingbian',
    name: '惊变一百天 · 隔离',
    en: '100 DAYS',
    desc: '像素生存叙事。2026年10月24日，销售员方旭从起床到回家的一天——暴露度满格，比被咬更致命。',
    tag: '叙事生存',
    best: 'jingbian',
  },
  {
    slug: 'omen',
    name: '签 · OMEN',
    en: 'OMEN',
    desc: '抽签问卦的卡牌 Roguelike。十五层分支，每层选一条路；卦力有限，越往后越要看清敌人下一步。',
    tag: '最大一局',
    best: 'omen',
  },
  {
    slug: 'meow',
    name: '喵星防线',
    en: 'MEOW TD',
    desc: '猫猫塔防。霓虹气球一层套一层来偷鱼干，五种猫猫各有两条升级路线，守住三十波和鼠王飞艇。',
    tag: '塔防',
    best: 'meow',
  },
];
---

<BaseLayout title="游戏厅" description="森的游戏厅 · 八款浏览器直接开玩的小游戏，含一款卡牌 Roguelike 和一款塔防">
  <div class="gx-page container-x">
    <header class="arc-head reveal is-visible">
      <div class="gx-head-row">
        <div>
          <p class="gx-kicker">ARCADE · 游戏厅</p>
          <h1 class="gx-title">随手玩两把</h1>
        </div>
        <PlayerBar />
      </div>
      <p class="gx-sub">
        八款游戏：六款是 Canvas 从零手写，卡牌那款用 DOM 画牌面，塔防那款用 PixiJS（WebGL）渲染。
        电脑上用键盘玩，手机也能上手。
      </p>
    </header>

    <div class="arc-grid">
      {
        games.map((g, i) => (
          <a class="arc-card" href={`/games/${g.slug}`} style={`--i:${i}`}>
            <div class="arc-art">
              {g.slug === 'snake' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="snk" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#22d3ee" />
                      <stop offset="100%" stop-color="#a78bfa" />
                    </linearGradient>
                  </defs>
                  <g fill="#ffffff" opacity="0.06">
                    {Array.from({ length: 6 * 9 }).map((_, k) => (
                      <circle cx={20 + (k % 9) * 17.5} cy={14 + Math.floor(k / 9) * 17} r="1.1" />
                    ))}
                  </g>
                  <path
                    d="M34 30h44a10 10 0 0 1 10 10v14a10 10 0 0 0 10 10h22"
                    fill="none"
                    stroke="url(#snk)"
                    stroke-width="13"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="34" cy="30" r="7.5" fill="#e2fbff" />
                  <circle cx="36" cy="28" r="2" fill="#04070e" />
                  <circle cx="134" cy="64" r="5" fill="#fb7185" />
                  <circle cx="134" cy="64" r="10" fill="#fb7185" opacity="0.16" />
                </svg>
              )}
              {g.slug === 'tetris' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g stroke="#04070e" stroke-width="1.5">
                    <rect x="58" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="74" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="90" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="106" y="72" width="16" height="16" rx="3" fill="#22d3ee" />
                    <rect x="58" y="56" width="16" height="16" rx="3" fill="#a78bfa" />
                    <rect x="74" y="56" width="16" height="16" rx="3" fill="#a78bfa" />
                    <rect x="90" y="56" width="16" height="16" rx="3" fill="#fb7185" />
                    <rect x="106" y="56" width="16" height="16" rx="3" fill="#fb7185" />
                    <rect x="74" y="40" width="16" height="16" rx="3" fill="#fbbf24" />
                    <rect x="90" y="40" width="16" height="16" rx="3" fill="#fbbf24" />
                    <rect x="106" y="40" width="16" height="16" rx="3" fill="#a3e635" />
                  </g>
                  <rect
                    x="106"
                    y="14"
                    width="16"
                    height="16"
                    rx="3"
                    fill="none"
                    stroke="#22d3ee"
                    stroke-dasharray="3 3"
                    opacity="0.7"
                  />
                  <rect x="74" y="14" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="90" y="14" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="90" y="30" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                  <rect x="106" y="30" width="16" height="16" rx="3" fill="#fb7185" opacity="0.9" />
                </svg>
              )}
              {g.slug === '2048' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g font-family="ui-monospace, monospace" font-weight="700" text-anchor="middle">
                    <rect x="26" y="22" width="30" height="30" rx="7" fill="#ffffff" opacity="0.06" />
                    <rect x="60" y="22" width="30" height="30" rx="7" fill="#0e7490" />
                    <rect x="94" y="22" width="30" height="30" rx="7" fill="#0891b2" />
                    <rect x="128" y="22" width="30" height="30" rx="7" fill="#ffffff" opacity="0.06" />
                    <rect x="26" y="56" width="30" height="30" rx="7" fill="#7c3aed" />
                    <rect x="60" y="56" width="30" height="30" rx="7" fill="#8b5cf6" />
                    <rect x="94" y="56" width="30" height="30" rx="7" fill="#db2777" />
                    <rect x="128" y="56" width="30" height="30" rx="7" fill="#f59e0b" />
                    <text x="75" y="42" font-size="13" fill="#d8f6ff">4</text>
                    <text x="109" y="42" font-size="13" fill="#eafbff">8</text>
                    <text x="41" y="76" font-size="13" fill="#eae4ff">16</text>
                    <text x="75" y="76" font-size="13" fill="#f6efff">32</text>
                    <text x="109" y="76" font-size="12" fill="#ffe9f1">64</text>
                    <text x="143" y="76" font-size="11" fill="#fff6e0">128</text>
                  </g>
                </svg>
              )}
              {g.slug === 'breakout' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <g>
                    {['#fb7185', '#a78bfa', '#22d3ee'].map((color, row) => (
                      <g fill={color} opacity={1 - row * 0.12}>
                        {Array.from({ length: 7 }).map((_, k) => (
                          <rect
                            x={18 + k * 21}
                            y={16 + row * 11}
                            width="18"
                            height="8"
                            rx="2.5"
                          />
                        ))}
                      </g>
                    ))}
                  </g>
                  <rect x="68" y="88" width="44" height="7" rx="3.5" fill="#e2fbff" />
                  <circle cx="96" cy="62" r="4" fill="#fff" />
                  <circle cx="96" cy="62" r="9" fill="#22d3ee" opacity="0.18" />
                  <path
                    d="M96 66l-10 22"
                    stroke="#22d3ee"
                    stroke-width="1.5"
                    stroke-dasharray="3 4"
                    opacity="0.5"
                  />
                </svg>
              )}
              {g.slug === 'zombie' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="zmbg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#1a0d12" />
                      <stop offset="100%" stop-color="#0a0c12" />
                    </linearGradient>
                  </defs>
                  <rect width="180" height="108" fill="url(#zmbg)" />
                  {/* 血月 */}
                  <circle cx="140" cy="34" r="26" fill="#7f1d1d" opacity="0.22" />
                  <circle cx="140" cy="34" r="13" fill="#ef4444" opacity="0.45" />
                  {/* 远景楼群 */}
                  <g fill="#141821">
                    <rect x="0" y="72" width="26" height="36" />
                    <rect x="30" y="64" width="20" height="44" />
                    <rect x="122" y="70" width="22" height="38" />
                    <rect x="150" y="60" width="30" height="48" />
                  </g>
                  <g fill="#ef4444" opacity="0.3">
                    <rect x="7" y="80" width="4" height="4" />
                    <rect x="16" y="92" width="4" height="4" />
                    <rect x="158" y="70" width="4" height="4" />
                    <rect x="168" y="88" width="4" height="4" />
                  </g>
                  {/* 地面 */}
                  <rect x="0" y="96" width="180" height="12" fill="#0c0f16" />
                  <rect x="0" y="96" width="180" height="1" fill="#ef4444" opacity="0.2" />
                  {/* 像素丧尸 */}
                  <g fill="#5c2f3a">
                    <rect x="54" y="46" width="34" height="34" />
                    <rect x="60" y="80" width="10" height="16" />
                    <rect x="72" y="80" width="10" height="16" />
                  </g>
                  <g fill="#7ba763">
                    <rect x="58" y="24" width="24" height="22" />
                    <rect x="88" y="52" width="22" height="8" />
                    <rect x="88" y="52" width="8" height="18" />
                  </g>
                  <g fill="#ff5a4a">
                    <rect x="63" y="31" width="5" height="4" />
                    <rect x="72" y="31" width="5" height="4" />
                  </g>
                  <rect x="64" y="40" width="12" height="3" fill="#2a1a1e" />
                  {/* 破口 */}
                  <rect x="62" y="58" width="8" height="8" fill="#3d1a22" />
                  {/* 像素噪点 */}
                  <g fill="#ffffff" opacity="0.04">
                    {Array.from({ length: 8 * 5 }).map((_, k) => (
                      <rect x={10 + (k % 8) * 21} y={16 + Math.floor(k / 8) * 17} width="2" height="2" />
                    ))}
                  </g>
                </svg>
              )}
              {g.slug === 'jingbian' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="jbbg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#141b2a" />
                      <stop offset="100%" stop-color="#080a10" />
                    </linearGradient>
                  </defs>
                  <rect width="180" height="108" fill="url(#jbbg)" />
                  {/* 晨雾 */}
                  <circle cx="150" cy="62" r="30" fill="#22d3ee" opacity="0.07" />
                  {/* 远景楼群 */}
                  <g fill="#111621">
                    <rect x="0" y="52" width="22" height="40" />
                    <rect x="24" y="44" width="16" height="48" />
                    <rect x="140" y="48" width="18" height="44" />
                    <rect x="160" y="56" width="20" height="36" />
                  </g>
                  <g fill="#f59e0b" opacity="0.28">
                    <rect x="6" y="58" width="3" height="3" />
                    <rect x="29" y="52" width="3" height="3" />
                    <rect x="33" y="66" width="3" height="3" />
                    <rect x="147" y="56" width="3" height="3" />
                    <rect x="166" y="64" width="3" height="3" />
                  </g>
                  {/* 地面 */}
                  <rect x="0" y="86" width="180" height="22" fill="#0b0e15" />
                  <rect x="0" y="86" width="180" height="1" fill="#22d3ee" opacity="0.16" />
                  <g fill="#e2e8f0" opacity="0.18">
                    <rect x="8" y="104" width="10" height="2" />
                    <rect x="30" y="104" width="10" height="2" />
                    <rect x="52" y="104" width="10" height="2" />
                  </g>
                  {/* 公交站牌 */}
                  <g>
                    <rect x="24" y="60" width="2" height="28" fill="#39445c" />
                    <rect x="18" y="54" width="18" height="11" rx="2" fill="#1c2432" stroke="#39445c" stroke-width="1" />
                    <rect x="21" y="57" width="9" height="2" fill="#22d3ee" opacity="0.6" />
                    <rect x="21" y="61" width="12" height="1.5" fill="#e2e8f0" opacity="0.28" />
                  </g>
                  {/* 像素人：西装 + 口罩 + 公文包 */}
                  <g fill="#31405c">
                    <rect x="58" y="62" width="16" height="20" />
                  </g>
                  <g fill="#1e2430">
                    <rect x="60" y="82" width="5" height="10" />
                    <rect x="67" y="82" width="5" height="10" />
                  </g>
                  <g fill="#dfe6f2">
                    <rect x="63" y="63" width="6" height="7" />
                  </g>
                  <rect x="65" y="67" width="2" height="8" fill="#7f1d2b" />
                  <g fill="#e8c9a4">
                    <rect x="61" y="48" width="10" height="12" />
                  </g>
                  <rect x="61" y="46" width="10" height="3" fill="#20242e" />
                  <rect x="61" y="56" width="10" height="4" fill="#eef2f8" />
                  <rect x="60" y="57" width="1.5" height="2" fill="#9fb0c6" />
                  <rect x="70" y="57" width="1.5" height="2" fill="#9fb0c6" />
                  <rect x="63" y="53" width="2" height="1.5" fill="#2b3342" />
                  <rect x="67" y="53" width="2" height="1.5" fill="#2b3342" />
                  <rect x="74" y="70" width="9" height="8" rx="1" fill="#6b4a2a" />
                  <rect x="74" y="70" width="9" height="2" fill="#8a6239" />
                  {/* 咳嗽者：红眼 */}
                  <g fill="#3b4a63">
                    <rect x="104" y="64" width="13" height="16" />
                  </g>
                  <g fill="#22293a">
                    <rect x="106" y="80" width="4" height="9" />
                    <rect x="112" y="80" width="4" height="9" />
                  </g>
                  <rect x="107" y="52" width="9" height="11" fill="#d8b18c" />
                  <rect x="105" y="49" width="13" height="4" fill="#2f6fb5" />
                  <rect x="107" y="57" width="2" height="2" fill="#e04b3c" />
                  <rect x="114" y="57" width="2" height="2" fill="#e04b3c" />
                  {/* 上方红色曲线 */}
                  <path d="M120 30 L132 26 L142 18 L152 20 L164 9" stroke="#ef4444" stroke-width="2" fill="none" opacity="0.7" />
                  <circle cx="164" cy="9" r="2.5" fill="#ef4444" opacity="0.9" />
                  <text x="120" y="40" font-family="ui-monospace, monospace" font-size="5" fill="#ef4444" opacity="0.55">
                    +47%
                  </text>
                  {/* 噪点 */}
                  <g fill="#ffffff" opacity="0.035">
                    {Array.from({ length: 8 * 5 }).map((_, k) => (
                      <rect x={10 + (k % 8) * 21} y={16 + Math.floor(k / 8) * 17} width="2" height="2" />
                    ))}
                  </g>
                </svg>
              )}
              {g.slug === 'omen' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="ombg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#151b2c" />
                      <stop offset="100%" stop-color="#080a10" />
                    </linearGradient>
                  </defs>
                  <rect width="180" height="108" fill="url(#ombg)" />
                  <circle cx="90" cy="54" r="38" fill="#22d3ee" opacity="0.06" />
                  <g>
                    <rect
                      x="38"
                      y="32"
                      width="34"
                      height="50"
                      rx="5"
                      fill="#101827"
                      stroke="#22d3ee"
                      stroke-width="1"
                      opacity="0.85"
                      transform="rotate(-11 55 57)"
                    />
                    <rect
                      x="107"
                      y="32"
                      width="34"
                      height="50"
                      rx="5"
                      fill="#101827"
                      stroke="#fb7185"
                      stroke-width="1"
                      opacity="0.85"
                      transform="rotate(11 124 57)"
                    />
                    <rect
                      x="72"
                      y="26"
                      width="36"
                      height="56"
                      rx="5"
                      fill="#18243c"
                      stroke="#a78bfa"
                      stroke-width="1.2"
                    />
                  </g>
                  <text
                    x="90"
                    y="62"
                    text-anchor="middle"
                    font-family="ui-monospace, monospace"
                    font-size="21"
                    fill="#e2fbff"
                  >
                    ☰
                  </text>
                  <text
                    x="90"
                    y="76"
                    text-anchor="middle"
                    font-family="ui-monospace, monospace"
                    font-size="7"
                    letter-spacing="1.5"
                    fill="#22d3ee"
                    opacity="0.65"
                  >
                    卦力 3
                  </text>
                  <g fill="#ffffff" opacity="0.035">
                    {Array.from({ length: 8 * 5 }).map((_, k) => (
                      <rect
                        x={10 + (k % 8) * 21}
                        y={16 + Math.floor(k / 8) * 17}
                        width="2"
                        height="2"
                      />
                    ))}
                  </g>
                </svg>
              )}
              {g.slug === 'meow' && (
                <svg viewBox="0 0 180 108" aria-hidden="true">
                  <defs>
                    <linearGradient id="mwbg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#0b1020" />
                      <stop offset="100%" stop-color="#05070e" />
                    </linearGradient>
                  </defs>
                  <rect width="180" height="108" fill="url(#mwbg)" />
                  <path
                    d="M-4 26H62V78H122V40H184"
                    fill="none"
                    stroke="#22d3ee"
                    stroke-width="15"
                    stroke-linejoin="round"
                    opacity="0.28"
                  />
                  <path d="M-4 26H62V78H122V40H184" fill="none" stroke="#0c1322" stroke-width="11" stroke-linejoin="round" />
                  <path
                    d="M-4 26H62V78H122V40H184"
                    fill="none"
                    stroke="#22d3ee"
                    stroke-width="1"
                    stroke-dasharray="2 8"
                    opacity="0.5"
                  />
                  {[
                    [22, 26, '#fb7185'],
                    [40, 26, '#38bdf8'],
                    [62, 50, '#a3e635'],
                    [92, 78, '#fbbf24'],
                    [122, 58, '#f472b6'],
                  ].map(([x, y, c]) => (
                    <g>
                      <circle cx={x} cy={y} r="8" fill={c as string} opacity="0.18" />
                      <ellipse cx={x} cy={y} rx="4.6" ry="5.4" fill={c as string} />
                      <ellipse cx={(x as number) - 1.6} cy={(y as number) - 2} rx="1" ry="1.5" fill="#fff" opacity="0.6" />
                    </g>
                  ))}
                  <g transform="translate(92 44)">
                    <circle r="15" fill="#22d3ee" opacity="0.1" />
                    <path d="M-10 -3L-10 -15L-3 -9Z M10 -3L10 -15L3 -9Z" fill="#121828" stroke="#22d3ee" stroke-width="1.2" />
                    <circle r="10" fill="#121828" stroke="#22d3ee" stroke-width="1.4" />
                    <ellipse cx="-4" cy="-1" rx="1.8" ry="2.6" fill="#22d3ee" />
                    <ellipse cx="4" cy="-1" rx="1.8" ry="2.6" fill="#22d3ee" />
                    <path d="M-1.2 3H1.2L0 4.4Z" fill="#fb7185" />
                  </g>
                  <path d="M104 50L118 56" stroke="#a5f3fc" stroke-width="2" stroke-linecap="round" />
                  <g transform="translate(160 38)">
                    <circle r="13" fill="#fbbf24" opacity="0.08" />
                    <path d="M-10 -2L0 -11L10 -2V10H-10Z" fill="#141826" stroke="#fbbf24" stroke-width="1.2" />
                    <ellipse cx="-1" cy="3" rx="4.5" ry="2.6" fill="#fbbf24" />
                    <path d="M3 3L7 0V6Z" fill="#fbbf24" />
                  </g>
                </svg>
              )}
              <span class="arc-badge">{g.tag}</span>
            </div>
            <div class="arc-body">
              <div class="arc-title-row">
                <h2 class="arc-name">{g.name}</h2>
                <span class="arc-en">{g.en}</span>
              </div>
              <p class="arc-desc">{g.desc}</p>
              <div class="arc-foot">
                <span class="arc-best">
                  最高 <b data-best={g.best}>—</b>
                </span>
                <span class="arc-go">
                  开始 <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <section class="arc-stats reveal" id="arcStats">
      <div class="arc-stats-head">
        <h2 class="arc-stats-title">我的战绩</h2>
        <span class="arc-stats-who" id="arcStatsWho">游客模式 · 明文存在本机</span>
      </div>
      <div class="arc-rows" id="arcRows"></div>
      <p class="arc-stats-foot">
        <i class="ri-shield-keyhole-line" aria-hidden="true"></i>
        建立档案后，记录会加密保存在这台设备；换设备请用「导出 / 导入」带走。
      </p>
    </section>

    <p class="arc-tip reveal">
      <i class="ri-information-line" aria-hidden="true"></i>
      战绩存在浏览器本地，换设备不会同步。手机建议横屏或放大页面玩。
    </p>
  </div>
</BaseLayout>

