  /* ---------------- 工具 ---------------- */
  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

  function hash(x: number, y: number) {
    let n = x * 374761393 + y * 668265263;
    n = (n ^ (n >> 13)) * 1274126177;
    return ((n ^ (n >> 16)) >>> 0) / 4294967295;
  }

  function isSolid(tx: number, ty: number) {
    if (ty < 0 || ty >= mapH || tx < 0 || tx >= mapW) return true;
    const c = grid[ty][tx];
    return c === '#' || c === '~' || c === 'T' || c === 'C' || c === 'S' || c === 'K' || c === 'B' || c === 'A';
  }

  function collides(x: number, y: number, w: number, h: number) {
    const x0 = Math.floor((x - w / 2) / TS);
    const x1 = Math.floor((x + w / 2 - 0.01) / TS);
    const y0 = Math.floor((y - h) / TS);
    const y1 = Math.floor((y - 0.01) / TS);
    for (let ty = y0; ty <= y1; ty++) {
      for (let tx = x0; tx <= x1; tx++) {
        if (isSolid(tx, ty)) return true;
      }
    }
    return false;
  }

  /* ---------------- 音效 ---------------- */
  let ac: AudioContext | null = null;
  let noiseBuf: AudioBuffer | null = null;

  function initAudio() {
    if (ac) return;
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      ac = new AC();
      const len = Math.floor(ac!.sampleRate * 0.4);
      noiseBuf = ac!.createBuffer(1, len, ac!.sampleRate);
      const d = noiseBuf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    } catch {
      ac = null;
    }
  }

  function sfx(kind: 'swing' | 'hit' | 'hurt' | 'die' | 'pick') {
    if (!ac || !noiseBuf) return;
    const t = ac.currentTime;
    const src = ac.createBufferSource();
    src.buffer = noiseBuf;
    const g = ac.createGain();
    const f = ac.createBiquadFilter();
    f.type = 'bandpass';

    if (kind === 'swing') {
      f.frequency.setValueAtTime(1500, t);
      f.frequency.exponentialRampToValueAtTime(600, t + 0.1);
      g.gain.setValueAtTime(0.09, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.11);
      src.connect(f).connect(g).connect(ac.destination);
      src.start(t);
      src.stop(t + 0.12);
    } else if (kind === 'hit') {
      f.frequency.setValueAtTime(380, t);
      f.frequency.exponentialRampToValueAtTime(140, t + 0.09);
      g.gain.setValueAtTime(0.15, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
      src.connect(f).connect(g).connect(ac.destination);
      src.start(t);
      src.stop(t + 0.13);
    } else if (kind === 'hurt') {
      f.type = 'lowpass';
      f.frequency.setValueAtTime(700, t);
      g.gain.setValueAtTime(0.2, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.26);
      src.connect(f).connect(g).connect(ac.destination);
      src.start(t);
      src.stop(t + 0.27);
    } else if (kind === 'pick') {
      f.type = 'highpass';
      f.frequency.setValueAtTime(1800, t);
      g.gain.setValueAtTime(0.07, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
      src.connect(f).connect(g).connect(ac.destination);
      src.start(t);
      src.stop(t + 0.11);
    } else {
      f.type = 'lowpass';
      f.frequency.setValueAtTime(320, t);
      f.frequency.exponentialRampToValueAtTime(90, t + 0.3);
      g.gain.setValueAtTime(0.17, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.32);
      src.connect(f).connect(g).connect(ac.destination);
      src.start(t);
      src.stop(t + 0.33);
    }
  }

  /* ---------------- 场景美术 ---------------- */
  /* 三套配色：室内 / 街道 / 车厢。地面比墙面暗一档，但不能暗成一片黑 */
  const PAL = {
    indoor: { floor: '#242c3b', wall: '#3e4a64', wallTop: '#54627e', wallBot: '#2b3346' },
    street: { floor: '#2a3040', wall: '#3a4a34', wallTop: '#516445', wallBot: '#232d1f' },
    bus: { floor: '#20252f', wall: '#39424f', wallTop: '#4d5867', wallBot: '#232a35' },
  } as const;

  function buildSceneArt() {
    const c = document.createElement('canvas');
    c.width = mapW * TS;
    c.height = mapH * TS;
    const g = c.getContext('2d')!;
    g.imageSmoothingEnabled = false;
    const pal = PAL[skin];

    for (let ty = 0; ty < mapH; ty++) {
      for (let tx = 0; tx < mapW; tx++) {
        const ch = grid[ty][tx];
        const px = tx * TS;
        const py = ty * TS;
        const r = hash(tx, ty);
        const solid = '#+TKSBA'.includes(ch);

        if (solid) {
          g.fillStyle = pal.floor;
          g.fillRect(px, py, TS, TS);
        } else if (ch === '_' || ch === '=') {
          // 柏油/水泥：比室内地砖更平，靠细碎颗粒和偶尔的裂缝出质感
          g.fillStyle = pal.floor;
          g.fillRect(px, py, TS, TS);
          if (r > 0.62) {
            g.fillStyle = 'rgba(255,255,255,0.05)';
            g.fillRect(px + 2 + Math.floor(r * 10), py + 3 + Math.floor(r * 9), 1, 1);
          }
          if (r < 0.06) {
            g.fillStyle = 'rgba(0,0,0,0.16)';
            g.fillRect(px + 3, py + 6, 6, 1);
            g.fillRect(px + 8, py + 7, 3, 1);
          }
        } else {
          g.fillStyle = pal.floor;
          g.fillRect(px, py, TS, TS);
          g.fillStyle = 'rgba(0,0,0,0.18)';
          if (tx % 2 === 0) g.fillRect(px, py, 1, TS);
          if (ty % 2 === 0) g.fillRect(px, py, TS, 1);
          const r2 = hash(tx * 3 + 1, ty * 7 + 5);
          if (r2 > 0.94) {
            g.fillStyle = 'rgba(255,255,255,0.045)';
            g.fillRect(px + 4 + Math.floor(r2 * 7), py + 5 + Math.floor(r2 * 5), 2, 1);
          } else if (r2 < 0.07) {
            g.fillStyle = 'rgba(0,0,0,0.18)';
            g.fillRect(px + 4, py + 8, 5, 3);
          }
        }

        if (ch === '#' || ch === '+') {
          g.fillStyle = pal.wall;
          g.fillRect(px, py, TS, TS);
          g.fillStyle = pal.wallTop;
          g.fillRect(px, py, TS, 5);
          g.fillStyle = pal.wallBot;
          g.fillRect(px, py + TS - 5, TS, 5);
          g.fillStyle = 'rgba(0,0,0,0.32)';
          g.fillRect(px, py, 1, TS);

          g.fillRect(px, py, TS, 1);
        }

        if (ch === '+') {
          g.fillStyle = '#2f3a4d';
          g.fillRect(px + 2, py + 2, TS - 4, TS - 4);
          g.fillStyle = '#54627e';
          g.fillRect(px + 3, py + 3, TS - 6, TS - 7);
          g.fillStyle = '#8fb6d6';
          g.fillRect(px + 4, py + 4, TS - 8, 4);
          g.fillStyle = '#d4a72c';
          g.fillRect(px + TS - 7, py + 9, 2, 2);
        }

        if (ch === 'T') {
          g.fillStyle = 'rgba(0,0,0,0.38)';
          g.fillRect(px + 2, py + TS - 4, TS - 3, 3);
          g.fillStyle = '#6b5334';
          g.fillRect(px + 1, py + 2, TS - 2, TS - 5);
          g.fillStyle = '#8a6d45';
          g.fillRect(px + 2, py + 3, TS - 4, 3);
          g.fillStyle = '#4a3a24';
          g.fillRect(px + 2, py + TS - 7, TS - 4, 2);
        }

        if (ch === 'K') {
          // 前台柜台
          g.fillStyle = 'rgba(0,0,0,0.36)';
          g.fillRect(px + 1, py + 12, 14, 3);
          g.fillStyle = '#3b465e';
          g.fillRect(px, py + 3, TS, 10);
          g.fillStyle = '#8a97b3';
          g.fillRect(px, py + 2, TS, 2);
          g.fillStyle = '#222a38';
          g.fillRect(px + 3, py + 7, 10, 1);
        }

        if (ch === 'S') {
          // 超市货架
          g.fillStyle = 'rgba(0,0,0,0.36)';
          g.fillRect(px + 1, py + 13, 14, 3);
          g.fillStyle = '#4a5568';
          g.fillRect(px + 1, py + 1, 14, 13);
          g.fillStyle = '#5d6a80';
          g.fillRect(px + 1, py + 1, 14, 2);
          for (let k = 0; k < 3; k++) {
            const c2 = ['#c2703f', '#4f8f6a', '#c9a63c', '#7a5fa8'][(tx + k + ty) % 4];
            g.fillStyle = c2;
            g.fillRect(px + 2 + k * 4, py + 4 + (k % 2) * 5, 3, 4);
          }
          g.fillStyle = 'rgba(0,0,0,0.28)';
          g.fillRect(px + 1, py + 9, 14, 1);
        }

        if (ch === 'B') {
          // 床
          g.fillStyle = 'rgba(0,0,0,0.34)';
          g.fillRect(px + 1, py + 13, 14, 3);
          g.fillStyle = '#3a4358';
          g.fillRect(px, py + 2, TS, 12);
          g.fillStyle = '#5a6883';
          g.fillRect(px + 1, py + 3, TS - 2, 8);
          g.fillStyle = '#cfd8e8';
          g.fillRect(px + 1, py + 3, 6, 4);
        }

        if (ch === 'C') {
          g.fillStyle = 'rgba(0,0,0,0.4)';
          g.fillRect(px + 1, py + 13, 14, 3);
          g.fillStyle = '#2f3a4d';
          g.fillRect(px + 1, py + 1, 14, 13);
          g.fillStyle = '#3d4b63';
          g.fillRect(px + 2, py + 1, 12, 2);
          g.fillStyle = '#12171f';
          g.fillRect(px + 3, py + 4, 10, 3);
          g.fillRect(px + 3, py + 9, 10, 3);
          g.fillStyle = '#222a38';
          g.fillRect(px + 6, py + 7, 4, 2);
        }

        if (ch === 'A') {
          // 救护车（侧视）：白车身 + 红色十字 + 车顶警灯
          g.fillStyle = 'rgba(0,0,0,0.42)';
          g.fillRect(px + 1, py + 14, TS - 2, 2);
          g.fillStyle = '#e8eef7';
          g.fillRect(px, py + 3, TS, 11);
          g.fillStyle = '#f8fbff';
          g.fillRect(px + 1, py + 2, TS - 2, 2);
          g.fillStyle = '#dc2626';
          g.fillRect(px + 3, py, 3, 2);
          g.fillStyle = '#38bdf8';
          g.fillRect(px + 6, py, 3, 2);
          g.fillStyle = '#1f2733';
          g.fillRect(px + 10, py + 5, 5, 4);
          g.fillStyle = '#dc2626';
          g.fillRect(px, py + 10, TS, 2);
          g.fillStyle = '#ef4444';
          g.fillRect(px + 4, py + 5, 4, 1);
          g.fillRect(px + 5, py + 4, 2, 3);
          g.fillStyle = '#8d99ab';
          g.fillRect(px, py + 12, TS, 1);
          g.fillStyle = '#151a22';
          g.fillRect(px + 2, py + 13, 3, 2);
          g.fillRect(px + 11, py + 13, 3, 2);
        }

        if (ch === '=') {
          g.fillStyle = 'rgba(226, 232, 240, 0.26)';
          g.fillRect(px + 7, py + 1, 2, 9);
        }

        if (ch === ',') {
          g.fillStyle = 'rgba(122, 28, 34, 0.6)';
          g.fillRect(px + 3, py + 5, 7, 4);
          g.fillStyle = 'rgba(88, 18, 24, 0.55)';
          g.fillRect(px + 1, py + 10, 4, 2);
        }
      }
    }

    sceneArt = c;
  }

  /* ---------------- 装载场景 ---------------- */
  function spawnFoe(tx: number, ty: number, kind: Kind) {
    const hp = kind === 'brute' ? 60 : kind === 'walk' ? 26 : 12;
    foes.push({
      x: tx * TS + TS / 2,
      y: ty * TS + TS - 2,
      hp,
      maxHp: hp,
      kind,
      facing: 1,
      stun: 0,
      flash: 0,
      windup: 0,
      cd: Math.random() * 0.6,
      wob: Math.random() * 6.28,
      dead: false,
      deadT: 0,
      cough: Math.random() * 2,
      wx: 0,
      wy: 0,
      wt: 0,
    });
  }

  function loadScene(id: string) {
    const def = SCENES[id];
    sceneId = id;
    skin = def.skin || 'indoor';
    const w = def.rows.reduce((m, r) => Math.max(m, r.length), 0);
    grid = def.rows.map((r) => r.padEnd(w, '#').split(''));
    mapH = grid.length;
    mapW = w;
    foes = [];
    pickups = [];
    npcs = [];
    particles = [];
    floaters = [];
    exits = [];

    let spawn = { x: TS * 1.5, y: TS * 1.5 };
    const npcKeys = def.npcs || [];
    let npcI = 0;
    const next = ORDER[ORDER.indexOf(id) + 1] || null;
    // 整张图统一用一种地砖：有露天路面的场景一律是柏油，否则是室内地砖
    const floor = def.rows.some((r) => r.includes('_')) ? '_' : '.';

    for (let ty = 0; ty < mapH; ty++) {
      for (let tx = 0; tx < mapW; tx++) {
        const ch = grid[ty][tx];
        if (ch === 'X') {
          spawn = { x: tx * TS + TS / 2, y: ty * TS + TS - 2 };
          grid[ty][tx] = floor;
        } else if (ch === 'z' || ch === 'Z' || ch === 'c') {
          spawnFoe(tx, ty, ch === 'Z' ? 'brute' : ch === 'c' ? 'cougher' : 'walk');
          grid[ty][tx] = floor;
        } else if (ch === 'm' || ch === 'd' || ch === 'w') {
          pickups.push({
            x: tx * TS + TS / 2,
            y: ty * TS + TS - 2,
            kind: ch,
            taken: false,
            bob: Math.random() * 6.28,
          });
          grid[ty][tx] = floor;
        } else if (ch === 'n') {
          npcs.push({
            x: tx * TS + TS / 2,
            y: ty * TS + TS - 2,
            key: npcKeys[npcI] || 'linju1',
            done: false,
            wob: Math.random() * 6.28,
          });
          npcI += 1;
          grid[ty][tx] = floor;
        } else if (ch === '>') {
          if (next) exits.push({ x: tx * TS + TS / 2, y: ty * TS + TS / 2, to: next });
          grid[ty][tx] = floor;
        }
      }
    }

    player.x = spawn.x;
    player.y = spawn.y;
    player.atkTime = 0;
    player.atkCd = 0;
    player.inv = 0;

    buildSceneArt();
    updateCam(true);

    if (elArea) elArea.textContent = def.name;
    if (elScene) elScene.textContent = def.name;
    if (elTime) elTime.textContent = def.clock;
    if (elClock) elClock.textContent = def.clock;
    if (elProg) elProg.textContent = `${sceneIndex + 1} / ${ORDER.length}`;
    if (elGoal) elGoal.textContent = def.goal;
    pushPhone(id);

    if (def.onEnter) openDialog(def.onEnter);
  }

  function pushPhone(id: string) {
    const msgs = PHONE[id];
    if (!msgs || !elPhoneList) return;
    const empty = elPhoneList.querySelector('.jb-phone-empty');
    if (empty) empty.remove();
    for (const m of msgs) {
      if (!m.text) continue;
      const row = document.createElement('p');
      row.className = 'jb-msg' + (m.boss ? ' is-boss' : '');
      const who = document.createElement('span');
      who.className = 'jb-msg-who';
      who.textContent = m.who + '：';
      const txt = document.createElement('span');
      txt.className = 'jb-msg-text';
      txt.textContent = m.text;
      row.append(who, txt);
      elPhoneList.append(row);
    }
    while (elPhoneList.children.length > 6) elPhoneList.firstElementChild?.remove();
  }

  function updateCam(snap = false) {
    const tx = clamp(player.x - VW / 2, 0, Math.max(0, mapW * TS - VW));
    const ty = clamp(player.y - VH / 2, 0, Math.max(0, mapH * TS - VH));
    if (snap) {
      camX = tx;
      camY = ty;
    } else {
      camX += (tx - camX) * 0.22;
      camY += (ty - camY) * 0.22;
    }
  }

  /* ---------------- 对话 ---------------- */
  function openDialog(key: string) {
    if (phase === 'clear' || phase === 'dead') return;
    const lines = STORY[key];
    if (!lines || !lines.length) return;
    dlg.lines = lines;
    dlg.i = 0;
    dlg.shown = 0;
    dlg.acc = 0;
    dlg.active = true;
    dlg.lastShown = -1;
    phase = 'dialog';
    if (elDialog) elDialog.hidden = false;
    renderDialog(true);
  }

  function renderDialog(force = false) {
    const line = dlg.lines[dlg.i];
    if (!line || !elDlgText) return;
    const total = line.text.length;
    dlg.shown = Math.min(total, dlg.shown);
    if (!force && dlg.lastShown === dlg.shown) return;
    dlg.lastShown = dlg.shown;
    elDlgText.textContent = line.text.slice(0, dlg.shown);
    if (elDlgName) elDlgName.textContent = line.who;
    if (elDialog) {
      elDialog.classList.toggle('is-narration', !line.who);
      const next = elDialog.querySelector('.jb-dialog-next') as HTMLElement | null;
      if (next) next.style.visibility = dlg.shown >= total ? 'visible' : 'hidden';
    }
  }

  function advanceDialog() {
    if (!dlg.active) return;
    const line = dlg.lines[dlg.i];
    if (!line) return closeDialog();
    if (dlg.shown < line.text.length) {
      dlg.shown = line.text.length;
      // 同步计时：否则下一帧 update 会按 acc 把 shown 覆盖回未打完的状态，
      // 表现就是「按空格没反应，要连按三四次才翻页」
      dlg.acc = line.text.length * 0.026;
      renderDialog();
      return;
    }
    dlg.i += 1;
    dlg.shown = 0;
    dlg.acc = 0;
    dlg.lastShown = -1;
    if (dlg.i >= dlg.lines.length) closeDialog();
    else renderDialog(true);
  }

  function closeDialog() {
    const key = dlg.lines === STORY.homeNight ? 'homeNight' : null;
    dlg.active = false;
    if (elDialog) elDialog.hidden = true;
    phase = 'play';
    if (key && !endingShown) {
      endingShown = true;
      finishGame();
    }
  }

  /* ---------------- 攻击 ---------------- */
  function attackBox() {
    const d = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] }[player.facing];
    const ax = player.x + d[0] * 13;
    const ay = player.y - 6 + d[1] * 13;
    return { x: ax - 11, y: ay - 11, w: 22, h: 22 };
  }

  function faceNearest() {
    let best = 30 * 30;
    let target: Foe | null = null;
    for (const z of foes) {
      if (z.dead) continue;
      const dx = z.x - player.x;
      const dy = z.y - player.y;
      const d2 = dx * dx + dy * dy;
      if (d2 < best) {
        best = d2;
        target = z;
      }
    }
    if (!target) return;
    const dx = target.x - player.x;
    const dy = target.y - player.y;
    if (Math.abs(dx) > Math.abs(dy)) player.facing = dx > 0 ? 'right' : 'left';
    else player.facing = dy > 0 ? 'down' : 'up';
  }

  function doAttack() {
    if (phase !== 'play') return;
    if (player.atkCd > 0) return;
    faceNearest();
    player.atkCd = ATTACK_CD;
    player.atkTime = ATTACK_DUR;
    player.atkHit.clear();
    sfx('swing');
  }

  function hitFoes() {
    if (player.atkTime <= 0) return;
    if (player.atkTime > ATTACK_DUR - ATTACK_LEAD) return;
    const box = attackBox();
    for (let i = 0; i < foes.length; i++) {
      const z = foes[i];
      if (z.dead || player.atkHit.has(i)) continue;
      const zx = z.x - 5;
      const zy = z.y - 12;
      if (box.x < zx + 11 && box.x + box.w > zx && box.y < zy + 13 && box.y + box.h > zy) {
        player.atkHit.add(i);
        pushFoe(z);
      }
    }
  }

  function pushFoe(z: Foe) {
    // 周凯是同事，不是怪：推三次他就靠墙坐下，不需要「打死」
    const dmg = z.kind === 'brute' ? 20 : 5 + Math.floor(Math.random() * 2);
    z.hp -= dmg;
    z.flash = 0.14;
    z.stun = z.kind === 'brute' ? 0.3 : 0.45;
    const dir = player.facing === 'left' ? -1 : player.facing === 'right' ? 1 : 0;
    const dirY = player.facing === 'up' ? -1 : player.facing === 'down' ? 1 : 0;
    const knock = z.kind === 'brute' ? 7 : 12;
    const nx = z.x + dir * knock;
    if (!collides(nx, z.y, 9, 8)) z.x = nx;
    const ny = z.y + dirY * (knock * 0.6);
    if (!collides(z.x, ny, 9, 8)) z.y = ny;

    pushes += 1;
    shake = Math.min(3, shake + 1.6);
    hitStop = 0.03;
    sfx('hit');

    for (let k = 0; k < 6; k++) {
      const a = Math.random() * 6.28;
      const sp = 26 + Math.random() * 60;
      particles.push({
        x: z.x,
        y: z.y - 8,
        vx: Math.cos(a) * sp + dir * 40,
        vy: Math.sin(a) * sp - 20,
        life: 0.24 + Math.random() * 0.24,
        max: 0.5,
        color: Math.random() > 0.5 ? '#9aa7bd' : '#cbd5e1',
        size: 1,
        grav: 240,
      });
    }

    floaters.push({ x: z.x, y: z.y - 20, text: '推开', life: 0.55, color: '#7dd3fc' });

    if (z.hp <= 0 && !z.dead) {
      z.dead = true;
      z.deadT = 0;
      sfx('die');
      shake = Math.min(4, shake + 1.2);
      if (z.kind === 'brute') openDialog('zhouDown');
    }
  }

  function hurtPlayer(dmg: number, exp: number) {
    if (player.inv > 0 || phase !== 'play') return;
    player.hp = Math.max(0, player.hp - dmg);
    player.exposure = Math.min(100, player.exposure + exp * (mask.on ? MASK_FACTOR : 0.6));
    player.inv = 0.95;
    player.hurt = 0.3;
    shake = 4.6;
    sfx('hurt');
    for (let k = 0; k < 9; k++) {
      const a = Math.random() * 6.28;
      particles.push({
        x: player.x,
        y: player.y - 8,
        vx: Math.cos(a) * 60,
        vy: Math.sin(a) * 50 - 20,
        life: 0.3 + Math.random() * 0.25,
        max: 0.55,
        color: '#b91c1c',
        size: 2,
        grav: 240,
      });
    }
    updateBars();
    if (player.hp <= 0) die();
  }

  function updateBars() {
    const hpPct = (player.hp / player.maxHp) * 100;
    if (elHpFill) elHpFill.style.width = hpPct + '%';
    if (elHpNum) elHpNum.textContent = String(Math.ceil(player.hp));
    const exPct = player.exposure;
    if (elExFill) {
      elExFill.style.width = exPct + '%';
      elExFill.style.background =
        exPct > 66
          ? 'linear-gradient(90deg,#f59e0b,#ef4444)'
          : exPct > 33
            ? 'linear-gradient(90deg,#22d3ee,#f59e0b)'
            : 'linear-gradient(90deg,#22d3ee,#38bdf8)';
    }
    if (elExNum) elExNum.textContent = String(Math.round(exPct));
    if (elMask) {
      elMask.textContent = mask.on ? `×${bag.mask} · 戴着` : `×${bag.mask}`;
      elMask.classList.toggle('is-on', mask.on);
    }
    if (elMed) elMed.textContent = `×${bag.med}`;
    if (elFood) elFood.textContent = `×${bag.food}`;
  }

  function score() {
    return (
      bag.mask * 15 +
      bag.med * 15 +
      bag.food * 12 +
      Math.ceil(player.hp) +
      Math.round(100 - player.exposure) +
      pushes * 5 +
      200
    );
  }

  function die() {
    phase = 'dead';
    recordRun('jingbian', Math.round(score() * 0.4), { level: sceneIndex + 1 }).catch(() => {});
    showOverlay(
      'YOU DIED',
      player.exposure >= 100 ? '你开始发烧了' : '你倒下了',
      player.exposure >= 100
        ? '暴露度满了。回家路上你一直在想要不要请假，现在不用想了。'
        : `撑到 ${SCENES[sceneId].clock}。这一天还没过完，你已经先躺下了。`,
      '重来',
      () => {
        resetRun();
        startRun();
      },
    );
  }

  function finishGame() {
    phase = 'clear';
    const s = score();
    recordRun('jingbian', s, { level: ORDER.length }).catch(() => {});
    showOverlay(
      'DAY 01 · CLEAR',
      '这一天过完了',
      `物资：口罩 ×${bag.mask} · 药品 ×${bag.med} · 食水 ×${bag.food}<br />
       暴露度 ${Math.round(player.exposure)} · 剩余体力 ${Math.ceil(player.hp)} · 推开 ${pushes} 次<br />
       评分 <b>${s}</b><br />
       —— 明天的安排另行通知。`,
      '再走一遍',
      () => {
        resetRun();
        startRun();
      },
    );
  }

  function showOverlay(kicker: string, title: string, desc: string, btn: string, onPress: () => void) {
    if (elKicker) elKicker.textContent = kicker;
    if (elTitle) elTitle.textContent = title;
    if (elDesc) elDesc.innerHTML = desc;
    if (elBtn) elBtn.textContent = btn;
    if (elOverlay) elOverlay.hidden = false;
    if (elHud) elHud.hidden = true;
    btnAction = onPress;
  }

  let btnAction: (() => void) | null = null;

  function resetRun() {
    player.hp = player.maxHp;
    player.exposure = 0;
    pushes = 0;
    sceneIndex = 0;
    endingShown = false;
    dlg.active = false;
    bag.mask = 1;
    bag.med = 0;
    bag.food = 0;
    mask.on = false;
    mask.t = 0;
    if (elPhoneList) elPhoneList.innerHTML = '<p class="jb-phone-empty">还没有新消息。</p>';
    updateBars();
  }

  function startRun() {
    if (elOverlay) elOverlay.hidden = true;
    if (elHud) elHud.hidden = false;
    if (elDialog) elDialog.hidden = true;
    (document.activeElement as HTMLElement | null)?.blur?.();
    sceneIndex = 0;
    phase = 'play';
    loadScene('home');
    updateBars();
  }

  function toggleMask() {
    if (phase !== 'play') return;
    if (!mask.on && bag.mask <= 0) {
      floaters.push({ x: player.x, y: player.y - 26, text: '没口罩了', life: 0.9, color: '#fca5a5' });
      return;
    }
    mask.on = !mask.on;
    if (mask.on) sfx('pick');
    updateBars();
  }

  /* ---------------- 更新 ---------------- */
  function update(dt: number) {
    time += dt;
    hintCd = Math.max(0, hintCd - dt);

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.life -= dt;
      if (p.life <= 0) {
        particles.splice(i, 1);
        continue;
      }
      p.vy += p.grav * dt;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.vx *= 0.94;
    }
    for (let i = floaters.length - 1; i >= 0; i--) {
      const f = floaters[i];
      f.life -= dt;
      f.y -= 24 * dt;
      if (f.life <= 0) floaters.splice(i, 1);
    }

    shake *= Math.pow(0.0016, dt);
    if (shake < 0.05) shake = 0;

    if (hitStop > 0) {
      hitStop -= dt;
      return;
    }

    if (dlg.active) {
      dlg.acc += dt;
      const line = dlg.lines[dlg.i];
      if (line) {
        dlg.shown = Math.min(line.text.length, Math.floor(dlg.acc / 0.026));
        renderDialog();
      }
      return;
    }

    if (phase !== 'play') return;

    player.atkCd = Math.max(0, player.atkCd - dt);
    player.atkTime = Math.max(0, player.atkTime - dt);
    player.inv = Math.max(0, player.inv - dt);
    player.hurt = Math.max(0, player.hurt - dt);

    // 口罩消耗
    if (mask.on) {
      mask.t += dt;
      if (mask.t >= MASK_SECONDS) {
        mask.t = 0;
        bag.mask = Math.max(0, bag.mask - 1);
        if (bag.mask <= 0) mask.on = false;
        floaters.push({ x: player.x, y: player.y - 26, text: '口罩失效', life: 0.9, color: '#fbbf24' });
        updateBars();
      }
    }

    // 输入
    let dx = 0;
    let dy = 0;
    if (keys.has('a') || keys.has('arrowleft')) dx -= 1;
    if (keys.has('d') || keys.has('arrowright')) dx += 1;
    if (keys.has('w') || keys.has('arrowup')) dy -= 1;
    if (keys.has('s') || keys.has('arrowdown')) dy += 1;
    if (touchMove.active) {
      dx += touchMove.dx;
      dy += touchMove.dy;
      if (Math.hypot(dx, dy) < 0.25) {
        dx = 0;
        dy = 0;
      }
    }

    const mag = Math.hypot(dx, dy);
    player.moving = mag > 0.05;
    if (player.moving) {
      dx /= mag;
      dy /= mag;
      const speed = player.atkTime > 0 ? 28 : mask.on ? 54 : 58;
      const nx = player.x + dx * speed * dt;
      if (!collides(nx, player.y, 9, 8)) player.x = nx;
      const ny = player.y + dy * speed * dt;
      if (!collides(player.x, ny, 9, 8)) player.y = ny;

      if (Math.abs(dx) > Math.abs(dy)) player.facing = dx > 0 ? 'right' : 'left';
      else player.facing = dy > 0 ? 'down' : 'up';

      player.walk += dt * 9;
    } else {
      player.walk += dt * 2.2;
    }

    hitFoes();

    // 暴露度：贴着人就涨，离开就掉
    let near = 9999;
    for (const z of foes) {
      if (z.dead) continue;
      near = Math.min(near, Math.hypot(z.x - player.x, z.y - player.y));
    }
    const aura = mask.on ? MASK_FACTOR : 1;
    if (near < 22) player.exposure = Math.min(100, player.exposure + 7 * aura * dt);
    else if (near < 46) player.exposure = Math.min(100, player.exposure + 2.5 * aura * dt);
    else player.exposure = Math.max(0, player.exposure - 2.2 * dt);

    if (player.exposure >= 100 && phase === 'play') {
      die();
      return;
    }

    // 敌人
    for (let i = 0; i < foes.length; i++) {
      const z = foes[i];
      if (z.dead) {
        z.deadT += dt;
        continue;
      }
      z.flash = Math.max(0, z.flash - dt);
      z.stun = Math.max(0, z.stun - dt);
      z.cd = Math.max(0, z.cd - dt);
      z.wob += dt * 3.4;
      z.cough = Math.max(0, z.cough - dt);

      const distX = player.x - z.x;
      const distY = player.y - z.y;
      const dist = Math.hypot(distX, distY);

      if (z.kind === 'cougher') {
        // 咳嗽者：不追人，原地打晃地走，靠近就传染
        if (z.stun <= 0) {
          z.wt -= dt;
          if (z.wt <= 0) {
            z.wt = 1.6 + Math.random() * 1.6;
            const a = Math.random() * 6.28;
            z.wx = Math.cos(a);
            z.wy = Math.sin(a);
          }
          const sp = 14;
          const nx = z.x + z.wx * sp * dt;
          if (!collides(nx, z.y, 9, 8)) z.x = nx;
          else z.wt = 0;
          const ny = z.y + z.wy * sp * dt;
          if (!collides(z.x, ny, 9, 8)) z.y = ny;
          else z.wt = 0;
          z.facing = z.wx >= 0 ? 1 : -1;
          if (Math.random() < dt * 0.55) {
            z.cough = 0.3;
            particles.push({
              x: z.x + z.facing * 6,
              y: z.y - 14,
              vx: z.facing * 18,
              vy: -6,
              life: 0.5,
              max: 0.5,
              color: 'rgba(200,220,240,0.5)',
              size: 1,
              grav: -8,
            });
          }
        }
        continue;
      }

      if (z.stun <= 0) {
        if (z.windup > 0) {
          z.windup -= dt;
          if (z.windup <= 0) {
            if (dist < 22) hurtPlayer(z.kind === 'brute' ? 15 : 9, z.kind === 'brute' ? 18 : 12);
            z.cd = z.kind === 'brute' ? 1.1 : 0.85;
          }
        } else if (dist < 200) {
          z.facing = distX >= 0 ? 1 : -1;
          if (dist < 17 && z.cd <= 0) {
            z.windup = z.kind === 'brute' ? 0.3 : 0.34;
          } else if (dist > 15) {
            const sp = z.kind === 'brute' ? 24 : 30;
            const vx = (distX / (dist || 1)) * sp;
            const vy = (distY / (dist || 1)) * sp;
            const wob = Math.sin(z.wob) * (z.kind === 'brute' ? 3 : 6);
            const nx = z.x + (vx + wob) * dt;
            if (!collides(nx, z.y, 9, 8)) z.x = nx;
            const ny = z.y + vy * dt;
            if (!collides(z.x, ny, 9, 8)) z.y = ny;
          }
        }
      }

      for (let j = i + 1; j < foes.length; j++) {
        const o = foes[j];
        if (o.dead) continue;
        const ddx = o.x - z.x;
        const ddy = o.y - z.y;
        const dd = Math.hypot(ddx, ddy);
        if (dd > 0.1 && dd < 11) {
          const push = ((11 - dd) / dd) * 0.5;
          z.x -= ddx * push;
          z.y -= ddy * push;
          o.x += ddx * push;
          o.y += ddy * push;
        }
      }
    }

    // 拾取
    for (const p of pickups) {
      if (p.taken) continue;
      p.bob += dt * 3;
      if (Math.hypot(p.x - player.x, p.y - player.y) < 12) {
        p.taken = true;
        sfx('pick');
        if (p.kind === 'm') {
          bag.mask += 1;
          floaters.push({ x: p.x, y: p.y - 14, text: '口罩 +1（M 戴上）', life: 1.1, color: '#bae6fd' });
          if (sceneId === 'home') openDialog('pickMask');
        } else if (p.kind === 'd') {
          bag.med += 1;
          floaters.push({ x: p.x, y: p.y - 14, text: '药品 +1', life: 1, color: '#86efac' });
        } else {
          bag.food += 1;
          floaters.push({ x: p.x, y: p.y - 14, text: '食水 +1', life: 1, color: '#fcd34d' });
        }
        updateBars();
      }
    }

    // 路人对话
    for (const n of npcs) {
      if (n.done) continue;
      n.wob += dt * 2;
      if (Math.hypot(n.x - player.x, n.y - player.y) < 17) {
        n.done = true;
        openDialog(n.key);
        return;
      }
    }

    // 出口
    const def = SCENES[sceneId];
    for (const ex of exits) {
      if (Math.hypot(player.x - ex.x, player.y - ex.y) < 13) {
        if (def.need && !def.need()) {
          if (hintCd <= 0 && def.hint) {
            hintCd = 1.6;
            floaters.push({ x: player.x, y: player.y - 26, text: def.hint, life: 1.5, color: '#fca5a5' });
          }
          continue;
        }
        sceneIndex = Math.min(ORDER.length - 1, sceneIndex + 1);
        loadScene(ex.to);
        return;
      }
    }

    updateCam();
    updateBars();
  }

  /* ---------------- 绘制 ---------------- */
  const vignette = (() => {
    const c = document.createElement('canvas');
    c.width = VW;
    c.height = VH;
    const g = c.getContext('2d')!;
    const grad = g.createRadialGradient(VW / 2, VH / 2, 70, VW / 2, VH / 2, 205);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(0.6, 'rgba(0,0,0,0.1)');
    grad.addColorStop(1, 'rgba(2,3,6,0.72)');
    g.fillStyle = grad;
    g.fillRect(0, 0, VW, VH);
    return c;
  })();

  function drawShadow(x: number, y: number, w: number) {
    ctx.fillStyle = 'rgba(0,0,0,0.34)';
    ctx.fillRect(Math.round(x - w / 2), Math.round(y - 2), w, 3);
  }

  function drawPlayer() {
    const px = Math.round(player.x);
    const py = Math.round(player.y);
    const f = player.facing;
    const bob = player.moving ? Math.sin(player.walk) : 0;
    const step = player.moving ? Math.sin(player.walk) : 0;
    const blink = player.inv > 0 && Math.floor(player.inv * 18) % 2 === 0;

    drawShadow(px, py, 11);
    if (blink) ctx.globalAlpha = 0.42;

    // 西裤
    ctx.fillStyle = '#1e2430';
    ctx.fillRect(px - 4, py - 6, 3, 6 + Math.round(step));
    ctx.fillRect(px + 1, py - 6, 3, 6 - Math.round(step));

    // 西装外套
    const bw = f === 'left' || f === 'right' ? 8 : 10;
    ctx.fillStyle = player.hurt > 0 ? '#8b4a4a' : '#31405c';
    ctx.fillRect(px - bw / 2, py - 15, bw, 9);
    // 衬衫
    ctx.fillStyle = '#dfe6f2';
    ctx.fillRect(px - 2, py - 15, 4, 5);
    // 领带
    ctx.fillStyle = '#7f1d2b';
    ctx.fillRect(px - 1, py - 12, 2, 5);

    // 头
    const hy = py - 21 + Math.round(bob * 0.6);
    ctx.fillStyle = '#e8c9a4';
    ctx.fillRect(px - 3, hy, 6, 6);
    ctx.fillStyle = '#20242e';
    ctx.fillRect(px - 3, hy - 1, 6, 2);

    if (mask.on) {
      ctx.fillStyle = '#eef2f8';
      ctx.fillRect(px - 3, hy + 3, 6, 3);
      ctx.fillStyle = '#9fb0c6';
      ctx.fillRect(px - 4, hy + 4, 1, 1);
      ctx.fillRect(px + 3, hy + 4, 1, 1);
    }

    // 眼睛
    ctx.fillStyle = '#2b3342';
    if (f === 'left') ctx.fillRect(px - 3, hy + 2, 1, 1);
    else if (f === 'right') ctx.fillRect(px + 2, hy + 2, 1, 1);
    else if (f === 'down') {
      ctx.fillRect(px - 2, hy + 2, 1, 1);
      ctx.fillRect(px + 1, hy + 2, 1, 1);
    }

    // 公文包 / 挥击
    if (player.atkTime > 0) {
      const t = 1 - player.atkTime / ATTACK_DUR;
      const ang = { right: 0, down: Math.PI / 2, left: Math.PI, up: -Math.PI / 2 }[f];
      ctx.save();
      ctx.translate(px, py - 7);
      ctx.rotate(ang + (-0.7 + t * 1.4) * 0.8);
      ctx.fillStyle = '#6b4a2a';
      ctx.fillRect(8, -4, 11, 8);
      ctx.fillStyle = '#8a6239';
      ctx.fillRect(8, -4, 11, 2);
      ctx.fillStyle = '#3d2a17';
      ctx.fillRect(11, -2, 5, 1);
      ctx.restore();
    } else {
      ctx.fillStyle = '#6b4a2a';
      if (f === 'left') ctx.fillRect(px - 7, py - 10, 5, 5);
      else if (f === 'right') ctx.fillRect(px + 2, py - 10, 5, 5);
      else ctx.fillRect(px + 3, py - 9, 5, 5);
    }

    ctx.globalAlpha = 1;
  }

  function drawFoe(z: Foe) {
    const px = Math.round(z.x);
    const py = Math.round(z.y);

    if (z.dead) {
      const fade = Math.min(1, z.deadT / 0.4);
      ctx.globalAlpha = 1 - fade * 0.2;
      drawShadow(px, py, 12);
      ctx.fillStyle = '#2f3746';
      ctx.fillRect(px - 6, py - 8, 11, 6);
      ctx.fillStyle = '#c8a882';
      ctx.fillRect(px + 4, py - 9, 5, 5);
      ctx.fillStyle = '#1f2632';
      ctx.fillRect(px - 10, py - 6, 5, 3);
      ctx.globalAlpha = 1;
      return;
    }

    const brute = z.kind === 'brute';
    const cougher = z.kind === 'cougher';
    const wob = Math.sin(z.wob) * 1.6;
    const lean = Math.round(wob);
    const wind = z.windup > 0;
    const shiver = z.cough > 0 ? Math.round(Math.sin(time * 40) * 1) : 0;

    drawShadow(px, py, brute ? 14 : 11);
    if (z.flash > 0) ctx.globalAlpha = 0.9;

    // 腿
    ctx.fillStyle = cougher ? '#22293a' : '#2a1d22';
    ctx.fillRect(px - 4, py - 6, 3, 6);
    ctx.fillRect(px + 1, py - 6, 3, 6);

    // 身体
    const body = z.flash > 0 ? '#ffffff' : brute ? '#5a2530' : cougher ? '#3b4a63' : '#5c2f3a';
    const bw = brute ? 14 : cougher ? 10 : 11;
    ctx.fillStyle = body;
    ctx.fillRect(px - bw / 2 + lean * 0.3, py - 16, bw, 10);

    // 周凯：衬衫领口 + 领带，和玩家的白衬衫区分开，但别在暗地板上隐身
    if (brute && z.flash <= 0) {
      ctx.fillStyle = '#c9d3e2';
      ctx.fillRect(px - 3 + lean * 0.3, py - 16, 6, 2);
      ctx.fillStyle = '#e8b4b4';
      ctx.fillRect(px - 1 + lean * 0.3, py - 14, 2, 4);
    }

    // 头
    const hx = px - 3 + lean + shiver + (z.facing > 0 ? 1 : -1);
    const hy = py - 22 + shiver;
    ctx.fillStyle = z.flash > 0 ? '#ffffff' : brute ? '#8fa07a' : cougher ? '#d8b18c' : '#7ba763';
    ctx.fillRect(hx, hy, 6, 6);

    if (cougher) {
      // 鸭舌帽
      ctx.fillStyle = z.flash > 0 ? '#ffffff' : '#2f6fb5';
      ctx.fillRect(hx - 1, hy - 2, 8, 3);
      ctx.fillRect(hx - 1 + (z.facing > 0 ? 4 : -2), hy, 4, 1);
    } else {
      ctx.fillStyle = z.flash > 0 ? '#ffffff' : brute ? '#6f8261' : '#5f8349';
      ctx.fillRect(hx, hy, 6, 2);
    }

    // 眼睛：只有发病者才是红的
    if (z.flash <= 0) {
      if (cougher) {
        ctx.fillStyle = '#c2410c';
        ctx.fillRect(hx + 1, hy + 3, 1, 1);
        ctx.fillRect(hx + 4, hy + 3, 1, 1);
      } else {
        ctx.fillStyle = wind ? '#ff5a4a' : '#e04b3c';
        ctx.fillRect(hx + 1, hy + 3, 2, 1);
        ctx.fillRect(hx + 4, hy + 3, 1, 1);
      }
    }

    // 伸出的手
    if (!cougher) {
      ctx.fillStyle = z.flash > 0 ? '#ffffff' : brute ? '#8fa07a' : '#6b8f56';
      const armX = z.facing > 0 ? px + 5 : px - 9;
      ctx.fillRect(armX, py - 14 + (wind ? -2 : 0), 4, 2);
    }

    ctx.globalAlpha = 1;

    // 血条
    if (z.hp < z.maxHp) {
      const w = brute ? 18 : 14;
      const pct = Math.max(0, z.hp / z.maxHp);
      const by = brute ? py - 32 : py - 28;
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillRect(px - w / 2, by, w, 2);
      ctx.fillStyle = brute ? '#f59e0b' : '#ef4444';
      ctx.fillRect(px - w / 2, by, Math.round(w * pct), 2);
    }
  }

  function drawNpc(n: Npc) {
    const px = Math.round(n.x);
    const py = Math.round(n.y);
    const bob = Math.sin(n.wob) * 0.8;
    drawShadow(px, py, 10);
    ctx.fillStyle = '#2b3140';
    ctx.fillRect(px - 4, py - 6, 3, 6);
    ctx.fillRect(px + 1, py - 6, 3, 6);
    ctx.fillStyle = '#48566f';
    ctx.fillRect(px - 5, py - 15, 10, 9);
    ctx.fillStyle = '#e8c9a4';
    ctx.fillRect(px - 3, py - 21 + Math.round(bob), 6, 6);
    ctx.fillStyle = '#2c3342';
    ctx.fillRect(px - 3, py - 22 + Math.round(bob), 6, 2);
    if (!n.done) {
      // 头顶提示
      ctx.fillStyle = `rgba(125, 211, 252, ${0.45 + Math.sin(time * 4) * 0.25})`;
      ctx.fillRect(px - 1, py - 27 + Math.round(bob), 2, 2);
    }
  }

  function drawPickup(p: Pickup) {
    const px = Math.round(p.x);
    const py = Math.round(p.y) + Math.round(Math.sin(p.bob) * 1.5);
    const a = 0.35 + Math.sin(time * 3 + p.bob) * 0.12;
    ctx.fillStyle = `rgba(255,255,255,${a})`;
    ctx.fillRect(px - 6, py - 4, 12, 3);

    if (p.kind === 'm') {
      ctx.fillStyle = '#eef2f8';
      ctx.fillRect(px - 4, py - 9, 8, 6);
      ctx.fillStyle = '#c3cede';
      ctx.fillRect(px - 6, py - 8, 2, 1);
      ctx.fillRect(px + 4, py - 8, 2, 1);
    } else if (p.kind === 'd') {
      ctx.fillStyle = '#f1f5f9';
      ctx.fillRect(px - 4, py - 9, 8, 6);
      ctx.fillStyle = '#16a34a';
      ctx.fillRect(px - 1, py - 8, 2, 4);
      ctx.fillRect(px - 2, py - 7, 4, 2);
    } else {
      ctx.fillStyle = '#a9702f';
      ctx.fillRect(px - 5, py - 9, 10, 6);
      ctx.fillStyle = '#c78b41';
      ctx.fillRect(px - 5, py - 9, 10, 2);
      ctx.fillStyle = '#7c521f';
      ctx.fillRect(px - 1, py - 7, 2, 4);
    }
  }

  function drawExit(ex: { x: number; y: number }, open: boolean) {
    const px = Math.round(ex.x);
    const py = Math.round(ex.y);
    const pulse = 0.35 + (Math.sin(time * 4) + 1) * 0.25;
    ctx.fillStyle = open ? `rgba(74, 222, 128, ${pulse * 0.5})` : `rgba(248, 113, 113, ${pulse * 0.4})`;
    ctx.fillRect(px - 7, py - 7, 14, 14);
    ctx.fillStyle = open ? `rgba(134, 239, 172, ${pulse})` : `rgba(252, 165, 165, ${pulse})`;
    ctx.beginPath();
    ctx.moveTo(px, py + 4);
    ctx.lineTo(px - 4, py - 2);
    ctx.lineTo(px + 4, py - 2);
    ctx.closePath();
    ctx.fill();
  }

  function draw() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.fillStyle = '#0a0c12';
    ctx.fillRect(0, 0, VW, VH);
    if (!sceneArt) return;

    const sx = shake > 0 ? (Math.random() - 0.5) * shake : 0;
    const sy = shake > 0 ? (Math.random() - 0.5) * shake : 0;

    ctx.save();
    ctx.translate(Math.round(-camX + sx), Math.round(-camY + sy));

    ctx.drawImage(sceneArt, 0, 0);

    for (const z of foes) if (z.dead) drawFoe(z);
    for (const p of pickups) if (!p.taken) drawPickup(p);

    const open = !SCENES[sceneId].need || SCENES[sceneId].need!();
    for (const ex of exits) drawExit(ex, open);

    const actors: { y: number; draw: () => void }[] = [];
    for (const z of foes) if (!z.dead) actors.push({ y: z.y, draw: () => drawFoe(z) });
    for (const n of npcs) actors.push({ y: n.y, draw: () => drawNpc(n) });
    actors.push({ y: player.y, draw: drawPlayer });
    actors.sort((a, b) => a.y - b.y);
    for (const a of actors) a.draw();

    for (const p of particles) {
      ctx.globalAlpha = Math.min(1, p.life / (p.max * 0.6));
      ctx.fillStyle = p.color;
      ctx.fillRect(Math.round(p.x), Math.round(p.y), p.size, p.size);
    }
    ctx.globalAlpha = 1;

    ctx.font = 'bold 8px ui-monospace, monospace';
    ctx.textAlign = 'center';
    for (const f of floaters) {
      ctx.globalAlpha = Math.min(1, f.life / 0.4);
      ctx.fillStyle = '#00000088';
      ctx.fillText(f.text, Math.round(f.x) + 1, Math.round(f.y) + 1);
      ctx.fillStyle = f.color;
      ctx.fillText(f.text, Math.round(f.x), Math.round(f.y));
    }
    ctx.globalAlpha = 1;
    ctx.textAlign = 'left';

    ctx.restore();

    ctx.drawImage(vignette, 0, 0);
    if (player.hurt > 0) {
      ctx.fillStyle = `rgba(190, 24, 24, ${Math.min(0.42, player.hurt * 1.4)})`;
      ctx.fillRect(0, 0, VW, VH);
    }
    if (player.exposure > 60 && phase === 'play') {
      const pulse = (Math.sin(time * 5) + 1) * 0.5;
      ctx.fillStyle = `rgba(16, 120, 140, ${0.03 + pulse * 0.07})`;
      ctx.fillRect(0, 0, VW, VH);
    }
  }

  /* ---------------- 循环 ---------------- */
  let last = performance.now();
  let raf = 0;

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    update(dt);
    draw();
    raf = requestAnimationFrame(frame);
  }

  /* ---------------- 输入 ---------------- */
  function onKeyDown(e: KeyboardEvent) {
    const k = e.key.toLowerCase();

    if (k === ' ' || k === 'enter') {
      e.preventDefault();
      if (dlg.active) advanceDialog();
      else if (phase === 'play') doAttack();
      return;
    }
    if (k === 'j' || k === 'k') {
      if (phase === 'play') doAttack();
      return;
    }
    if (k === 'm') {
      toggleMask();
      return;
    }
    if (k === 'r') {
      resetRun();
      startRun();
      return;
    }
    if (k === 'escape') {
      if (dlg.active) closeDialog();
      return;
    }
    if (['w', 'a', 's', 'd', 'arrowup', 'arrowdown', 'arrowleft', 'arrowright'].includes(k)) {
      e.preventDefault();
      keys.add(k);
    }
  }

  function onKeyUp(e: KeyboardEvent) {
    keys.delete(e.key.toLowerCase());
  }

  window.addEventListener('keydown', onKeyDown);
  window.addEventListener('keyup', onKeyUp);
  window.addEventListener('blur', () => keys.clear());

  canvas.addEventListener('pointerdown', (e) => {
    if (phase !== 'play') return;
    canvas.setPointerCapture(e.pointerId);
    const rect = canvas.getBoundingClientRect();
    const rx = (e.clientX - rect.left) / rect.width;
    if (rx > 0.55) {
      doAttack();
      return;
    }
    touchMove.active = true;
    touchMove.id = e.pointerId;
    touchMove.ox = e.clientX;
    touchMove.oy = e.clientY;
    touchMove.dx = 0;
    touchMove.dy = 0;
  });

  canvas.addEventListener('pointermove', (e) => {
    if (!touchMove.active || e.pointerId !== touchMove.id) return;
    const dx = e.clientX - touchMove.ox;
    const dy = e.clientY - touchMove.oy;
    const len = Math.hypot(dx, dy);
    const maxR = 34;
    if (len > maxR) {
      touchMove.ox = e.clientX - (dx / len) * maxR;
      touchMove.oy = e.clientY - (dy / len) * maxR;
    }
    touchMove.dx = clamp((e.clientX - touchMove.ox) / maxR, -1, 1);
    touchMove.dy = clamp((e.clientY - touchMove.oy) / maxR, -1, 1);
  });

  const endPointer = (e: PointerEvent) => {
    if (e.pointerId === touchMove.id) {
      touchMove.active = false;
      touchMove.dx = 0;
      touchMove.dy = 0;
      touchMove.id = -1;
    }
  };

  canvas.addEventListener('pointerup', endPointer);
  canvas.addEventListener('pointercancel', endPointer);
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());

  elAtk?.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    e.stopPropagation();
    doAttack();
  });

  elDialog?.addEventListener('click', () => advanceDialog());

  elBtn?.addEventListener('click', () => {
    if (!elOverlay || elOverlay.hidden) return;
    initAudio();
    if (ac && ac.state === 'suspended') ac.resume();
    elBtn?.blur();
    if (btnAction) btnAction();
  });

  /* ---------------- 启动 ---------------- */
  grid = SCENES.home.rows.map((r) => r.split(''));
  mapH = grid.length;
  mapW = grid[0].length;
  buildSceneArt();
  player.x = 4 * TS + TS / 2;
  player.y = 6 * TS + TS - 2;
  updateCam(true);
  updateBars();
  if (elScene) elScene.textContent = '出租屋';
  btnAction = () => {
    resetRun();
    startRun();
  };
  raf = requestAnimationFrame(frame);

  // 自动化测试用
  (window as any).__jb = {
    get player() {
      return {
        x: Math.round(player.x),
        y: Math.round(player.y),
        hp: player.hp,
        exposure: Math.round(player.exposure),
        facing: player.facing,
      };
    },
    get scene() {
      return sceneId;
    },
    get phase() {
      return phase;
    },
    get bag() {
      return { ...bag, on: mask.on };
    },
    get foes() {
      return foes.map((z) => ({ x: Math.round(z.x), y: Math.round(z.y), hp: z.hp, dead: z.dead, kind: z.kind }));
    },
    get dialog() {
      return {
        active: dlg.active,
        i: dlg.i,
        total: dlg.lines.length,
        text: dlg.lines[dlg.i]?.text ?? null,
        endingShown,
      };
    },
    get exits() {
      return exits.map((e) => ({ x: Math.round(e.x), y: Math.round(e.y), to: e.to }));
    },
    tp(tx: number, ty: number) {
      player.x = tx * TS + TS / 2;
      player.y = ty * TS + TS - 2;
      updateCam(true);
    },
    killAll() {
      for (const z of foes) {
        z.hp = 0;
        z.dead = true;
      }
    },
    toggleMask,
  };

  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(raf);
    window.removeEventListener('keydown', onKeyDown);
    window.removeEventListener('keyup', onKeyUp);
  });
</script>
