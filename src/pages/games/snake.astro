---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerBar from '../../components/PlayerBar.astro';
import '../../styles/games.css';
---

<BaseLayout title="贪吃蛇" description="贪吃蛇 · 方向键控制，吃掉光点，别撞墙也别咬到自己">
  <div class="gx-page container-x" id="snakeRoot">
    <a class="gx-back" href="/games">
      <i class="ri-arrow-left-line" aria-hidden="true"></i>
      游戏厅
    </a>

    <header class="gx-head">
      <div class="gx-head-row">
        <div>
          <p class="gx-kicker">SNAKE</p>
          <h1 class="gx-title">贪吃蛇</h1>
        </div>
        <PlayerBar />
      </div>
      <p class="gx-sub">方向键或 WASD 转向。每吃一颗光点变长一格、速度快一点，撞墙或咬到自己就结束。</p>
    </header>

    <div class="gx-stage">
      <div class="gx-board-col">
        <div class="gx-screen" style="max-width:540px">
          <canvas id="snakeCanvas"></canvas>
          <div class="gx-overlay" id="snakeOverlay">
            <div class="gx-overlay-card">
              <p class="gx-overlay-kicker" id="snakeKicker">READY</p>
              <h2 class="gx-overlay-title" id="snakeTitle">准备好了吗</h2>
              <p class="gx-overlay-desc" id="snakeDesc">按 <b>空格</b> 或点击下面的按钮开始</p>
              <button class="gx-btn" id="snakeBtn" type="button">开始游戏</button>
            </div>
          </div>
        </div>
      </div>

      <aside class="gx-side">
        <div class="gx-panel">
          <p class="gx-panel-label">SCORE · 本局得分</p>
          <p class="gx-score" id="snakeScore">0</p>
          <p class="gx-score-sub">最高 <span id="snakeBest">0</span></p>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">CONTROLS · 操作</p>
          <div class="gx-keys">
            <span class="gx-key">↑ ↓ ← →</span>
            <span class="gx-key">W A S D</span>
            <span class="gx-key">空格 暂停</span>
            <span class="gx-key">R 重开</span>
          </div>
        </div>

        <div class="gx-panel">
          <p class="gx-panel-label">TIP · 提示</p>
          <p class="gx-note">
            转弯键可以连按两下，蛇会顺次拐两个弯 —— 贴墙走的时候很好用。手机可以直接在棋盘上滑动。
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { readStat, recordRun } from '../../lib/save-store';

  const COLS = 22;
  const ROWS = 22;
  const CELL = 24;
  const W = COLS * CELL;
  const H = ROWS * CELL;

  let raf = 0;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let bg: HTMLCanvasElement | null = null;
  let keyHandler: ((e: KeyboardEvent) => void) | null = null;
  let touchHandler: ((e: TouchEvent) => void) | null = null;

  let snake: { x: number; y: number }[] = [];
  let dir = { x: 1, y: 0 };
  let queue: { x: number; y: number }[] = [];
  let food = { x: 0, y: 0 };
  let score = 0;
  let best = 0;
  let stepMs = 132;
  let acc = 0;
  let last = 0;
  let progress = 0;
  let mode: 'ready' | 'playing' | 'paused' | 'over' = 'ready';
  let deadAt = 0;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function makeBackground() {
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    const g = c.getContext('2d')!;
    g.fillStyle = '#060810';
    g.fillRect(0, 0, W, H);
    g.fillStyle = 'rgba(255,255,255,0.05)';
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        g.beginPath();
        g.arc((x + 0.5) * CELL, (y + 0.5) * CELL, 1.15, 0, Math.PI * 2);
        g.fill();
      }
    }
    return c;
  }

  function emptyCells() {
    const taken = new Set(snake.map((s) => s.y * COLS + s.x));
    const out: { x: number; y: number }[] = [];
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        if (!taken.has(y * COLS + x)) out.push({ x, y });
      }
    }
    return out;
  }

  function placeFood() {
    const cells = emptyCells();
    if (!cells.length) return false;
    food = cells[Math.floor(Math.random() * cells.length)];
    return true;
  }

  function reset() {
    snake = [
      { x: 8, y: 11 },
      { x: 7, y: 11 },
      { x: 6, y: 11 },
    ];
    dir = { x: 1, y: 0 };
    queue = [];
    score = 0;
    stepMs = 132;
    acc = 0;
    progress = 0;
    placeFood();
    syncScore();
  }

  function syncScore() {
    const s = $('snakeScore');
    const b = $('snakeBest');
    if (s) s.textContent = String(score);
    if (b) b.textContent = String(best);
  }

  function overlay(kicker: string, title: string, desc: string, btn: string | null) {
    const ov = $('snakeOverlay');
    if (!ov) return;
    const k = $('snakeKicker');
    const t = $('snakeTitle');
    const d = $('snakeDesc');
    const btnEl = $<HTMLButtonElement>('snakeBtn');
    if (k) k.textContent = kicker;
    if (t) t.textContent = title;
    if (d) d.innerHTML = desc;
    if (btnEl) {
      if (btn) {
        btnEl.hidden = false;
        btnEl.textContent = btn;
      } else {
        btnEl.hidden = true;
      }
    }
    ov.hidden = false;
  }

  function hideOverlay() {
    const ov = $('snakeOverlay');
    if (ov) ov.hidden = true;
  }

  function start() {
    reset();
    mode = 'playing';
    last = performance.now();
    hideOverlay();
  }

  function die() {
    mode = 'over';
    deadAt = performance.now();
    const isNewBest = score > best;
    if (isNewBest) best = score;
    syncScore();
    void recordRun('snake', score);
    overlay(
      isNewBest ? 'NEW RECORD' : 'GAME OVER',
      isNewBest ? '新纪录！' : '撞上了',
      `本局得分 <b>${score}</b> · 最高 ${best}<br>按 <b>空格</b> 再来一局`,
      '再来一局',
    );
  }

  function step() {
    if (queue.length) {
      const next = queue.shift()!;
      if (next.x !== -dir.x || next.y !== -dir.y) dir = next;
    }

    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

    if (head.x < 0 || head.y < 0 || head.x >= COLS || head.y >= ROWS) {
      die();
      return;
    }

    const willGrow = head.x === food.x && head.y === food.y;
    const body = willGrow ? snake : snake.slice(0, -1);
    if (body.some((s) => s.x === head.x && s.y === head.y)) {
      die();
      return;
    }

    snake.unshift(head);

    if (willGrow) {
      score += 1;
      stepMs = Math.max(62, 132 - score * 3);
      if (!placeFood()) {
        mode = 'over';
        best = Math.max(best, score);
        syncScore();
        void recordRun('snake', score);
        overlay('PERFECT', '满屏都是你', '棋盘填满了，这局没法再长了', '再来一局');
      }
      syncScore();
    } else {
      snake.pop();
    }
  }

  function pathPoints(t: number) {
    const pts: [number, number][] = [];
    const head = snake[0];
    pts.push([(head.x + 0.5 + dir.x * t) * CELL, (head.y + 0.5 + dir.y * t) * CELL]);
    for (let i = 0; i < snake.length - 1; i++) {
      pts.push([(snake[i].x + 0.5) * CELL, (snake[i].y + 0.5) * CELL]);
    }
    if (snake.length > 1) {
      const tail = snake[snake.length - 1];
      const prev = snake[snake.length - 2];
      pts.push([
        (tail.x + 0.5 + (prev.x - tail.x) * t) * CELL,
        (tail.y + 0.5 + (prev.y - tail.y) * t) * CELL,
      ]);
    }
    return pts;
  }

  function draw(now: number) {
    if (!ctx || !canvas) return;
    if (bg) ctx.drawImage(bg, 0, 0);

    // 食物
    const pulse = 0.5 + 0.5 * Math.sin(now / 260);
    const fx = (food.x + 0.5) * CELL;
    const fy = (food.y + 0.5) * CELL;
    const glow = ctx.createRadialGradient(fx, fy, 0, fx, fy, CELL * 1.6);
    glow.addColorStop(0, `rgba(251,113,133,${0.34 + pulse * 0.18})`);
    glow.addColorStop(1, 'rgba(251,113,133,0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(fx, fy, CELL * 1.6, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fb7185';
    ctx.beginPath();
    ctx.arc(fx, fy, CELL * (0.26 + pulse * 0.05), 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.beginPath();
    ctx.arc(fx - CELL * 0.09, fy - CELL * 0.1, CELL * 0.07, 0, Math.PI * 2);
    ctx.fill();

    // 蛇身
    const pts = pathPoints(mode === 'playing' ? progress : 1);
    if (pts.length < 2) return;

    const head = pts[0];
    const tail = pts[pts.length - 1];
    const grad = ctx.createLinearGradient(head[0], head[1], tail[0], tail[1]);
    grad.addColorStop(0, '#9df6ff');
    grad.addColorStop(0.28, '#22d3ee');
    grad.addColorStop(0.7, '#a78bfa');
    grad.addColorStop(1, '#6d5bd0');

    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';

    // 外发光
    ctx.save();
    ctx.strokeStyle = grad;
    ctx.globalAlpha = 0.35;
    ctx.lineWidth = CELL * 0.92;
    ctx.shadowColor = 'rgba(34,211,238,0.85)';
    ctx.shadowBlur = 22;
    ctx.beginPath();
    ctx.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
    ctx.stroke();
    ctx.restore();

    // 主体
    ctx.strokeStyle = grad;
    ctx.lineWidth = CELL * 0.76;
    ctx.beginPath();
    ctx.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
    ctx.stroke();

    // 头部高光
    ctx.fillStyle = 'rgba(255,255,255,0.92)';
    ctx.beginPath();
    ctx.arc(pts[0][0], pts[0][1], CELL * 0.17, 0, Math.PI * 2);
    ctx.fill();

    // 死亡闪烁
    if (mode === 'over') {
      const k = Math.max(0, 1 - (now - deadAt) / 900);
      if (k > 0) {
        ctx.fillStyle = `rgba(251,113,133,${0.22 * k})`;
        ctx.fillRect(0, 0, W, H);
      }
    }
  }

  function loop(now: number) {
    raf = requestAnimationFrame(loop);
    if (!canvas || !canvas.isConnected) {
      cancelAnimationFrame(raf);
      return;
    }
    const dt = Math.min(120, now - last);
    last = now;

    if (mode === 'playing') {
      acc += dt;
      while (acc >= stepMs && mode === 'playing') {
        acc -= stepMs;
        step();
      }
      progress = mode === 'playing' ? Math.min(1, acc / stepMs) : 1;
    }

    draw(now);
  }

  function turn(nx: number, ny: number) {
    const ref = queue.length ? queue[queue.length - 1] : dir;
    if (nx === -ref.x && ny === -ref.y) return;
    if (nx === ref.x && ny === ref.y) return;
    if (queue.length >= 2) return;
    queue.push({ x: nx, y: ny });
  }

  function toggle() {
    if (mode === 'ready' || mode === 'over') {
      start();
      return;
    }
    if (mode === 'playing') {
      mode = 'paused';
      overlay('PAUSED', '暂停中', '按 <b>空格</b> 继续', '继续');
    } else if (mode === 'paused') {
      mode = 'playing';
      last = performance.now();
      hideOverlay();
    }
  }

  function setup() {
    canvas = $<HTMLCanvasElement>('snakeCanvas');
    if (!canvas) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    bg = makeBackground();

    void readStat('snake').then((rec) => {
      best = Math.max(best, rec.best || 0);
      syncScore();
    });

    reset();
    overlay('READY', '准备好了吗', '按 <b>空格</b> 或点击下面的按钮开始', '开始游戏');

    const btn = $<HTMLButtonElement>('snakeBtn');
    if (btn) btn.addEventListener('click', () => (mode === 'paused' ? toggle() : start()));

    keyHandler = (e: KeyboardEvent) => {
      const k = e.key;
      let used = true;
      if (k === 'ArrowUp' || k === 'w' || k === 'W') turn(0, -1);
      else if (k === 'ArrowDown' || k === 's' || k === 'S') turn(0, 1);
      else if (k === 'ArrowLeft' || k === 'a' || k === 'A') turn(-1, 0);
      else if (k === 'ArrowRight' || k === 'd' || k === 'D') turn(1, 0);
      else if (k === ' ' || k === 'Spacebar' || k === 'Enter') toggle();
      else if (k === 'r' || k === 'R') start();
      else used = false;
      if (used) e.preventDefault();
    };
    window.addEventListener('keydown', keyHandler);

    let tx = 0;
    let ty = 0;
    touchHandler = (e: TouchEvent) => {
      const t = e.touches[0];
      if (!t) return;
      if (e.type === 'touchstart') {
        tx = t.clientX;
        ty = t.clientY;
        if (mode !== 'playing') toggle();
        return;
      }
      const dx = t.clientX - tx;
      const dy = t.clientY - ty;
      if (Math.abs(dx) < 22 && Math.abs(dy) < 22) return;
      if (Math.abs(dx) > Math.abs(dy)) turn(dx > 0 ? 1 : -1, 0);
      else turn(0, dy > 0 ? 1 : -1);
      tx = t.clientX;
      ty = t.clientY;
      e.preventDefault();
    };
    canvas.addEventListener('touchstart', touchHandler, { passive: true });
    canvas.addEventListener('touchmove', touchHandler, { passive: false });

    last = performance.now();
    raf = requestAnimationFrame(loop);
  }

  function destroy() {
    cancelAnimationFrame(raf);
    if (keyHandler) window.removeEventListener('keydown', keyHandler);
    if (touchHandler && canvas) {
      canvas.removeEventListener('touchstart', touchHandler);
      canvas.removeEventListener('touchmove', touchHandler);
    }
    keyHandler = null;
    touchHandler = null;
    ctx = null;
    canvas = null;
  }

  function boot() {
    const root = document.getElementById('snakeRoot');
    if (!root || root.dataset.booted) return;
    root.dataset.booted = '1';
    setup();
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', destroy);
  boot();
</script>
