</style>

<script>
  /* ---------------------------------------------------------
     星际穿越粒子场
     --------------------------------------------------------- */
  function initWarp() {
    const canvas = document.getElementById('warp') as HTMLCanvasElement | null;
    if (!canvas) return;

    const prev = (window as any).__warpRaf;
    if (prev) cancelAnimationFrame(prev);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const light = () => document.documentElement.getAttribute('data-theme') === 'light';

    let w = 0;
    let h = 0;
    let stars: { x: number; y: number; z: number; hue: number }[] = [];
    let raf = 0;
    let last = performance.now();
    let speed = 1;

    const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };
    const palettes = {
      dark: ['#22d3ee', '#a78bfa', '#fb7185', '#e2e8ff'],
      light: ['#0891b2', '#7c3aed', '#e11d48', '#334155'],
    };

    const newStar = (seed: boolean) => ({
      x: (Math.random() - 0.5) * w * 2.2,
      y: (Math.random() - 0.5) * h * 2.2,
      z: seed ? Math.random() * w + 40 : w * 1.15,
      hue: Math.floor(Math.random() * 4),
    });

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, rect.width);
      h = Math.max(1, rect.height);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.round(Math.min(300, Math.max(80, (w * h) / 3600)));
      stars = Array.from({ length: count }, () => newStar(true));
    };

    const draw = (now: number) => {
      // 页面切换后 canvas 已从 DOM 移除，自动停机
      if (!canvas.isConnected) {
        (window as any).__warpRaf = 0;
        return;
      }
      const dt = Math.min(48, now - last) / 16.67;
      last = now;

      pointer.x += (pointer.tx - pointer.x) * 0.06;
      pointer.y += (pointer.ty - pointer.y) * 0.06;

      // 拖尾：用 destination-out 降低上一帧不透明度，保持背景透明
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0,0,0,0.26)';
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';

      const cx = w / 2 + (pointer.x - 0.5) * w * 0.16;
      const cy = h / 2 + (pointer.y - 0.5) * h * 0.16;
      const colors = light() ? palettes.light : palettes.dark;
      const focal = Math.max(320, w * 0.55);

      for (const s of stars) {
        const pz = s.z;
        s.z -= speed * 2.4 * dt;

        if (s.z < 8) {
          s.x = (Math.random() - 0.5) * w * 2.2;
          s.y = (Math.random() - 0.5) * h * 2.2;
          s.z = w * 1.15;
          continue;
        }

        const k = focal / s.z;
        const pk = focal / pz;
        const x1 = cx + s.x * pk;
        const y1 = cy + s.y * pk;
        const x2 = cx + s.x * k;
        const y2 = cy + s.y * k;

        // 超远焦的星点跳过绘制，省算力也避免噪点堆积
        if (s.z > w * 1.2) continue;

        const depth = 1 - s.z / (w * 1.2);
        ctx.strokeStyle = colors[s.hue];
        ctx.globalAlpha = Math.min(0.85, 0.1 + depth * 0.9);
        ctx.lineWidth = 0.6 + depth * 1.7;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      raf = requestAnimationFrame(draw);
    };

    const start = () => {
      resize();
      if (reduce) {
        last = performance.now();
        // 静态渲染一帧
        ctx.globalCompositeOperation = 'lighter';
        for (const s of stars) {
          const k = Math.max(320, w * 0.55) / s.z;
          const depth = 1 - s.z / (w * 1.2);
          if (depth < 0) continue;
          const colors = light() ? palettes.light : palettes.dark;
          ctx.strokeStyle = colors[s.hue];
          ctx.globalAlpha = 0.12 + depth * 0.55;
          ctx.lineWidth = 0.6 + depth * 1.2;
          ctx.beginPath();
          ctx.moveTo(w / 2, h / 2);
          ctx.lineTo(w / 2 + s.x * k, h / 2 + s.y * k);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = 'source-over';
        return;
      }
      last = performance.now();
      raf = requestAnimationFrame(draw);
    };

    const onMove = (e: PointerEvent) => {
      pointer.tx = e.clientX / window.innerWidth;
      pointer.ty = e.clientY / window.innerHeight;
    };

    const onScroll = () => {
      // 往下滚时加速穿越
      const hei = Math.max(1, window.innerHeight);
      speed = Math.min(3.4, 1 + window.scrollY / hei);
    };

    const onVisibility = () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else if (!reduce) {
        last = performance.now();
        raf = requestAnimationFrame(draw);
      }
    };

    const onResize = () => resize();

    // 每次进入首页都重新绑定，先解绑上一份，避免监听器累积
    const prevAc = (window as any).__warpAc as AbortController | undefined;
    if (prevAc) prevAc.abort();
    const ac = new AbortController();
    (window as any).__warpAc = ac;
    const opt = { passive: true, signal: ac.signal } as AddEventListenerOptions;

    window.addEventListener('pointermove', onMove, opt);
    window.addEventListener('scroll', onScroll, opt);
    window.addEventListener('resize', onResize, opt);
    document.addEventListener('visibilitychange', onVisibility, { signal: ac.signal });

    resize();
    start();

    (window as any).__warpRaf = raf;
  }

  /* ---------------------------------------------------------
     时钟
     --------------------------------------------------------- */
  function initClock() {
    const heroEl = document.getElementById('heroClock');
    const consoleEl = document.getElementById('consoleClock');
    const dateEl = document.getElementById('consoleDate');
    if (!heroEl && !consoleEl) return;

    const time = () =>
      new Date().toLocaleTimeString('zh-CN', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const date = () =>
      new Date().toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        weekday: 'short',
      });

    const tick = () => {
      const t = time();
      if (heroEl) heroEl.textContent = t;
      if (consoleEl) consoleEl.textContent = t;
      if (dateEl) dateEl.textContent = date();
    };

    tick();
    const old = (window as any).__fangClock;
    if (old) clearInterval(old);
    (window as any).__fangClock = window.setInterval(tick, 1000);
  }

  /* ---------------------------------------------------------
     打字机
     --------------------------------------------------------- */
  function initType() {
    const el = document.getElementById('type');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';

    const phrases = [
      '这里什么都没有，除了一点夜色。',
      'build passing · 咖啡因水平正常。',
      '有一扇门在下面，你自己找。',
      'Astro 7 驱动，纯手写动效。',
    ];

    let p = 0;
    let i = 0;
    let deleting = false;

    const tick = () => {
      const text = phrases[p];
      i += deleting ? -1 : 1;
      el.textContent = text.slice(0, i);

      let delay = deleting ? 32 : 68;
      if (!deleting && i === text.length) {
        delay = 2000;
        deleting = true;
      } else if (deleting && i === 0) {
        deleting = false;
        p = (p + 1) % phrases.length;
        delay = 380;
      }
      window.setTimeout(tick, delay);
    };

    tick();
  }

  /* ---------------------------------------------------------
     卡片 3D 倾斜 + 聚光
     --------------------------------------------------------- */
  function initTilt() {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll<HTMLElement>('.sector').forEach((card) => {
      if (card.dataset.tilt) return;
      card.dataset.tilt = '1';

      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
        card.style.setProperty('--rx', `${(0.5 - py) * 9}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 11}deg`);
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ---------------------------------------------------------
     数字滚动
     --------------------------------------------------------- */
  function initCounters() {
    const nodes = document.querySelectorAll<HTMLElement>('.tele-v[data-count]');
    if (!nodes.length) return;

    const target = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '0';
      return { value: Number(raw) || 0, pad: raw.length };
    };

    nodes.forEach((el) => {
      if (el.dataset.counted) return;
      el.dataset.counted = '1';
      const { value, pad } = target(el);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || value === 0) {
        el.textContent = String(value).padStart(pad, '0');
        return;
      }

      const dur = 1100;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(value * eased)).padStart(pad, '0');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  /* ---------------------------------------------------------
     首屏视差
     --------------------------------------------------------- */
  function initParallax() {
    const hero = document.querySelector<HTMLElement>('.hero-inner');
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const old = (window as any).__fangHeroScroll;
    if (old) window.removeEventListener('scroll', old);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y < window.innerHeight * 1.2) {
          hero.style.transform = `translateY(${y * 0.12}px)`;
          hero.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.9)));
        }
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    (window as any).__fangHeroScroll = onScroll;
  }

  function boot() {
    initWarp();
    initClock();
    initType();
    initTilt();
    initCounters();
    initParallax();
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>
