<script>
  /* ---------------------------------------------------------
     星际穿越粒子场
     --------------------------------------------------------- */
  function initField() {
    const canvas = document.getElementById('field') as HTMLCanvasElement | null;
    if (!canvas) return;

    const prevRaf = (window as any).__fieldRaf;
    if (prevRaf) cancelAnimationFrame(prevRaf);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';

    interface Dot {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      a: number;
      z: number;
    }
    interface P {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      c: number;
      ph: number;
    }

    let w = 0;
    let h = 0;
    let raf = 0;
    let last = performance.now();
    let dust: Dot[] = [];
    let ps: P[] = [];
    let linkDist = 132;
    let mouseDist = 190;

    const pointer = { x: -999, y: -999, tx: -999, ty: -999, inside: false };
    const rings: { x: number; y: number; t: number }[] = [];

    // 深色主题：霓虹；浅色主题：深色墨点
    const dotsDark = ['#22d3ee', '#a78bfa', '#fb7185', '#e8eeff'];
    const dotsLight = ['#0891b2', '#7c3aed', '#e11d48', '#1e293b'];
    const lineDark = '34,211,238';
    const lineLight = '30,41,59';

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, rect.width);
      h = Math.max(1, rect.height);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      linkDist = w < 700 ? 104 : 150;
      mouseDist = w < 700 ? 150 : 200;

      // 背景浮尘
      const dustCount = Math.round(Math.min(90, Math.max(30, (w * h) / 22000)));
      dust = Array.from({ length: dustCount }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: rand(-0.08, 0.08),
        vy: rand(-0.06, 0.06),
        r: rand(0.5, 1.6),
        a: rand(0.12, 0.38),
        z: rand(0.3, 1),
      }));

      // 交互粒子
      const pCount = Math.round(Math.min(130, Math.max(40, (w * h) / 8500)));
      ps = Array.from({ length: pCount }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: rand(-0.28, 0.28),
        vy: rand(-0.28, 0.28),
        r: rand(1, 2.2),
        c: Math.floor(Math.random() * 4),
        ph: Math.random() * Math.PI * 2,
      }));
    };

    const drawFrame = (now: number, animate: boolean) => {
      const dt = Math.min(48, now - last) / 16.67;
      last = now;

      // 鼠标位置平滑
      if (pointer.tx > -900) {
        if (pointer.x < -900) {
          pointer.x = pointer.tx;
          pointer.y = pointer.ty;
        }
        pointer.x += (pointer.tx - pointer.x) * 0.16;
        pointer.y += (pointer.ty - pointer.y) * 0.16;
      }

      ctx.clearRect(0, 0, w, h);

      const light = isLight();
      const lineRGB = light ? lineLight : lineDark;
      const dotColors = light ? dotsLight : dotsDark;
      const px = pointer.inside ? pointer.x : -9999;
      const py = pointer.inside ? pointer.y : -9999;

      // ---------- 背景浮尘 ----------
      for (const d of dust) {
        if (animate) {
          d.x += d.vx * dt;
          d.y += d.vy * dt;
          if (d.x < -10) d.x = w + 10;
          if (d.x > w + 10) d.x = -10;
          if (d.y < -10) d.y = h + 10;
          if (d.y > h + 10) d.y = -10;
        }
        // 鼠标轻微视差
        const ox = pointer.inside ? (px - w / 2) * -0.012 * d.z : 0;
        const oy = pointer.inside ? (py - h / 2) * -0.012 * d.z : 0;
        ctx.beginPath();
        ctx.fillStyle = `rgba(${lineRGB},${d.a * 0.5})`;
        ctx.arc(d.x + ox, d.y + oy, d.r, 0, Math.PI * 2);
        ctx.fill();
      }

      // ---------- 粒子 ----------
      for (const p of ps) {
        if (animate) {
          p.ph += 0.012 * dt;

          // 自由漂移 + 轻微湍流
          p.x += (p.vx + Math.sin(p.ph) * 0.1) * dt;
          p.y += (p.vy + Math.cos(p.ph * 0.8) * 0.1) * dt;

          // 鼠标吸引（近处拉，远处推，保持不塌缩）
          if (pointer.inside) {
            const dx = px - p.x;
            const dy = py - p.y;
            const d2 = dx * dx + dy * dy;
            const far = mouseDist * 1.9;
            if (d2 < far * far && d2 > 1) {
              const d = Math.sqrt(d2);
              const pull = (1 - d / far) * 0.16;
              p.vx += (dx / d) * pull * dt;
              p.vy += (dy / d) * pull * dt;
            }
          }

          // 阻尼 + 限速，避免越飘越快
          p.vx *= 0.985;
          p.vy *= 0.985;
          const sp = Math.hypot(p.vx, p.vy);
          if (sp > 1.6) {
            p.vx = (p.vx / sp) * 1.6;
            p.vy = (p.vy / sp) * 1.6;
          }

          if (p.x < -20) p.x = w + 20;
          if (p.x > w + 20) p.x = -20;
          if (p.y < -20) p.y = h + 20;
          if (p.y > h + 20) p.y = -20;
        }
      }

      // ---------- 连线：粒子之间 ----------
      ctx.lineWidth = 0.7;
      for (let i = 0; i < ps.length; i++) {
        const a = ps[i];
        for (let j = i + 1; j < ps.length; j++) {
          const b = ps[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > linkDist * linkDist) continue;
          const d = Math.sqrt(d2);
          const alpha = (1 - d / linkDist) * (light ? 0.34 : 0.5);
          ctx.strokeStyle = `rgba(${lineRGB},${alpha})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      // ---------- 连线：连到鼠标 ----------
      if (px > -900) {
        for (const p of ps) {
          const dx = p.x - px;
          const dy = p.y - py;
          const d = Math.hypot(dx, dy);
          if (d > mouseDist) continue;
          const alpha = (1 - d / mouseDist) * 0.75;
          ctx.strokeStyle = `rgba(${light ? '225,29,72' : '251,113,133'},${alpha})`;
          ctx.lineWidth = 0.9;
          ctx.beginPath();
          ctx.moveTo(px, py);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
        }
        // 光标处一点光
        const g = ctx.createRadialGradient(px, py, 0, px, py, 70);
        g.addColorStop(0, `rgba(${light ? '225,29,72' : '251,113,133'},0.35)`);
        g.addColorStop(1, `rgba(${light ? '225,29,72' : '251,113,133'},0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(px, py, 70, 0, Math.PI * 2);
        ctx.fill();
      }

      // ---------- 粒子点 ----------
      for (const p of ps) {
        const color = dotColors[p.c];
        const near =
          px > -900 && Math.hypot(p.x - px, p.y - py) < mouseDist ? 1 : 0;
        // 外圈柔光
        if (near) {
          const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 6);
          g.addColorStop(0, color);
          g.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.globalAlpha = 0.28;
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
        }
        ctx.beginPath();
        ctx.fillStyle = color;
        ctx.globalAlpha = light ? 0.8 : 0.92;
        ctx.arc(p.x, p.y, p.r + near * 0.6, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      // ---------- 点击冲击波 ----------
      for (let i = rings.length - 1; i >= 0; i--) {
        const r = rings[i];
        r.t += animate ? 0.028 * dt : 1;
        if (r.t >= 1) {
          rings.splice(i, 1);
          continue;
        }
        const radius = 8 + r.t * 260;
        ctx.strokeStyle = `rgba(${light ? '225,29,72' : '251,113,133'},${(1 - r.t) * 0.55})`;
        ctx.lineWidth = 1.6 * (1 - r.t) + 0.2;
        ctx.beginPath();
        ctx.arc(r.x, r.y, radius, 0, Math.PI * 2);
        ctx.stroke();
      }

      if (animate && canvas.isConnected) {
        raf = requestAnimationFrame(loop);
      } else if (!canvas.isConnected) {
        (window as any).__fieldRaf = 0;
      }
    };

    const loop = (now: number) => drawFrame(now, true);

    const onMove = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.tx = e.clientX - rect.left;
      pointer.ty = e.clientY - rect.top;
      pointer.inside =
        pointer.tx >= 0 && pointer.tx <= w && pointer.ty >= 0 && pointer.ty <= h;
    };

    const onLeave = () => {
      pointer.inside = false;
    };

    const onDown = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x < 0 || x > w || y < 0 || y > h) return;
      rings.push({ x, y, t: 0 });
      // 冲击：把附近粒子推开
      for (const p of ps) {
        const dx = p.x - x;
        const dy = p.y - y;
        const d = Math.hypot(dx, dy);
        if (d > 280 || d < 1) continue;
        const f = (1 - d / 280) * 6.5;
        p.vx += (dx / d) * f;
        p.vy += (dy / d) * f;
      }
      if (reduce) drawFrame(performance.now(), false);
    };

    const onResize = () => {
      resize();
      if (reduce) drawFrame(performance.now(), false);
    };

    const onVisibility = () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else if (!reduce) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      }
    };

    // 首屏之外暂停，省电省 CPU
    const oldIO = (window as any).__fieldIO as IntersectionObserver | undefined;
    if (oldIO) oldIO.disconnect();

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (reduce) return;
          if (entry.isIntersecting) {
            if (!raf) {
              last = performance.now();
              raf = requestAnimationFrame(loop);
            }
          } else {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        });
      },
      { threshold: 0.05 },
    );

    const prevAc = (window as any).__fieldAc as AbortController | undefined;
    if (prevAc) prevAc.abort();
    const ac = new AbortController();
    (window as any).__fieldAc = ac;
    const opt = { passive: true, signal: ac.signal } as AddEventListenerOptions;

    window.addEventListener('pointermove', onMove, opt);
    window.addEventListener('pointerdown', onDown, opt);
    window.addEventListener('pointerleave', onLeave, opt);
    window.addEventListener('resize', onResize, opt);
    document.addEventListener('visibilitychange', onVisibility, { signal: ac.signal });

    resize();
    io.observe(canvas);
    (window as any).__fieldIO = io;

    last = performance.now();
    if (reduce) {
      drawFrame(performance.now(), false);
    } else {
      raf = requestAnimationFrame(loop);
    }

    (window as any).__fieldRaf = raf;
  }

  /* ---------------------------------------------------------
     时钟
     --------------------------------------------------------- */
  function initClock() {
    const heroEl = document.getElementById('heroClock');
    const consoleEl = document.getElementById('consoleClock');
    const dateEl = document.getElementById('consoleDate');
    if (!heroEl && !consoleEl) return;

    const time = () =>
      new Date().toLocaleTimeString('zh-CN', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const date = () =>
      new Date().toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        weekday: 'short',
      });

    const tick = () => {
      const t = time();
      if (heroEl) heroEl.textContent = t;
      if (consoleEl) consoleEl.textContent = t;
      if (dateEl) dateEl.textContent = date();
    };

    tick();
    const old = (window as any).__fangClock;
    if (old) clearInterval(old);
    (window as any).__fangClock = window.setInterval(tick, 1000);
  }

  /* ---------------------------------------------------------
     打字机
     --------------------------------------------------------- */
  function initType() {
    const el = document.getElementById('type');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';

    const phrases = [
      '这里什么都没有，除了一点夜色。',
      'build passing · 咖啡因水平正常。',
      '有一扇门在下面，你自己找。',
      'Astro 7 驱动，纯手写动效。',
    ];

    let p = 0;
    let i = 0;
    let deleting = false;

    const tick = () => {
      const text = phrases[p];
      i += deleting ? -1 : 1;
      el.textContent = text.slice(0, i);

      let delay = deleting ? 32 : 68;
      if (!deleting && i === text.length) {
        delay = 2000;
        deleting = true;
      } else if (deleting && i === 0) {
        deleting = false;
        p = (p + 1) % phrases.length;
        delay = 380;
      }
      window.setTimeout(tick, delay);
    };

    tick();
  }

  /* ---------------------------------------------------------
     卡片 3D 倾斜 + 聚光
     --------------------------------------------------------- */
  function initTilt() {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll<HTMLElement>('.sector').forEach((card) => {
      if (card.dataset.tilt) return;
      card.dataset.tilt = '1';

      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
        card.style.setProperty('--rx', `${(0.5 - py) * 9}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 11}deg`);
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ---------------------------------------------------------
     数字滚动
     --------------------------------------------------------- */
  function initCounters() {
    const nodes = document.querySelectorAll<HTMLElement>('.tele-v[data-count]');
    if (!nodes.length) return;

    const target = (el: HTMLElement) => {
      const raw = el.dataset.count ?? '0';
      return { value: Number(raw) || 0, pad: raw.length };
    };

    nodes.forEach((el) => {
      if (el.dataset.counted) return;
      el.dataset.counted = '1';
      const { value, pad } = target(el);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || value === 0) {
        el.textContent = String(value).padStart(pad, '0');
        return;
      }

      const dur = 1100;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(value * eased)).padStart(pad, '0');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  /* ---------------------------------------------------------
     首屏视差
     --------------------------------------------------------- */
  function initParallax() {
    const hero = document.querySelector<HTMLElement>('.hero-inner');
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const old = (window as any).__fangHeroScroll;
    if (old) window.removeEventListener('scroll', old);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y < window.innerHeight * 1.2) {
          hero.style.transform = `translateY(${y * 0.12}px)`;
          hero.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.9)));
        }
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    (window as any).__fangHeroScroll = onScroll;
  }

  function boot() {
    initField();
    initClock();
    initType();
    initTilt();
    initCounters();
    initParallax();
  }

  document.addEventListener('astro:page-load', boot);
  boot();
</script>
