---
/**
 * 首页 —— 炫酷视觉版
 * canvas 星际穿越 / 透视网格地面 / HUD 控制台 / 3D 倾斜卡片
 * 私人内容已迁至 /secret
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = allPosts.slice(0, 3);
const postCount = allPosts.length;
const photoCount = 4;
const runningDays = Math.max(
  1,
  Math.floor((Date.now() - Date.UTC(2023, 8, 9)) / 86400000),
);

const fmt = new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' });
const fmtDate = (d: Date) => fmt.format(d);

const sectors = [
  {
    href: '/blog',
    no: '01',
    icon: 'ri-quill-pen-line',
    title: '文字',
    en: 'WRITING',
    desc: '随笔、公告与碎碎念，按时间倒序排好。',
    tone: 'cyan',
  },
  {
    href: '/gallery',
    no: '02',
    icon: 'ri-image-2-line',
    title: '底片',
    en: 'GALLERY',
    desc: '黄昏、街角，和突然想按快门的那一秒。',
    tone: 'violet',
  },
  {
    href: '/archives',
    no: '03',
    icon: 'ri-archive-2-line',
    title: '归档',
    en: 'ARCHIVE',
    desc: '所有条目按月归档，方便一次翻完。',
    tone: 'lime',
  },
  {
    href: '/about',
    no: '04',
    icon: 'ri-user-smile-line',
    title: '关于',
    en: 'ABOUT',
    desc: '一些碎碎念，和这个站为什么长这样。',
    tone: 'rose',
  },
];

const keywords = ['PHOTOGRAPHY', 'ASTRO 7', '夜色', '光影', '笔记', '绝密档案', 'LATE NIGHT'];
---

<BaseLayout
  title="芳 · FANG'S SPACE"
  description="一个用 Astro 7 搭的个人空间：光影、文字，和一扇需要密码才推得开的门。"
>
  <!-- ==================== HERO ==================== -->
  <section class="hero" id="hero">
    <canvas id="warp" class="warp" aria-hidden="true"></canvas>
    <div class="floor" aria-hidden="true"></div>
    <div class="hero-veil" aria-hidden="true"></div>

    <div class="container-x hero-inner">
      <div class="corner tl" aria-hidden="true"></div>
      <div class="corner tr" aria-hidden="true"></div>
      <div class="corner bl" aria-hidden="true"></div>
      <div class="corner br" aria-hidden="true"></div>

      <div class="hud reveal">
        <span class="hud-item">
          <i class="hud-dot" aria-hidden="true"></i>
          SYSTEM ONLINE
        </span>
        <span class="hud-sep" aria-hidden="true"></span>
        <span class="hud-item hud-hide-sm">NODE · 37.5°N 121.4°E</span>
        <span class="hud-sep hud-hide-sm" aria-hidden="true"></span>
        <span class="hud-item" id="heroClock">--:--:--</span>
      </div>

      <h1 class="mega reveal" style="--i:1">
        <span class="mega-line">FANG'S</span>
        <span class="mega-line mega-accent text-gradient" data-text="SPACE">SPACE</span>
      </h1>

      <p class="hero-sub reveal" style="--i:2">
        <span class="brk" aria-hidden="true">[</span>
        记录光影，也记录生活
        <span class="brk" aria-hidden="true">]</span>
      </p>

      <p class="hero-type reveal" style="--i:3">
        <span class="prompt" aria-hidden="true">&gt;</span>
        <span id="type"></span><span class="caret" aria-hidden="true">▊</span>
      </p>

      <div class="hero-actions reveal" style="--i:4">
        <a href="/blog" class="btn btn-primary btn-magnet">
          <i class="ri-quill-pen-line" aria-hidden="true"></i>
          开始阅读
        </a>
        <a href="/gallery" class="btn btn-ghost">
          <i class="ri-image-2-line" aria-hidden="true"></i>
          看看相册
        </a>
      </div>

      <a href="#sectors" class="scroll-cue" aria-label="向下滚动">
        <span class="cue-line" aria-hidden="true"></span>
        SCROLL
        <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <Marquee items={keywords} speed={46} />

  <!-- ==================== 四个入口 ==================== -->
  <section class="section container-x" id="sectors">
    <div class="section-head reveal">
      <div>
        <p class="section-kicker">SECTORS · 四个区</p>
        <h2 class="section-title">从这里进去</h2>
      </div>
      <p class="section-note">鼠标移上去，卡片会跟着你转</p>
    </div>

    <div class="sector-grid">
      {
        sectors.map((s, i) => (
          <a
            class:list={['sector', 'glass']}
            href={s.href}
            data-tone={s.tone}
            style={`--i:${i}`}
          >
            <span class="sector-glow" aria-hidden="true" />
            <span class="sector-top">
              <span class="sector-no">{s.no}</span>
              <span class="sector-icon">
                <i class={s.icon} aria-hidden="true" />
              </span>
            </span>
            <h3 class="sector-title">{s.title}</h3>
            <p class="sector-en">{s.en}</p>
            <p class="sector-desc">{s.desc}</p>
            <span class="sector-go">
              进入
              <i class="ri-arrow-right-line" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ==================== HUD 控制台 ==================== -->
  <section class="section container-x">
    <div class="console glass glass-edge reveal">
      <div class="console-head">
        <p class="section-kicker">TELEMETRY · 站点状态</p>
        <div class="console-time">
          <span id="consoleDate">----</span>
          <span class="console-clock" id="consoleClock">--:--:--</span>
        </div>
      </div>

      <div class="tele-grid">
        <div class="tele">
          <span class="tele-v" data-count={String(postCount).padStart(2, '0')}>00</span>
          <span class="tele-l">篇文章</span>
        </div>
        <div class="tele">
          <span class="tele-v" data-count={String(photoCount).padStart(2, '0')}>00</span>
          <span class="tele-l">张底片</span>
        </div>
        <div class="tele">
          <span class="tele-v" data-count={String(runningDays)}>0</span>
          <span class="tele-l">运行天数</span>
        </div>
        <div class="tele tele-signal">
          <span class="tele-v">
            {
              [0, 1, 2, 3, 4].map((n) => (
                <i class="bar" style={`--h:${28 + n * 18}%`} aria-hidden="true" />
              ))
            }
          </span>
          <span class="tele-l">信号良好</span>
        </div>
      </div>

      <ul class="feed">
        {
          latest.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span class="feed-dot" aria-hidden="true" />
                <span class="feed-title">{post.data.title}</span>
                <span class="feed-date">{fmtDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== 尾部 CTA ==================== -->
  <section class="section container-x closing">
    <p class="closing-kicker reveal">END OF TRANSMISSION</p>
    <h2 class="closing-title reveal" style="--i:1">
      想到什么，<span class="text-gradient">随时敲我</span>
    </h2>
    <div class="closing-actions reveal" style="--i:2">
      <a href="/about" class="btn btn-primary">
        <i class="ri-user-smile-line" aria-hidden="true"></i>
        关于我
      </a>
      <a href="/friends" class="btn btn-ghost">
        <i class="ri-group-line" aria-hidden="true"></i>
        友链
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==================== HERO ==================== */
  .hero {
    --mega: #ffffff;
    position: relative;
    min-height: min(92vh, 880px);
    display: grid;
    align-items: center;
    padding: 3.5rem 0 6rem;
    overflow: clip;
  }

  .warp {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }

  /* 透视网格地面 */
  .floor {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: -12%;
    height: 62%;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--color-cyan) 30%, transparent) 0 1px,
        transparent 1px 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--color-violet) 26%, transparent) 0 1px,
        transparent 1px 100%
      );
    background-size: 62px 62px;
    transform: perspective(560px) rotateX(72deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: radial-gradient(ellipse 55% 70% at 50% 60%, #000 10%, transparent 72%);
    mask-image: radial-gradient(ellipse 55% 70% at 50% 60%, #000 10%, transparent 72%);
    opacity: 0.55;
    animation: floor-drift 9s linear infinite;
  }

  @keyframes floor-drift {
    from {
      background-position:
        0 0,
        0 0;
    }
    to {
      background-position:
        0 62px,
        0 62px;
    }
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 78% 62% at 50% 44%,
      transparent 20%,
      color-mix(in oklab, var(--color-void) 72%, transparent) 92%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-block: 1rem;
  }

  /* 四角括号 */
  .corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 1px solid color-mix(in oklab, var(--color-cyan) 45%, transparent);
    opacity: 0.7;
    pointer-events: none;
  }

  .tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }
  .tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
  }
  .bl {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
  }
  .br {
    bottom: 0;
    right: 0;
    border-left: 0;
    border-top: 0;
  }

  /* HUD 状态条 */
  .hud {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.4rem 1.05rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, #ffffff 10%, transparent);
    background: color-mix(in oklab, var(--color-ink-2) 62%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    color: var(--color-mist);
    margin-bottom: 2.2rem;
  }

  .hud-item {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    white-space: nowrap;
  }

  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-lime);
    box-shadow: 0 0 10px var(--color-lime);
    animation: pulse-dot 2.2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.45;
    }
  }

  .hud-sep {
    width: 1px;
    height: 10px;
    background: color-mix(in oklab, #ffffff 16%, transparent);
  }

  /* 巨型标题 */
  .mega {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.1rem, 12.2vw, 9.4rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 0 0 1.6rem;
    color: var(--mega);
    text-shadow:
      0 0 26px color-mix(in oklab, var(--color-cyan) 32%, transparent),
      0 0 90px color-mix(in oklab, var(--color-violet) 24%, transparent);
  }

  .mega-line {
    display: block;
    position: relative;
    width: fit-content;
    margin-inline: auto;
  }

  .mega-accent {
    font-style: italic;
    letter-spacing: -0.02em;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  /* 第二行扫光 */
  .mega-accent::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      100deg,
      transparent 40%,
      color-mix(in oklab, #ffffff 80%, transparent) 50%,
      transparent 60%
    );
    background-size: 260% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
    animation: sheen 6s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    100% {
      background-position: 140% 0;
      opacity: 0;
    }
    20% {
      opacity: 0.75;
    }
    60% {
      background-position: -40% 0;
      opacity: 0;
    }
  }

  .hero-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2.4vw, 1.18rem);
    letter-spacing: 0.32em;
    color: var(--color-mist);
    text-indent: 0.32em;
  }

  .brk {
    color: var(--color-cyan);
    opacity: 0.75;
    font-family: var(--font-mono);
    letter-spacing: 0;
  }

  .hero-type {
    margin: 0 auto 2.4rem;
    max-width: 46ch;
    min-height: 1.8em;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--color-fog);
  }

  .prompt {
    color: var(--color-cyan);
    margin-right: 0.5rem;
  }

  .caret {
    color: var(--color-cyan);
    animation: var(--animate-blink);
    margin-left: 1px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 3.4rem;
  }

  .btn-magnet {
    position: relative;
  }

  .btn-magnet::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: inherit;
    background: linear-gradient(120deg, var(--color-cyan), var(--color-violet), var(--color-rose));
    filter: blur(16px);
    opacity: 0.5;
    z-index: -1;
    animation: glow-breathe 3.6s ease-in-out infinite;
  }

  @keyframes glow-breathe {
    0%,
    100% {
      opacity: 0.32;
    }
    50% {
      opacity: 0.62;
    }
  }

  /* 滚动提示 */
  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    color: var(--color-fog);
    transition: color 0.3s ease;
  }

  .scroll-cue:hover {
    color: var(--color-cyan);
  }

  .cue-line {
    width: 1px;
    height: 34px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--color-cyan) 85%, transparent)
    );
    animation: cue 2.2s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes cue {
    0% {
      transform: scaleY(0.2);
      opacity: 0.3;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(0.2);
      opacity: 0.3;
    }
  }

  /* ==================== 通用 section ==================== */
  .section {
    padding: 5rem 0 0;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .section-kicker {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    color: var(--color-cyan);
  }

  .section-title {
    font-size: clamp(1.5rem, 3.6vw, 2.2rem);
  }

  .section-note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-fog);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  /* ==================== 四张入口卡 ==================== */
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
    perspective: 1200px;
  }

  .sector {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.35rem 1.35rem;
    border-radius: 22px;
    min-height: 250px;
    isolation: isolate;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--lift, 0px));
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
    will-change: transform;
  }

  .sector-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in oklab, var(--tone, var(--color-cyan)) 22%, transparent),
      transparent 65%
    );
  }

  .sector:hover .sector-glow {
    opacity: 1;
  }

  .sector:hover {
    --lift: -6px;
    border-color: color-mix(in oklab, var(--tone, var(--color-cyan)) 45%, transparent);
    box-shadow:
      0 30px 60px -34px color-mix(in oklab, var(--tone, var(--color-cyan)) 75%, transparent),
      0 0 0 1px color-mix(in oklab, var(--tone, var(--color-cyan)) 22%, transparent) inset;
  }

  .sector[data-tone='cyan'] {
    --tone: var(--color-cyan);
  }
  .sector[data-tone='violet'] {
    --tone: var(--color-violet);
  }
  .sector[data-tone='lime'] {
    --tone: var(--color-lime);
  }
  .sector[data-tone='rose'] {
    --tone: var(--color-rose);
  }

  .sector-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .sector-no {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: var(--color-fog);
  }

  .sector-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    font-size: 1.15rem;
    color: var(--tone, var(--color-cyan));
    background: color-mix(in oklab, var(--tone, var(--color-cyan)) 13%, transparent);
    border: 1px solid color-mix(in oklab, var(--tone, var(--color-cyan)) 26%, transparent);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sector:hover .sector-icon {
    transform: translateZ(28px) scale(1.06);
  }

  .sector-title {
    font-size: 1.28rem;
    margin: 0 0 0.2rem;
    letter-spacing: -0.01em;
  }

  .sector-en {
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.26em;
    color: var(--tone, var(--color-cyan));
    opacity: 0.8;
  }

  .sector-desc {
    margin: 0 0 1.4rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--color-fog);
  }

  .sector-go {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.74rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--color-mist);
    transition: gap 0.3s ease;
  }

  .sector:hover .sector-go {
    gap: 0.6rem;
    color: var(--tone, var(--color-cyan));
  }

  /* ==================== HUD 控制台 ==================== */
  .console {
    padding: 1.6rem 1.7rem 1.4rem;
    border-radius: 24px;
  }

  .console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid color-mix(in oklab, #ffffff 7%, transparent);
  }

  .console-time {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-fog);
  }

  .console-clock {
    color: var(--color-cyan);
    font-size: 0.86rem;
    letter-spacing: 0.12em;
  }

  .tele-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.3rem 0;
  }

  .tele {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.9rem;
    border-left: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
  }

  .tele:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .tele-v {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 2rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .tele-l {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
