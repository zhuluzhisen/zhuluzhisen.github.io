    }
    .sector-grid {
      grid-template-columns: 1fr;
    }
    .sector {
      min-height: 0;
    }
    .corner {
      width: 18px;
      height: 18px;
    }
    .console {
      padding: 1.25rem 1.1rem 1rem;
