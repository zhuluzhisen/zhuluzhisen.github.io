---
/**
 * 秘密档案 —— 原主页的私人内容收进这里
 * 档案封面 + 森字球体 + 最新文章 + 精选相册 + 联系方式
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Marquee from '../components/Marquee.astro';
import Gallery from '../components/Gallery.astro';

import Fang1 from '../assets/images/Fang1.jpg';
import Fang2 from '../assets/images/Fang2.jpg';
import Fang3 from '../assets/images/Fang3.JPG';
import Fang4 from '../assets/images/Fang4.jpg';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = allPosts.slice(0, 3);
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];

const shots = [
  { src: Fang1, alt: '我最喜欢的一张', caption: '我最喜欢的一张' },
  { src: Fang2, alt: '看着就很开心', caption: '看着就很开心' },
  { src: Fang3, alt: '这张我也很喜欢', caption: '这张我也很喜欢' },
  { src: Fang4, alt: '很Q', caption: '很Q' },
];

const tags = ['摄影', '旅行', '生活', '随笔', '公告', '光影'];

const stats = [
  { value: String(allPosts.length).padStart(2, '0'), label: '篇文章' },
  { value: String(shots.length).padStart(2, '0'), label: '张照片' },
  { value: 'Astro 7', label: '框架版本' },
];

const meta = [
  { k: '档案编号', v: 'SEN-ARCHIVE-002' },
  { k: '密级', v: 'TOP SECRET · 绝密' },
  { k: '建档日期', v: '2026.11.02' },
  { k: '收录内容', v: `${allPosts.length} 篇文字 · ${shots.length} 张底片` },
];
---

<BaseLayout
  title="秘密档案"
  description="森的秘密档案：不对外开放的那部分照片、文章和碎碎念。"
  noindex={true}
>
  <!-- ============ 档案封面 / HERO ============ -->
  <section class="dossier">
    <div class="container-x dossier-inner">
      <div class="dossier-copy">
        <p class="file-tag reveal">
          <span class="lock"><i class="ri-lock-2-line" aria-hidden="true"></i></span>
          CLASSIFIED · 仅限内部查阅
        </p>

        <h1 class="dossier-title reveal" style="--i:1">
          <span class="line">秘密档案</span>
          <span class="line text-gradient">只给你看的那一叠</span>
        </h1>

        <p class="dossier-desc reveal" style="--i:2">
          <span id="typewriter" class="tw"></span><span class="caret">▊</span>
        </p>

        <dl class="meta-grid reveal" style="--i:3">
          {
            meta.map((m) => (
              <div class="meta-item">
                <dt>{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="dossier-actions reveal" style="--i:4">
          <a href="/" class="btn btn-ghost">
            <i class="ri-arrow-left-line" aria-hidden="true"></i>
            回到门外
          </a>
          <a href="/blog" class="btn btn-primary">
            <i class="ri-quill-pen-line" aria-hidden="true"></i>
            翻档案正文
          </a>
        </div>
      </div>

      <div class="dossier-visual reveal is-visible" style="--i:2">
        <div class="orb-wrap">
          <div class="orb-glow" aria-hidden="true"></div>
          <div class="orb">
            <span class="orb-text">森</span>
          </div>
          <span class="orb-ring ring-1" aria-hidden="true"></span>
          <span class="orb-ring ring-2" aria-hidden="true"></span>
          <span class="orb-tick" aria-hidden="true"></span>
        </div>

        <div class="stamp" aria-hidden="true">
          <span class="stamp-top">绝密</span>
          <span class="stamp-en">TOP SECRET</span>
          <span class="stamp-line"></span>
          <span class="stamp-no">NO. 002</span>
        </div>

        <div class="float-card fc-1 glass">
          <i class="ri-fingerprint-line" aria-hidden="true"></i>
          <span>Access granted</span>
        </div>
        <div class="float-card fc-2 glass">
          <i class="ri-camera-line" aria-hidden="true"></i>
          <span>Photography</span>
        </div>
      </div>
    </div>

    <div class="scanline" aria-hidden="true"></div>
  </section>

  <Marquee items={tags} speed={42} />

  <!-- ============ 最新文章 ============ -->
  <section class="section container-x">
    <div class="section-head reveal">
      <div>
        <p class="section-kicker">卷宗 · LATEST POSTS</p>
        <h2 class="section-title">最近写下的</h2>
      </div>
      <a href="/blog" class="section-more">
        全部文章
        <i class="ri-arrow-right-line" aria-hidden="true"></i>
      </a>
    </div>

    <div class="grid-3">
      {
        latest.map((post, i) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover ?? post.data.gallery[0]?.src}
            featured={post.data.featured}
            index={i}
          />
        ))
      }
    </div>
  </section>

  <!-- ============ 精选相册 ============ -->
  {
    featured && (
      <section class="section container-x">
        <div class="section-head reveal">
          <div>
            <p class="section-kicker">底片 · GALLERY</p>
            <h2 class="section-title">压在最下面的照片</h2>
          </div>
          <a href="/gallery" class="section-more">
            全部照片
            <i class="ri-arrow-right-line" aria-hidden="true" />
          </a>
        </div>

        <div class="gallery-panel glass glass-edge reveal">
          <Gallery shots={shots} columns={2} />
        </div>
      </section>
    )
  }

  <!-- ============ CTA ============ -->
  <section class="section container-x">
    <div class="cta glass glass-edge reveal">
      <div class="cta-inner">
        <p class="section-kicker">KEEP IN TOUCH</p>
        <h2 class="cta-title">看完了，想聊两句？</h2>
        <p class="cta-desc">摄影约拍、技术交流、或者只是想打个招呼 —— 都欢迎。</p>
        <div class="cta-actions">
          <a href="/friends" class="btn btn-primary">
            <i class="ri-group-line" aria-hidden="true"></i>
            友链
          </a>
          <a href="/about" class="btn btn-ghost">
            <i class="ri-user-smile-line" aria-hidden="true"></i>
            关于我
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============ 档案封面 ============ */
  .dossier {
    position: relative;
    padding: 4.6rem 0 4.2rem;
    overflow: clip;
  }

  .dossier::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 78% 30%, color-mix(in oklab, var(--color-rose) 12%, transparent), transparent 70%),
      repeating-linear-gradient(
        90deg,
        color-mix(in oklab, #ffffff 3%, transparent) 0 1px,
        transparent 1px 88px
      );
    opacity: 0.9;
  }

  .dossier-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: center;
    gap: 3.4rem;
  }

  .file-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.3rem;
    padding: 0.34rem 0.95rem 0.34rem 0.42rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-rose) 34%, transparent);
    background: color-mix(in oklab, var(--color-rose) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: var(--color-rose);
  }

  .file-tag .lock {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-rose) 18%, transparent);
    font-size: 0.7rem;
  }

  .dossier-title {
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }

  .dossier-title .line {
    display: block;
  }

  .dossier-title .text-gradient {
    font-size: 0.62em;
    letter-spacing: -0.01em;
  }

  .dossier-desc {
    margin: 0 0 1.9rem;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-fog);
    min-height: 1.85em;
  }

  .caret {
    color: var(--color-rose);
    animation: var(--animate-blink);
    margin-left: 2px;
  }

  /* ---- 档案元信息 ---- */
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1.4rem;
    margin: 0 0 2rem;
    padding: 1.15rem 1.25rem;
    border-radius: 16px;
    border: 1px solid color-mix(in oklab, #ffffff 8%, transparent);
    border-left: 2px solid color-mix(in oklab, var(--color-rose) 60%, transparent);
    background: color-mix(in oklab, var(--color-ink-2) 55%, transparent);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.2em;
    color: var(--color-fog);
    text-transform: uppercase;
  }

  .meta-item dd {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--color-mist);
    font-family: var(--font-mono);
    word-break: break-word;
  }

  .dossier-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ---- 视觉：森字球体 ---- */
  .dossier-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 380px;
  }

  .orb-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: min(300px, 68vw);
    aspect-ratio: 1;
  }

  .orb-glow {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    overflow: hidden;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 40%, transparent 76%);
    mask-image: radial-gradient(circle at 50% 50%, #000 40%, transparent 76%);
  }

  .orb-glow::before {
    content: '';
    position: absolute;
    inset: -22%;
    background: conic-gradient(
      from 0deg,
      var(--color-rose),
      var(--color-violet),
      var(--color-cyan),
      var(--color-rose)
    );
    filter: blur(46px);
    opacity: 0.5;
    animation: var(--animate-spin-slow);
  }

  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 68%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.26), transparent 48%),
      linear-gradient(150deg, #171226, #070911 72%);
    border: 1px solid color-mix(in oklab, #ffffff 14%, transparent);
    box-shadow:
      inset 0 0 60px rgba(0, 0, 0, 0.75),
      0 30px 80px -30px rgba(0, 0, 0, 0.9);
    animation: var(--animate-float-slow);
  }

  .orb-text {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7.5vw, 4.6rem);
    font-weight: 700;
    background: linear-gradient(140deg, #fff, var(--color-rose) 58%, var(--color-violet));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .orb-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, #ffffff 10%, transparent);
  }

  .ring-1 {
    inset: 4%;
    animation: var(--animate-spin-slow);
    border-top-color: var(--color-rose);
    border-right-color: transparent;
  }

  .ring-2 {
    inset: -8%;
    animation: var(--animate-spin-slow) reverse;
    animation-duration: 26s;
    border-bottom-color: var(--color-cyan);
    border-left-color: transparent;
  }

  /* 外圈刻度（档案刻度盘感觉） */
  .orb-tick {
    position: absolute;
    inset: -15%;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from 0deg,
      color-mix(in oklab, #ffffff 18%, transparent) 0deg 0.6deg,
      transparent 0.6deg 6deg
    );
    -webkit-mask-image: radial-gradient(circle, transparent 68%, #000 69%, #000 72%, transparent 73%);
    mask-image: radial-gradient(circle, transparent 68%, #000 69%, #000 72%, transparent 73%);
    opacity: 0.75;
    animation: var(--animate-spin-slow) reverse;
    animation-duration: 60s;
  }

  /* ---- 绝密戳章 ---- */
  .stamp {
    position: absolute;
    right: -0.5rem;
    bottom: 0.5rem;
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.6rem 1.05rem 0.55rem;
    transform: rotate(-9deg);
    border: 2px solid color-mix(in oklab, var(--color-rose) 72%, transparent);
    border-radius: 8px;
    color: var(--color-rose);
    background: color-mix(in oklab, var(--color-rose) 7%, transparent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-rose) 9%, transparent);
    opacity: 0.9;
    animation: stamp-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.5s;
  }

  @keyframes stamp-in {
    from {
      opacity: 0;
      transform: rotate(-9deg) scale(1.6);
    }
    to {
      opacity: 0.9;
      transform: rotate(-9deg) scale(1);
    }
  }

  .stamp-top {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    line-height: 1.2;
    text-indent: 0.32em;
  }

  .stamp-en {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.24em;
    opacity: 0.85;
  }

  .stamp-line {
    width: 100%;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    margin: 0.15rem 0;
  }

  .stamp-no {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.3em;
  }

  .float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.52rem 0.9rem;
    border-radius: 14px;
    font-size: 0.74rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--color-mist);
    box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.95);
  }

  .float-card i {
    font-size: 0.95rem;
    color: var(--color-rose);
  }

  .fc-1 {
    top: 9%;
    left: -6%;
    animation: var(--animate-float-slow);
  }

  .fc-2 {
    bottom: 16%;
    right: -4%;
    animation: var(--animate-float-slow);
    animation-delay: -4s;
  }

  .fc-2 i {
    color: var(--color-cyan);
  }

  /* ---- 扫描线 ---- */
  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--color-rose) 60%, transparent),
      color-mix(in oklab, var(--color-cyan) 55%, transparent),
      transparent
    );
    opacity: 0.55;
    animation: scan-sweep 7s linear infinite;
    pointer-events: none;
  }

  @keyframes scan-sweep {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    12% {
      opacity: 0.6;
    }
    88% {
      opacity: 0.6;
    }
    100% {
      transform: translateY(560px);
      opacity: 0;
    }
  }

  /* ============ 通用 section ============ */
  .section {
    padding: 4.5rem 0 0;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .section-kicker {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--color-rose);
  }

  .section-title {
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-fog);
    padding-bottom: 0.25rem;
    transition: color 0.25s ease;
    white-space: nowrap;
  }

  .section-more:hover {
    color: var(--color-rose);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .gallery-panel {
    padding: 1.4rem;
    border-radius: 26px;
  }

  /* ============ CTA ============ */
  .cta {
    border-radius: 28px;
    padding: 3.4rem 2rem;
    text-align: center;
    background:
      radial-gradient(ellipse 70% 130% at 50% 0%, color-mix(in oklab, var(--color-rose) 14%, transparent), transparent),
      color-mix(in oklab, var(--color-ink-2) 72%, transparent);
  }

  .cta-title {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    margin-bottom: 0.7rem;
  }

  .cta-desc {
    margin: 0 auto 1.8rem;
    max-width: 44ch;
    color: var(--color-fog);
    font-size: 0.92rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ============ 响应式 ============ */
  @media (max-width: 980px) {
    .dossier-inner {
      grid-template-columns: 1fr;
      gap: 2.6rem;
    }
    .dossier-visual {
      min-height: 320px;
      order: 1;
    }
    .dossier-copy {
      order: 0;
    }
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
    .stamp {
      right: 0.5rem;
      bottom: -0.4rem;
    }
  }

  @media (max-width: 900px) {
    .fc-1 {
      left: 0;
    }
    .fc-2 {
      right: 0;
    }
  }

  @media (max-width: 680px) {
    .dossier {
      padding: 3rem 0 3rem;
    }
    .section {
      padding-top: 3.2rem;
    }
    .grid-3 {
      grid-template-columns: 1fr;
    }
    .meta-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
    .section-head {
      align-items: flex-start;
    }
    .fc-1 {
      left: -2%;
    }
    .fc-2 {
      right: -2%;
    }
  }
</style>

<script>
  function initTypewriter() {
    const el = document.getElementById('typewriter');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';

    const phrases = [
      '这里存着不对外开放的那部分。',
      '照片、碎碎念，还有深夜写下的字。',
      '翻的时候轻一点，别把灰抖起来。',
    ];

    let p = 0;
    let i = 0;
    let deleting = false;

    const tick = () => {
      const text = phrases[p];
      i += deleting ? -1 : 1;
      el.textContent = text.slice(0, i);

      let delay = deleting ? 36 : 74;
      if (!deleting && i === text.length) {
        delay = 2100;
        deleting = true;
      } else if (deleting && i === 0) {
        deleting = false;
        p = (p + 1) % phrases.length;
        delay = 420;
      }
      window.setTimeout(tick, delay);
    };

    tick();
  }

  document.addEventListener('astro:page-load', initTypewriter);
  initTypewriter();
</script>
