---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const sorted = [...posts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`#${tag}`} description={`标签「${tag}」下的全部文章`}>
  <div class="page container-x">
    <header class="page-head reveal is-visible">
      <p class="section-kicker">TAG</p>
      <h1 class="page-title">
        <span class="hash">#</span>{tag}
      </h1>
      <p class="page-desc">共 {sorted.length} 篇</p>
    </header>

    <div class="grid-2">
      {
        sorted.map((post, i) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover ?? post.data.gallery[0]?.src}
            index={i}
          />
        ))
      }
    </div>

    <div class="back-row">
      <a href="/tags" class="btn btn-ghost">
        <i class="ri-arrow-left-line" aria-hidden="true"></i>
        返回标签云
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3.2rem;
  }

  .page-head {
    margin-bottom: 2.2rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .hash {
    color: var(--color-cyan);
  }

  .page-desc {
    margin: 0;
    color: var(--color-fog);
    font-size: 0.9rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .back-row {
    margin-top: 2.5rem;
  }

  @media (max-width: 780px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
