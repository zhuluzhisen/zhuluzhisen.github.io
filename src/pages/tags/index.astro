---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const map = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => map.set(t, (map.get(t) ?? 0) + 1)));
const tags = [...map.entries()].sort((a, b) => b[1] - a[1]);
const max = Math.max(...tags.map((t) => t[1]));
---

<BaseLayout title="标签" description="文章标签云">
  <div class="page container-x">
    <header class="page-head reveal is-visible">
      <p class="section-kicker">TAGS</p>
      <h1 class="page-title">标签</h1>
      <p class="page-desc">共 {tags.length} 个标签</p>
    </header>

    <div class="cloud reveal is-visible">
      {
        tags.map(([tag, count], i) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="tag-cloud-item"
            style={`--size:${0.82 + (count / max) * 0.5}rem; --i:${i}`}
          >
            <span class="tc-hash">#</span>
            {tag}
            <span class="tc-count">{count}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3.2rem;
  }

  .page-head {
    margin-bottom: 2.4rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.5rem;
  }

  .page-desc {
    margin: 0;
    color: var(--color-fog);
    font-size: 0.9rem;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.6rem 1.15rem;
    border-radius: 16px;
    font-family: var(--font-display);
    font-size: var(--size);
    font-weight: 600;
    color: var(--color-mist);
    border: 1px solid color-mix(in oklab, #ffffff 9%, transparent);
    background: color-mix(in oklab, var(--color-ink-2) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tag-cloud-item:hover {
    color: #fff;
    border-color: color-mix(in oklab, var(--color-violet) 60%, transparent);
    background: color-mix(in oklab, var(--color-violet) 14%, transparent);
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 16px 40px -18px color-mix(in oklab, var(--color-violet) 90%, transparent);
  }

  .tc-hash {
    color: var(--color-cyan);
    font-weight: 400;
  }

  .tc-count {
    font-family: var(--font-mono);
    font-size: 0.66em;
    color: var(--color-fog);
  }
</style>
